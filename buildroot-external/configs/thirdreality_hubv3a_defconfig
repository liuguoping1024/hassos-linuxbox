BR2_CCACHE=y
BR2_CCACHE_DIR="/cache/cc"
BR2_ENABLE_LTO=y
BR2_GLOBAL_PATCH_DIR="$(BR2_EXTERNAL_HASSOS_PATH)/board/thirdreality/amlogic-sdk/patches $(BR2_EXTERNAL_HASSOS_PATH)/board/thirdreality/hubv3a/patches"
BR2_SSP_REGULAR=y
BR2_TARGET_GENERIC_HOSTNAME="HubV3A"
BR2_TARGET_GENERIC_ISSUE="Welcome to ThirdReality HubV3A MB:v0.1 (buildroot)"
BR2_TARGET_GENERIC_ROOT_PASSWD="shushi16888"
