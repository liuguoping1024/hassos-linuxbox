# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_HASSOS_PATH)/rootfs-overlay $(BR2_EXTERNAL_HASSOS_PATH)/board/thirdreality/rootfs-overlay $(BR2_EXTERNAL_HASSOS_PATH)/board/thirdreality/hubv3a/rootfs-overlay"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_HASSOS_PATH)/scripts/post-build.sh"
BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_HASSOS_PATH)/scripts/post-image.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="$(BR2_EXTERNAL_HASSOS_PATH)/board/thirdreality/hubv3a $(BR2_EXTERNAL_HASSOS_PATH)/board/thirdreality/hubv3a/hassos-hook.sh"
BR2_SYSTEM_DEFAULT_PATH="/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

# ---- Kernel: upstream v5.4.180 + SDK patches + WiFi/BT driver patches ----
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="5.4.180"
# Patches applied via BR2_GLOBAL_PATCH_DIR, shared layer first:
#   amlogic-sdk/patches/linux/   0100-0900  Amlogic SDK vendor patches (46)
#   hubv3a/patches/linux/  0993-1021  board dts + local fixes (18)
# The numbering keeps the original apply order across the two directories,
# because buildroot walks BR2_GLOBAL_PATCH_DIR entries left to right.
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_HASSOS_PATH)/board/thirdreality/kernel-linuxbox-hubv3a.config"
BR2_LINUX_KERNEL_IMAGEGZ=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="amlogic/meson-axg-thirdreality-hub-v3a"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

