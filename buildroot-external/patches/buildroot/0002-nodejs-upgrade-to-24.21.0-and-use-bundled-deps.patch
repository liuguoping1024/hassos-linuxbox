@@ -21,9 +21,6 @@ NODEJS_SRC_DEPENDENCIES = \
 	host-pkgconf \
 	host-python3 \
 	host-qemu \
-	c-ares \
-	libuv \
-	nghttp2 \
 	zlib \
 	$(call qstrip,$(BR2_PACKAGE_NODEJS_MODULES_ADDITIONAL_DEPS))
 HOST_NODEJS_SRC_DEPENDENCIES = \
@@ -37,9 +34,6 @@ NODEJS_SRC_INSTALL_STAGING = YES
 
 NODEJS_SRC_CONF_OPTS = \
 	--shared-zlib \
-	--shared-cares \
-	--shared-libuv \
-	--shared-nghttp2 \
 	--cross-compiling \
 	--dest-os=linux \
 	--ninja
@@ -190,19 +184,21 @@ define NODEJS_SRC_INSTALL_V8_QEMU_WRAPPER
 endef
 NODEJS_SRC_PRE_CONFIGURE_HOOKS += NODEJS_SRC_INSTALL_V8_QEMU_WRAPPER
 
+# Node 24 ships native '<@(emulator)' slots in front of every build tool it
+# has to execute (node_js2c, node_mksnapshot, torque, mksnapshot,
+# bytecode_builtins_list_generator, gen-regexp-special-case), defaulting to an
+# empty list via "'emulator%': []," in common.gypi. That is exactly what the
+# old 0001-add-qemu-wrapper-support.patch open-coded with an @MAYBE_WRAPPER@
+# marker, so point those slots at the wrapper instead of carrying the patch.
+# configure.py's --emulator option cannot be used: it is ignored whenever
+# --cross-compiling is passed, which is always the case here.
+# The host build needs no fixup - the empty default expands to nothing.
 define NODEJS_SRC_WRAPPER_FIXUP
-	$(SED) "s%@MAYBE_WRAPPER@%'<(PRODUCT_DIR)/v8-qemu-wrapper',%g" $(@D)/node.gyp
-	$(SED) "s%@MAYBE_WRAPPER@%'<(PRODUCT_DIR)/v8-qemu-wrapper',%g" $(@D)/tools/v8_gypfiles/v8.gyp
+	$(SED) "s%'<@(emulator)',%'<(PRODUCT_DIR)/v8-qemu-wrapper',%g" $(@D)/node.gyp
+	$(SED) "s%'<@(emulator)',%'<(PRODUCT_DIR)/v8-qemu-wrapper',%g" $(@D)/tools/v8_gypfiles/v8.gyp
 endef
 NODEJS_SRC_PRE_CONFIGURE_HOOKS += NODEJS_SRC_WRAPPER_FIXUP
 
-# Do not run the qemu-wrapper for the host build.
-define HOST_NODEJS_SRC_WRAPPER_FIXUP
-	$(SED) "s%@MAYBE_WRAPPER@%%g" $(@D)/node.gyp
-	$(SED) "s%@MAYBE_WRAPPER@%%g" $(@D)/tools/v8_gypfiles/v8.gyp
-endef
-HOST_NODEJS_SRC_PRE_CONFIGURE_HOOKS += HOST_NODEJS_SRC_WRAPPER_FIXUP
-
 define NODEJS_SRC_CONFIGURE_CMDS
 	(cd $(@D); \
 		$(TARGET_CONFIGURE_OPTS) \
