+					 <&clkc CLKID_GP0_PLL>,
+					 <0>, /* Do Nothing */
+					 <&clkc CLKID_MALI_0>;
+		assigned-clock-rates = <744000000>,
+				       <0>, /* Do Nothing */
+				       <744000000>,
+				       <0>; /* Do Nothing */
+	};
