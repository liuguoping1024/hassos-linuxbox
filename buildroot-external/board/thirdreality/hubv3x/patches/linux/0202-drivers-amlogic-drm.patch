+			.hw_blkmode = BLOCK_MODE_16BIT,
+			.hw_colormat = COLOR_MATRIX_565,
+			.alpha_replace = 0 },
+	};
+
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(formats); ++i) {
+		if (formats[i].format == format)
