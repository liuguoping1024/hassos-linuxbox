+	if (meson_gem_obj->is_uvm) {
+		DRM_ERROR("UVM cannot call vmap.\n");
+		return NULL;
+	}
+	DRM_DEBUG("%s %p.\n", __func__, obj);
+
+	return NULL;
+}
