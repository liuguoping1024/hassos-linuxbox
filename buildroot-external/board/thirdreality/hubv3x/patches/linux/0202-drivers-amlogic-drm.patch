+			struct rdma_reg_ops *reg_ops,
+			struct osd_scaler_reg_s *reg, bool flag)
+{
+	reg_ops->rdma_write_reg_bits(reg->vpp_osd_vsc_ctrl0, flag, 24, 1);
+}
+
