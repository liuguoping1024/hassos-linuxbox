+	{ .compatible = "amlogic, meson-gxm-vpu",},
+	{ .compatible = "amlogic, meson-txl-vpu",},
+	{ .compatible = "amlogic, meson-txlx-vpu",},
+	{ .compatible = "amlogic, meson-axg-vpu",},
