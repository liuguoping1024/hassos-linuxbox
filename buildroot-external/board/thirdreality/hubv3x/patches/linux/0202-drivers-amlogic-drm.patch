+	drm_printf(p, "\tmeson osd plane %d info:\n", osd_plane->plane_index);
+	drm_printf(p, "\t\tsrc_x=%u\n", plane_info->src_x);
+	drm_printf(p, "\t\tsrc_y=%u\n", plane_info->src_y);
