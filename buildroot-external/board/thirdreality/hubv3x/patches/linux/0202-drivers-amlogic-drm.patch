+static struct drm_display_mode cvbs_mode[] = {
+	{ /* MODE_480CVBS */
+		.name = "480cvbs",
+		.status = 0,
+		.clock = 13500,
+		.hdisplay = 720,
+		.hsync_start = 739,
+		.hsync_end = 801,
+		.htotal = 858,
+		.hskew = 0,
+		.vdisplay = 480,
+		.vsync_start = 488,
