+	BLOCK_MODE_R8 = 0,
+	BLOCK_MODE_YUV422_8BIT,
+	BLOCK_MODE_RGB565,
+	BLOCK_MODE_RGBA5551,
+	BLOCK_MODE_RGBA4444,
+	BLOCK_MODE_RGBA8888,
