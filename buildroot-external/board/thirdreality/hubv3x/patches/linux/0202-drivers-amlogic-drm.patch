+			  struct drm_atomic_state *state)
+{
+	struct drm_private_state *dps;
+	struct meson_vpu_block_state *mvbs;
+
+	dps = drm_atomic_get_private_obj_state(state, &block->obj);
+	if (dps) {
+		mvbs = priv_to_block_state(dps);
+		return mvbs;
+	}
+
+	return NULL;
+}
