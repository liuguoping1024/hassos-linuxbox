+	drm_for_each_crtc(crtc, dev) {
+		meson_crtc_debugfs_init(crtc, minor->debugfs_root);
+	}
+	drm_for_each_plane(plane, dev) {
+		meson_plane_debugfs_init(plane, minor->debugfs_root);
+	}
+
+	return ret;
+}
+
+#endif
