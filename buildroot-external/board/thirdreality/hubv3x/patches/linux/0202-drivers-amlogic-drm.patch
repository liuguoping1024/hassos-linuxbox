+	.dump_register = osd_dump_register,
+	.init = t7_osd_hw_init,
+	.fini = osd_hw_fini,
+};
+
+struct meson_vpu_block_ops s5_osd_ops = {
+	.check_state = osd_check_state,
+	.update_state = osd_set_state,
+	.enable = osd_hw_enable,
+	.disable = osd_hw_disable,
+	.dump_register = osd_dump_register,
+	.init = s5_osd_hw_init,
+	.fini = osd_hw_fini,
+};
