+		.vtotal = 525,
+		.vscan = 0,
+		.vrefresh = 60,
+		.flags = DRM_MODE_FLAG_INTERLACE,
+	},
+	{ /* MODE_576CVBS*/
+		.name = "576cvbs",
+		.status = 0,
+		.clock = 13500,
+		.hdisplay = 720,
+		.hsync_start = 732,
+		.hsync_end = 795,
+		.htotal = 864,
+		.hskew = 0,
+		.vdisplay = 576,
