+			.hw_blkmode = BLOCK_MODE_32BIT,
+			.hw_colormat = COLOR_MATRIX_RGBA8888,
+			.alpha_replace = 0 },
+		{ .format = DRM_FORMAT_BGRA8888,
+			.hw_blkmode = BLOCK_MODE_32BIT,
+			.hw_colormat = COLOR_MATRIX_BGRA8888,
+			.alpha_replace = 0 },
