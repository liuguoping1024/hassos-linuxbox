+#define DDX_CH2_BQ_0                                0x30
+#define DDX_CH2_BQ_1                                0x31
+#define DDX_CH2_BQ_2                                0x32
+#define DDX_CH2_BQ_3                                0x33
+#define DDX_CH2_BQ_4                                0x34
+#define DDX_CH2_BQ_5                                0x35
+#define DDX_CH2_BQ_6                                0x36
+
+#define DDX_DRC1_AE                                 0x3A
