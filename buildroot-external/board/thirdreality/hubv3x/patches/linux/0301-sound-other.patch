+	struct tas5805m_priv *tas5805m =
+	snd_soc_component_get_drvdata(component);
+
+	tas5805m->mute = ucontrol->value.integer.value[0];
+	tas5805m_mute(component, tas5805m->mute);
+
+	return 0;
+}
