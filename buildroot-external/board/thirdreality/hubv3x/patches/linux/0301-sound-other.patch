+static int ad82587d_reg_init(struct snd_soc_component *component)
+{
+	int i = 0;
+
+	for (i = 0; i < ARRAY_SIZE(init_tab); i++) {
+		snd_soc_component_write(component, init_tab[i][0], init_tab[i][1]);
+	};
+
+	return 0;
+}
