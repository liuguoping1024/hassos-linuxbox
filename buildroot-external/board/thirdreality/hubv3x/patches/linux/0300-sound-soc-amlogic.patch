+static int spdif_channel_status_info(struct snd_kcontrol *kcontrol,
+				     struct snd_ctl_elem_info *uinfo)
+{
+	/* struct soc_enum *e = (struct soc_enum *)kcontrol->private_value;
+	 * int i;
