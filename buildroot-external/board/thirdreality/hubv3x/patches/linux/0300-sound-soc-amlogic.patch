+int get_resample_module_num(void)
+{
+	struct audioresample *p_resample = get_audioresample(RESAMPLE_A);
+
+	if (p_resample && p_resample->chipinfo)
+		return p_resample->chipinfo->num;
+
+	p_resample = get_audioresample(RESAMPLE_B);
+	if (p_resample && p_resample->chipinfo)
+		return p_resample->chipinfo->num;
+
+	return 1;
