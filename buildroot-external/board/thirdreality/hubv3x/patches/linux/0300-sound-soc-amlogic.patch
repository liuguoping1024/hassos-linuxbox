+static inline enum toddr_src aml_tdm_id2src(int id)
+{
+	enum toddr_src src;
+
+	switch (id) {
+	case 0:
+		src = TDMIN_A;
+	break;
+	case 1:
+		src = TDMIN_B;
+	break;
+	case 2:
+		src = TDMIN_C;
+	break;
+	case 3:
+		src = TDMIN_D;
+	break;
+	case 4:
+		src = TDMIN_LB;
+	break;
+	default:
+		pr_info("%s(), invalid id: %d\n",
+			__func__, id);
