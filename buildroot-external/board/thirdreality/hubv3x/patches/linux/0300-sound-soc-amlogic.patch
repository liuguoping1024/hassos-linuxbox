+{
+	bool valid = aml_check_sharebuffer_valid(p_spdif->fddr,
+			p_spdif->samesource_sel);
+	struct samesrc_ops *ops = NULL;
+
+	if (!valid)
+		return;
+
+	ops = get_samesrc_ops(p_spdif->samesource_sel);
+	if (ops && ops->mute)
+		ops->mute(p_spdif->samesource_sel, mute);
+}
