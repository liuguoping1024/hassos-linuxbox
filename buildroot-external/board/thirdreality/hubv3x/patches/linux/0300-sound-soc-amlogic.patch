+	val = audiobus_read(EE_AUDIO_CLK_TDMOUT_C_CTRL);
+	ucontrol->value.enumerated.item[0] = ((val >> 29) & 0x1);
+
+	return 0;
+}
+
+static int tdmout_c_binv_set_enum(struct snd_kcontrol *kcontrol,
+				  struct snd_ctl_elem_value *ucontrol)
+{
