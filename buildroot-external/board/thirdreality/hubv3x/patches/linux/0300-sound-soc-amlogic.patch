+int loopback_dai_hw_free(struct snd_pcm_substream *ss,
+	struct snd_soc_dai *dai)
+{
+	struct loopback *p_loopback = snd_soc_dai_get_drvdata(dai);
+
+	pr_debug("%s\n", __func__);
