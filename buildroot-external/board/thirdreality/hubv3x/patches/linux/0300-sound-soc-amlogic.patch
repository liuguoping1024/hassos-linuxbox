+int fetch_toddr_index_by_src(int toddr_src)
+{
+	int i;
+
+	for (i = 0; i < DDRMAX; i++) {
+		if (toddrs[i].in_use && toddrs[i].src == toddr_src)
+			return i;
+	}
+
+	return -1;
+}
+
+struct toddr *fetch_toddr_by_src(int toddr_src)
+{
+	int i;
+
+	for (i = 0; i < DDRMAX; i++) {
+		if (toddrs[i].in_use && toddrs[i].src == toddr_src)
+			return &toddrs[i];
+	}
+
+	return NULL;
+}
