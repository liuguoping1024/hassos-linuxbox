+static int t7_clk_gates_init(struct clk **clks, void __iomem *iobase)
+{
+	int clkid;
+
+	if (ARRAY_SIZE(t7_audio_clk_gates) != MCLK_BASE) {
+		pr_err("check clk gates number\n");
+		return -EINVAL;
+	}
+
+	for (clkid = 0; clkid < MCLK_BASE; clkid++) {
+		unsigned long offset =
+			(unsigned long)t7_audio_clk_gates[clkid]->reg;
+		t7_audio_clk_gates[clkid]->reg =
+			(void __iomem *)((unsigned long)iobase + offset);
+		clks[clkid] = clk_register(NULL, t7_audio_clk_hws[clkid]);
+		WARN_ON(IS_ERR_OR_NULL(clks[clkid]));
+	}
+
+	return 0;
