+struct audioresample *get_audioresample(enum resample_idx id)
+{
+	struct audioresample *p_resample;
+
+	p_resample = ((id == RESAMPLE_A) ? s_resample_a : s_resample_b);
+
+	if (!p_resample)
+		return NULL;
+
+	return p_resample;
