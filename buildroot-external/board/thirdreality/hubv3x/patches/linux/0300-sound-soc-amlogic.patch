+int aml_get_audio_edid(struct snd_kcontrol *kcontrol,
+		       unsigned int __user *bytes,
+		       unsigned int size)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct extn *p_extn = dev_get_drvdata(component->dev);
+	struct snd_ctl_tlv *tlv;
+	char *val = (char *)bytes + sizeof(*tlv);
+	int res;
+
+	/* get current edid to userspace */
+	p_extn->user_setting_edid_size =
+		(int)rx_edid_get_aud_sad(p_extn->user_setting_edid);
+
+	res = copy_to_user(val, p_extn->user_setting_edid,
+			   MAX_AUDIO_EDID_LENGTH - sizeof(*tlv));
+
+	return 0;
+}
+
+int aml_set_audio_edid(struct snd_kcontrol *kcontrol,
+		       const unsigned int __user *bytes,
+		       unsigned int size)
+{
+	struct snd_soc_component *component = snd_kcontrol_chip(kcontrol);
+	struct extn *p_extn = dev_get_drvdata(component->dev);
+	struct snd_ctl_tlv *tlv;
+	char *val = (char *)bytes + sizeof(*tlv);
+	int res, edid_size = size - sizeof(*tlv);
+	bool update = false;
+	int i = 0;
+
+	if ((edid_size % 3) != 0 || edid_size > (MAX_AUDIO_EDID_LENGTH - 3))
+		return -EFAULT;
+
+	if (edid_size == 0) {
+		/* update default edid */
+		rx_edid_set_aud_sad(NULL, 0);
+		pr_info("%s update default edid!\n", __func__);
+	} else {
+		/* first 3 bytes for pcm, don't update. */
+		memset(p_extn->user_setting_edid + 3, 0,
+		       MAX_AUDIO_EDID_LENGTH - 3);
+		res = copy_from_user(p_extn->user_setting_edid + 3,
+				     val, edid_size);
+		if (res)
+			return -EFAULT;
+
+		/* get current edid from hdmirx */
+		p_extn->default_edid_size =
+			(int)rx_edid_get_aud_sad(p_extn->default_edid);
+
+		if (p_extn->default_edid_size != edid_size + 3) {
+			update = true;
+		} else {
+			while (i < edid_size) {
+				if (p_extn->default_edid[i + 3] !=
+				    p_extn->user_setting_edid[i + 3]) {
+					update = true;
+					break;
+				}
+				i++;
+			}
+		}
+		if (update) {
+			/* first 3 bytes from default_edid for pcm */
+			memcpy(p_extn->user_setting_edid, p_extn->default_edid, 3);
+			rx_edid_set_aud_sad(p_extn->user_setting_edid,
+					edid_size + 3);
+			pr_info("%s update user setting edid! edid size = %d\n",
+				__func__, edid_size);
+			for (i = 0; i <= (edid_size + 3); i += 3) {
+				pr_debug("EDID: [%x, %x, %x]\n",
+					p_extn->user_setting_edid[i],
+					p_extn->user_setting_edid[i + 1],
+					p_extn->user_setting_edid[i + 2]);
+			}
+		}
+	}
+	p_extn->user_setting_edid_size = edid_size;
+
+	return 0;
+}
