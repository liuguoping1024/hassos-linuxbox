+static void tdm_register_early_suspend_hdr(int idx, void *pdev)
+{
+	struct early_suspend *pes = NULL;
+
+	if (idx == TDM_A)
+		pes = &tdm_es_hdr_0;
+	else if (idx == TDM_B)
+		pes = &tdm_es_hdr_1;
+	else if (idx == TDM_C)
+		pes = &tdm_es_hdr_2;
+	else
+		return;
+
+	pes->param   = pdev;
+	register_early_suspend(pes);
+}
