diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/sound/soc/amlogic/auge/loopback.c b/sound/soc/amlogic/auge/loopback.c
