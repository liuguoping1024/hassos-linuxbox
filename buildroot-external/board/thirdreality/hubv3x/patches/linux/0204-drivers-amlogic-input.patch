@@ -0,0 +1,3271 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Elan Microelectronics touch panels with I2C interface
+ *
+ * Copyright (C) 2014 Elan Microelectronics Corporation.
