+static struct bin_attribute goodix_config_bin_attr = {
+	.attr = {
+		.name = "config_bin",
+		.mode = 0664,
+	},
+	.size = GOODIX_CFG_MAX_SIZE,
+	.read = goodix_sysfs_config_read,
+	.write = goodix_sysfs_config_write,
