-			return FFS_SUCCESS;
-		}
-		if (FAT_read(sb, clu.dir, &clu.dir) != 0)
-			return FFS_MEDIAERR;
-	}
-	/* load default upcase table */
-	return __load_default_upcase_table(sb);
