+static int find_cma_owner(struct cma_owner *c, unsigned long ip)
+{
+	int i;
+
+	if (!ip)
+		return -1;
+
+	for (i = 0; i < POOL_SIZE; i++) {
+		if (!c[i].ip)
+			c[i].ip = ip;
+
+		if (c[i].ip == ip) {
+			c[i].cnt++;
+			return i;
+		}
+	}
+	return -1;
