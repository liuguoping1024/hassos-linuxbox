+			typeof(z) _z = z; \
+			MAX(MIN(100, MAX(0, (_x * 1000) / (_x + _y + _z))), \
+			MIN(100, MAX(0, (_x + _y) * 1000 / \
+			(_x + _y + _z) / 3))); \
