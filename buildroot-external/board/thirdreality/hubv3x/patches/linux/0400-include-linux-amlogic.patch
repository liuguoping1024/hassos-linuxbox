+ *	0: db value;
+ *	1: value from pdate;
+ * pdate: only useful when mode is 1.
+ *	value / mask
+ **************************************************/
+bool dim_pq_db_sel(unsigned int idx, unsigned int mode, unsigned int *pdate);
+void dim_pq_db_setreg(unsigned int nub, unsigned int *preg);
+bool dim_config_crc_ic(void);
+#endif /* VIDEO_H */
