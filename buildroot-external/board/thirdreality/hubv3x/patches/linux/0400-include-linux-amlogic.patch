+static inline int get_cpu_type(void)
+{
+	int cpu_id_from_media = 0;
+
+	cpu_id_from_media = get_cpu_type_from_media();
+	if (cpu_id_from_media)
+		return cpu_id_from_media;
+	return get_meson_cpu_version(MESON_CPU_VERSION_LVL_MAJOR);
+}
