+
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/types.h>
+#include <linux/errno.h>
+
+#define phy_addr_type ulong
+#define page_sid_type u16
+
+#define PAGE_INDEX(page) ((page) >> PAGE_SHIFT)
+
+struct codec_mm_scatter {
+	void *manager;
