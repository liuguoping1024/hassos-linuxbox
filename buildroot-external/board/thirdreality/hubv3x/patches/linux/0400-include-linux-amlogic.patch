+		const struct tuner_config *cfg)\
+{\
+	return NULL;\
+}
+
+#else
+#define aml_dvb_attach(FUNCTION, ARGS...) ({ \
+	FUNCTION(ARGS); \
+})
+
+#define aml_dvb_detach(FUNC) {}
+
+#define AML_DEMOD_ATTACH_FUNCTION(name)
+
+#define AML_TUNER_ATTACH_FUNCTION(name)
+#endif
