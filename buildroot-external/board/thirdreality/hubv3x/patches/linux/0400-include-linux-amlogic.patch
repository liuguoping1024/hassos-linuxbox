+	HDCP14_V_H2 = 0x28,
+	HDCP14_V_H3 = 0x2C,
+	HDCP14_V_H4 = 0x30,
+	HDCP14_BCAPS = 0x40,
+	HDCP14_BSTATUS = 0x41,
+	HDCP14_KSV_FIFO = 0x43,
+	HDCP2_VERSION = 0x50,
+	HDCP2_WR_MSG = 0x60,
+	HDCP2_RXSTATUS = 0x70,
+	HDCP2_RD_MSG = 0x80,
+	HDCP2_DBG = 0xC0,
+};
