+ */
+
+#ifndef _VOUT_NOTIFY_H_
+#define _VOUT_NOTIFY_H_
+
+/* Linux Headers */
+#include <linux/notifier.h>
+#include <linux/list.h>
+#include <linux/pm.h>
+
+/* Local Headers */
+#include "vinfo.h"
+
+struct vframe_match_s {
+	int fps;
+	int frame_rate; /* *100 */
+	unsigned int duration_num;
+	unsigned int duration_den;
+};
+
+struct vout_op_s {
+	struct vinfo_s *(*get_vinfo)(void *data);
