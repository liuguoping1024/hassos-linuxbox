+	};
+	int len;		/* buffer size; */
+	union {
+		char buf[1];
+		struct buf_status status;
+		struct vdec_status vstatus;
+		struct adec_status astatus;
+	};
+};
+
+struct am_io_info {
+	union {
+		int data;
+		int id;
+	};
+	int len;
+	union {
+		char buf[1];
+		struct vdec_info vinfo;
+	};
+};
