+	v = SMC_READ_REG(REG5);
+	reg5 = (struct SMCCARD_HW_REG5 *)&v;
+	reg5->cwt_detect_en = cwt_det_en;
+	reg5->bwt_base_time_gnt = BWT_BASE_DEFAULT;
