+#define NEWLINE_CANARY \
+    /* Unix */ \
+    "1\n" \
+    /* Windows */ \
+    "2\r\n" \
+    /* Mac OS */ \
+    "3\r" \
+    /* RISC OS */ \
+    "4\n\r" \
+    /* Add another character so the length isn't 0x0a bytes */ \
+    "5"
