+	}
+
+	meson_glb_trig_src_config(gbt, srcn, trig);
+	meson_glb_trig_src_enable(gbt, srcn, 1);
+
+	return 0;
+}
+EXPORT_SYMBOL(glb_timer_mipi_config);
