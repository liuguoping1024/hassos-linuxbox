+static int meson_nfc_boot_read_oob(struct nand_chip *nand, int page)
+{
+	int ret = 0;
+
+	ret = meson_nfc_boot_read_page_hwecc(nand, nand->data_buf,
+					     1, page);
+	return ret;
+}
