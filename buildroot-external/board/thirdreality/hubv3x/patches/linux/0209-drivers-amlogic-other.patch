+#define AML_D_P_UPGRADE_CHECK       (0x80)
+#define AML_D_P_IMG_DECRYPT         (0x40)
+#define AML_D_Q_IMG_SIG_HDR_SIZE    (0x100)
+
+#define DEFENDKEY_LIMIT_ADDR	    (0x0F000000)
+
