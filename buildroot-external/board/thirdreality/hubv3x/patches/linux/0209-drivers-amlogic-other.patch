+static const struct file_operations smc_fops = {
+	.owner = THIS_MODULE,
+	.open = smc_open,
+	.write = smc_write,
+	.read = smc_read,
+	.release = smc_close,
+	.unlocked_ioctl = smc_ioctl,
+	.poll = smc_poll,
+#ifdef CONFIG_COMPAT
+	.compat_ioctl = smc_ioctl_compat,
+#endif
+};
