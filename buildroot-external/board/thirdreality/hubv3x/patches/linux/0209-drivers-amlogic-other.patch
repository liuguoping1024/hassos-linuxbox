+	pr_error("xmit_rep:%d\n", smc->param.xmit_repeat_dis);
+	pr_error("xmit_try:%d\n", smc->param.xmit_retries);
+	pr_error("clk_tcnt:%d freq_cpu:%ld\n", reg2->clk_tcnt, freq_cpu);
