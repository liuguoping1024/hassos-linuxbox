+    GATOR_HANDLE_TRACEPOINT(mali_page_fault_insert_pages); \
+    GATOR_HANDLE_TRACEPOINT(mali_pm_status); \
+    GATOR_HANDLE_TRACEPOINT(mali_sw_counter); \
