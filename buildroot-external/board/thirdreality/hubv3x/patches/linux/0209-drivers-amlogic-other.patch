+	if (ret)
+		dev_err(charger->dev,
+			"Failed to read status: %d\n", __LINE__);
+
+	/*ensure sar_irq interrupt after*/
+	delay = jiffies + msecs_to_jiffies(SAR_IRQ_TIMEOUT);
+	while (1) {
+		if (time_after(jiffies, delay)) {
+			dev_err(charger->dev, "Failed read sar_irq\n");
