diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/drivers/amlogic/pci/Makefile b/drivers/amlogic/pci/Makefile
--- a/drivers/amlogic/pci/Makefile	1970-01-01 08:00:00.000000000 +0800
+++ b/drivers/amlogic/pci/Makefile	2026-02-09 11:25:55.301448581 +0800
@@ -0,0 +1,13 @@
+#
+# Amlogic PCIE specific Makefile
+#
+
+MODULE_NAME = aml_pcie_v2
