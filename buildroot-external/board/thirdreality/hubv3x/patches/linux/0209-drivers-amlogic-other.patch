+static int amlogic_pcie_set_reset_for_m31_phy(struct amlogic_pcie *amlogic, bool set)
+{
+	struct device *dev = amlogic->dev;
+	int err = 0, val = 0;
+	int regs = 0;
+
+	if (amlogic->rst_base)
+		goto set_rst_reg;
+
+	err = reset_control_deassert(amlogic->m31phy_rst);
+	if (err < 0) {
