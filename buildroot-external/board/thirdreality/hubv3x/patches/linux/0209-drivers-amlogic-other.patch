+static const struct of_device_id meson_nfc_id_table[] = {
+	{
+		.compatible = "amlogic,meson-nfc-full-ecc",
+		.data = (void *)&meson_full_ecc_data,
+	}, {
+		.compatible = "amlogic,meson-nfc-single-ecc",
