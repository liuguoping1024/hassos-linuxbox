+static int aml_sha_cra_init(struct crypto_tfm *tfm)
+{
+	struct aml_sha_ctx *tctx = crypto_tfm_ctx(tfm);
+
+	tctx->is_hmac = 0;
+	return aml_sha_cra_init_alg(tfm, NULL);
+}
+
+static void aml_sha_cra_exit(struct crypto_tfm *tfm)
+{
+	struct aml_sha_ctx *tctx = crypto_tfm_ctx(tfm);
+
