+static struct platform_driver aml_rtos_driver = {
+	.driver = {
+		.name = AML_RTOS_NAME,
+		.owner = THIS_MODULE,
+		.of_match_table = aml_freertos_dt_match,
+	},
+	.probe = aml_rtos_probe,
+	.remove = __exit_p(aml_rtos_remove),
+};
