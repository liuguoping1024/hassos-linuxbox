+static inline int smc_write_end(struct smc_dev *smc)
+{
+	int ret;
+	unsigned long flags;
+
+	spin_lock_irqsave(&smc->slock, flags);
+	ret = (!smc->cardin || !smc->send_count);
+	spin_unlock_irqrestore(&smc->slock, flags);
+
+	return ret;
