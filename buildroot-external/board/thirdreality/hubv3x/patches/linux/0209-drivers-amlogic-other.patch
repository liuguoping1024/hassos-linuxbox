+#define BANDWIDTH_PREFIX "Total bandwidth: %8d KB/s, usage: %2d.%02d%%\n"
+
+	if (aml_db->mode != MODE_ENABLE)
+		return sprintf(buf, "set mode to enable(1) first.\n");
