+struct amlogic_pcie {
+	struct dw_pcie          *pci;
+	struct pcie_phy		*phy;
+	void __iomem		*elbi_base;	/* DT 0th resource */
+	void __iomem		*cfg_base;	/* DT 2nd resource */
+	int			reset_gpio;
+	struct clk		*clk;
+	struct clk		*bus_clk;
+	struct clk		*mipi_gate;
+	struct clk		*mipi_bandgap_gate;
+	struct clk		*port_clk;
+	struct clk		*general_clk;
+	int			pcie_num;
+	int			gpio_type;
+	u32			port_num;
+	u32			pm_enable;
+	u32			device_attch;
+};
+
+#define to_amlogic_pcie(x) dev_get_drvdata((x)->dev)
