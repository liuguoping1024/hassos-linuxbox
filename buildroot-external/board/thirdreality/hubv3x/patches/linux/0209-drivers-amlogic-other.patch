+		if (databuf[0] == 1)
+			aw9523_hw_reset(aw9523);
+		else if (databuf[0] == 2)//sw-reset
+			aw9523_i2c_write(aw9523, 0x7F, 0x00);//0x7F  SW_RSTN
+		else if (databuf[0] == 3)//sw-init
+			init_leds_data();
+		else
+			aw9523_hw_off(aw9523);
+		hwen_id = databuf[0];
+	}
