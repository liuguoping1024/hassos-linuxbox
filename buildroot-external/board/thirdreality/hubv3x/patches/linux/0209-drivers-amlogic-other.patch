+static inline int smc_can_write(struct smc_dev *smc)
+{
+	int ret;
+	unsigned long flags;
+
+	spin_lock_irqsave(&smc->slock, flags);
+	ret = (!smc->cardin || (smc->send_count != SEND_BUF_SIZE));
+	spin_unlock_irqrestore(&smc->slock, flags);
+	return ret;
+}
