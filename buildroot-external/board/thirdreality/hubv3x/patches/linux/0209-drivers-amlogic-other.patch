+#ifdef MODULE
+int __init sec_pd_init(void)
+{
+	return platform_driver_register(&sec_pd_driver);
+}
+
+void sec_pd_exit(void)
+{
+	platform_driver_unregister(&sec_pd_driver);
+}
+#else
+static int sec_pd_init(void)
+{
+	return platform_driver_register(&sec_pd_driver);
+}
+arch_initcall_sync(sec_pd_init);
+#endif
