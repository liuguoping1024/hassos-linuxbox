+	seq_printf(m, "DriverCma:      %8ld kB\n",
+		   get_cma_allocated() * (1 << (PAGE_SHIFT - 10)));
+#endif
+#ifdef CONFIG_AMLOGIC_VMAP
+	vmap_report_meminfo(m);
+#endif
+}
