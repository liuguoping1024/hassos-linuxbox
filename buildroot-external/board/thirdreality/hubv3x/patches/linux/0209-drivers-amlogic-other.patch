+	do_div(tick, 1000);
+	s      += sprintf(buf + s, BANDWIDTH_PREFIX,
+			  aml_db->cur_sample.total_bandwidth,
+			  percent, rem);
+
+	for (i = 0; i < aml_db->channels; i++) {
+		s += sprintf(buf + s, "ch:%d port:%16llx: %8d KB/s\n",
+			     i, aml_db->port[i],
+			     aml_db->cur_sample.bandwidth[i]);
