+	int ret;
+
+	struct phy_device *phy_dev = dev_get_drvdata(dev);
+
+	ret = kstrtoint(buf, 0, &ovl);
+	pr_info("---reg 0x%x: ovl=0x%x\n", g_phyreg, ovl);
+	phy_write(phy_dev, g_phyreg, ovl);
+	return count;
