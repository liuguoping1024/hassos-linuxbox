@@ -0,0 +1,7 @@
+#
+# AMLOGIC SPIN NAND driver for mtd subsystem
+#
+
+MODULE_NAME = meson_spi_nand
+obj-$(CONFIG_MTD_SPI_NAND_MESON) = $(MODULE_NAME).o
