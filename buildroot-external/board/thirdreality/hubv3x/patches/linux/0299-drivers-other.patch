+		ret = regmap_write(rdev->regmap, d->enable_reg, old_mode_reg |
+			     BD718XX_BUCK_FORCE_PWM);
+		if (ret)
+			return ret;
+	}
+
+	ret = regulator_set_voltage_sel_regmap(rdev, sel);
+
+	if (enabled) {
+		int tmp;
+
+		tmp = regmap_write(rdev->regmap, BD718XX_REG_MVRFLTMASK0,
