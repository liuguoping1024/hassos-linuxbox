+	return count;
+}
+
+static ssize_t destroy_store(struct class *class, struct class_attribute *attr,
+			     const char *buf, size_t count)
+{
+	if (test_vmem) {
+		vmem_destroy_device(test_vmem);
+		test_vmem = NULL;
