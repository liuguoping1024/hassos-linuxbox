+
+	is_valid = (regval >> MESON_SAR_ADC_CHNLX_VALID_SHIFT(chan_off)) & 0x1;
+	if (!is_valid) {
+		dev_err(&indio_dev->dev,
+			"ADC chnl reg have no valid sampling data\n");
+		return -EINVAL;
+	}
