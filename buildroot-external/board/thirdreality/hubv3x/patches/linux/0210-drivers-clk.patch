+	if (!strcmp(clk_hw_get_name(hw), "sys_pll_dco") ||
+	    !strcmp(clk_hw_get_name(hw), "gp1_pll_dco")) {
+		regmap_read(clk->map, (&pll->en)->reg_off + (6 * 4), &val);
+		if (val == 0x56540000)
