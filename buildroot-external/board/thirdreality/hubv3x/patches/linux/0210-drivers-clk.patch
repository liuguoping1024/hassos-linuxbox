+	&p1_mclk_3_pll,
+	&p1_mclk_3_sel,
+	&p1_mclk_3_div2,
+	&p1_mclk_3_div_en,
+	&p1_mclk_3,
+	&p1_mclk_4_pre_od,
+	&p1_mclk_4_pll,
+	&p1_mclk_4_sel,
+	&p1_mclk_4_div2,
+	&p1_mclk_4_div_en,
