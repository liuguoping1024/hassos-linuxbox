+		.data = &tm2_clkc_data.eeclkc_data
+	},
+	{}
+};
+
+static struct platform_driver tm2_driver = {
+	.probe		= meson_tm2_probe,
+	.driver		= {
+		.name	= "tm2-clkc",
+		.of_match_table = clkc_match_table,
+	},
+};
