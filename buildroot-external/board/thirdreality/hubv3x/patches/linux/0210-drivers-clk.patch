+static struct t3_sys_pll_nb_data t3_sys_pll_nb_data = {
+	.sys_pll = &t3_sys_pll.hw,
+	.cpu_clk = &t3_cpu_clk.hw,
+	.cpu_dyn_clk = &t3_cpu_dyn_clk.hw,
+	.nb.notifier_call = t3_sys_pll_notifier_cb,
+};
