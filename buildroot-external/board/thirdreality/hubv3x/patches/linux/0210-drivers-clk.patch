+		},
+		.num_parents = 1,
+		/*
+		 * This clock feeds the CPU, avoid disabling it
+		 * Register has the risk of being directly operated
+		 */
+		.flags = CLK_IS_CRITICAL | CLK_GET_RATE_NOCACHE,
+	},
+};
+
