+	PLL_PARAMS(67, 1, 0), /*DCO=1608M OD=1608MM*/
+	PLL_PARAMS(71, 1, 0), /*DCO=1704MM OD=1704M*/
+	PLL_PARAMS(75, 1, 0), /*DCO=1800M OD=1800M*/
+	PLL_PARAMS(79, 1, 0), /*DCO=1896M OD=1896M*/
