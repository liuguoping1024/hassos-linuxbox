+			&p1_sys1_pll_dco.hw
+		},
+		.num_parents = 1,
+		/*
+		 * sys1 pll may be initialized in the bootloader
+		 * CLK_IGNORE_UNUSED is needed to prevent the system
+		 * hang up which will be called by clk_disable_unused
+		 */
+		.flags = CLK_SET_RATE_PARENT | CLK_IGNORE_UNUSED,
+	},
+};
