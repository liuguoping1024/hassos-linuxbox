+					lcd_drv->lcd_prepare(mode, frac);
+					free(mode);
+					return CMD_RET_SUCCESS;
+				}
+				printf("no lcd prepare\n");
+			}
+		}
+	} else {
+		printf("no lcd driver\n");
+	}
+#endif
+
+	free(mode);
+	return CMD_RET_FAILURE;
+}
