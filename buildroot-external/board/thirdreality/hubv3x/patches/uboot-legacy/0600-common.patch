+	text_end = (ulong)&__rodata_start - gd->reloc_off;
+
+	/*
+	 * within text section?
+	 */
+	if (addr < text_start || addr > text_end)
+		return NULL;
 
 	while (*sym) {
-		sym_addr = simple_strtoul(sym, &esym, 16);
-		sym = esym;
-		if (sym_addr > addr)
+		memcpy(sym_addr_tmp, sym, 16);
+		sym_addr = simple_strtoul(sym_addr_tmp, NULL, 16);
+		sym = sym+16;
+		if (sym_addr > addr) {
+			*naddr = sym_addr;
 			break;
+		}
 		*caddr = sym_addr;
 		csym = sym;
 		sym += strlen(sym) + 1;
 	}
+	/*
+	 * the last symbol?
+	 */
+	if (*sym == 0x00)
+		*naddr = text_end;
 
 	return csym;
 }
