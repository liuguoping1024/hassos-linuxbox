+			pwm_port = i + BL_PWM_AO_A;
+			return pwm_port;
+		}
+	}
+
+	if (strcmp(str, bl_pwm_vs_name) == 0) {
+		pwm_port = BL_PWM_VS;
+		return pwm_port;
+	}
+
+	return BL_PWM_MAX;
