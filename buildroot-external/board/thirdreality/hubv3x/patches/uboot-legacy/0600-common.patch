+                CS_KEY_DATA_LIST_DEV_PATH, strerror(errno));
+        return -1;
+    }
+
+    while (fgets(lineStr, 1024, dev_fp) != NULL) {
+        tmp_ptr = strstr(lineStr, key_name);
+        if (tmp_ptr != NULL) {
+            break;
+        }
+
+        tmp_ptr = NULL;
+    }
+
+    fclose(dev_fp);
+    dev_fp = NULL;
