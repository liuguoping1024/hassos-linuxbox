+	DRAMFreq = rd_reg(stick_store_sticky_f0_reg_base_t);
+	dll_counter = rd_reg(p_ddr_base->ddr_phy_base_address + 0x3100);
+	dll_counter = (((dll_counter >> 1) & 0xff));
+	bdlr_100step = (100000000 / (2 * DRAMFreq)) / (dll_counter + 1);
