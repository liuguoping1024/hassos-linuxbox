+    } /*ANDROID R*/
+    else {
+#if defined(CONFIG_IMAGE_FORMAT_LEGACY)
+        //check image format for rtos
+        genFmt = genimg_get_format(loadaddr);
+        hdr = (image_header_t *)loadaddr;
