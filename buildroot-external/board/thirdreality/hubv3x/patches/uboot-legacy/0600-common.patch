+	int family_id;
+	int tmp = -1;
+	int i, ts_a, ts_b, ts_m, ts_n, cnt;
+	char buf[2];
+
+	family_id = get_cpu_id().family_id;
+	switch (family_id) {
+		case MESON_CPU_MAJOR_ID_G12A:
+		case MESON_CPU_MAJOR_ID_G12B:
