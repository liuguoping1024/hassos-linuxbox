+static int do_store_bootlog(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
+{
+	int ret = 0;
+	unsigned int val;
+
+	if (argc < 2)
+		return CMD_RET_USAGE;
+
+	val = readl(AO_SEC_GP_CFG2);
+	printf("Boot logs:\n\t bl2: %d\n\tfip: %d\n", (val >> 25) & 0x7, (val >> 22) & 0x7);
+
+	return ret;
+}
