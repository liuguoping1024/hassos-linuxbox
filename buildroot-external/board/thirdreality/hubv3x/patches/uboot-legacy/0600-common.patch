+	lcd_drv = aml_lcd_get_driver();
+	if (lcd_drv) {
+		if (lcd_drv->lcd_outputmode_check) {
+			if (lcd_drv->lcd_outputmode_check(mode, frac) == 0) {
+				vout_viu_mux(VOUT_VIU2_SEL, VIU_MUX_ENCL);
