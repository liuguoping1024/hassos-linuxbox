+		if ((error_outof_count_flag) && (error_count))
+		{
+			printf("Error data out of count");
+			m_len=0;
+			break;
+		}
+		if ((*(p+i)) !=(start_pattern+pattern_offset*i))
+		{error_count++;
+			printf("Error data [0x%08x] at offset 0x%08x[0x%08x]\n", *(p+i), p_convter_int(p + i), 
