+#define STORAGE_BOOT_UNKNOWN(device) (((device) != EMMC_BOOT_FLAG)	\
+	&& ((device) != SPI_EMMC_FLAG)	\
+	&& ((device) != NAND_BOOT_FLAG)	\
+	&& ((device) != SPI_NAND_FLAG))
