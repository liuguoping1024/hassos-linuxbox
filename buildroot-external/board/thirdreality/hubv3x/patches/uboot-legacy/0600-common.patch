+static int amlmmc_erase_in_card(int argc, char *const argv[])
+{
+	int dev = 0;
+	u64 cnt = 0, blk = 0, n = 0;
+	/*sz_byte =0;*/
+	char *name = NULL;
+	u64 offset_addr = 0, size = 0;
+	struct mmc *mmc;
+	int tmp_shift;
+
+	name = argv[2];
+	dev = find_dev_num_by_partition_name (name);
+	if (dev < 0) {
+		printf("Cannot find dev.\n");
+		return 1;
