+static int do_store_exit(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
+{
+#if defined(CONFIG_AML_NAND)
+	if (device_boot_flag == NAND_BOOT_FLAG) {
+		int ret = run_command("amlnf exit", 0);
