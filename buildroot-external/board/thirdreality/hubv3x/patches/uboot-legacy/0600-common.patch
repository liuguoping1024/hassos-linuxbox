+	if (ret == 0)
+		ret = amlmmc_erase_bootloader(dev, AML_BL_BOOT);
+	if (ret)
+		printf("erase bootloader in boot partition failed\n");
+
+	return (ret == 0) ? 0 : 1;
+}
