+#ifdef CONFIG_OF_LIBFDT_OVERLAY
+static int get_fdto_totalsize(u32 *tz)
+{
+	TE(__func__);
+
+	unsigned long long dtbo_mem_addr = 0;
+	int ret;
+
+	ret = read_fdto_partition();
+	if (ret != 0)
