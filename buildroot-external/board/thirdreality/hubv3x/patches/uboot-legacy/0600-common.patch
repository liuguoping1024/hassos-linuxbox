+
+        unsigned dtbSz = 0;
+
+        //Check if encrypted image
+#ifndef CONFIG_SKIP_KERNEL_DTB_SECBOOT_CHECK
+        rc = _aml_get_secure_boot_kernel_size(loadaddr, &secureKernelImgSz);
