+static int do_vpu_clk(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
+{
+	int level;
+	int ret = 0;
+
+	if (argc == 1) {
+		return -1;
+	}
+	if (strcmp(argv[1], "set") == 0) {
+		if (argc == 3) {
+			level = (int)simple_strtoul(argv[2], NULL, 10);
+			ret = vpu_clk_change(level);
+		} else {
+			ret = -1;
+		}
+	} else if (strcmp(argv[1], "get") == 0) {
+		vpu_clk_get();
+	} else {
+		ret = -1;
+	}
+	return ret;
+}
