+		gBlDataCnt += sizeof(struct bl_ldim_s);
+		gBlDataCnt += sizeof(struct bl_custome_s);
+	}
+	p_attr->head.data_len = gBlDataCnt;
+
+	p_attr->head.rev = 0;
+	p_attr->head.crc32 = CalCRC32(0, (((unsigned char *)p_attr) + 4), gBlDataCnt - 4);
+
+	return 0;
+}
