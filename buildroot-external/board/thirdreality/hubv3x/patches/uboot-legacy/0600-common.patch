+			else
+				return 0;
+		}
+	}
+
+	if (strcmp(argv[2], "boot_state") == 0) {
+		if (strcmp(argv[1], "a") == 0) {
+			if (slot_is_bootable(&info.slots[0]))
+				return 1;
+			else
+				return 0;
+		}
+		if (strcmp(argv[1], "b") == 0) {
+			if (slot_is_bootable(&info.slots[1]))
+				return 1;
+			else
+				return 0;
+		}
+	}
+
+	return -1;
