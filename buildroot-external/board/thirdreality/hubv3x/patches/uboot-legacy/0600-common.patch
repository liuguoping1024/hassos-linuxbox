+		ret = run_command("sf probe 2", 0);
+		if (ret != 0) {
+			store_msg("nand cmd failed");
+			return -1;
+		}
+		sprintf(str, "sf erase  0 0x%x", _SPI_FLASH_ERASE_SZ);
+		ret = run_command(str,0);
+		if (ret != 0) {
+			store_msg("nand cmd failed");
+			return -1;
