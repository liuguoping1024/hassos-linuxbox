+#ifdef CONFIG_HIGH_TEMP_COOL
+void r1p1_temp_cooling(void)
+{
+	int family_id, temp, temp1, temp2;
+	unsigned int  sensornum;
+
+	family_id = get_cpu_id().family_id;
+	switch (family_id) {
+		case MESON_CPU_MAJOR_ID_G12A:
+		case MESON_CPU_MAJOR_ID_G12B:
+		case MESON_CPU_MAJOR_ID_SM1:
+			while (1) {
+				r1p1_temp_read(1, &temp1);
+				r1p1_temp_read(2, &temp2);
+				temp = temp1 > temp2 ? temp1 : temp2;
+				if (temp <= CONFIG_HIGH_TEMP_COOL) {
+					printf("device cool done\n");
+					break;
+				}
+				mdelay(2000);
+				printf("warning: temp %d over %d, cooling\n", temp,
+					CONFIG_HIGH_TEMP_COOL);
+			}
+			break;
+		case MESON_CPU_MAJOR_ID_TL1:
+		case MESON_CPU_MAJOR_ID_TM2:
+			sensornum = readl(AO_SEC_GP_CFG10);
+			sensornum = ((sensornum >> 24) & 0xf) >> 2;
+			while (1) {
+				r1p1_temp_read(1, &temp1);
+				r1p1_temp_read(2, &temp2);
+				temp = temp1 > temp2 ? temp1 : temp2;
+				if (sensornum == 0x3) {
+					r1p1_temp_read(3, &temp1);
+					temp = temp > temp1 ? temp : temp1;
+				}
+				if (temp <= CONFIG_HIGH_TEMP_COOL) {
+					printf("device cool done\n");
+					break;
+				}
+				mdelay(2000);
+				printf("warning: temp %d over %d, cooling\n", temp,
+					CONFIG_HIGH_TEMP_COOL);
+			}
+			break;
+		case MESON_CPU_MAJOR_ID_T5:
+		case MESON_CPU_MAJOR_ID_T5D:
+			while (1) {
+				r1p1_temp_read(1, &temp);
+				if (temp <= CONFIG_HIGH_TEMP_COOL) {
+					printf("device cool done\n");
+					break;
+				}
+				mdelay(2000);
+				printf("warning: temp %d over %d, cooling\n", temp,
+					CONFIG_HIGH_TEMP_COOL);
+			}
+			break;
+		default:
+			break;
+	}
+}
+#endif
+#endif
