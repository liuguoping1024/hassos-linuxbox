+		if (dev->devnum != -1) {
+			if (le16_to_cpu(dev->descriptor.idVendor) == 0x0bda
+				&& le16_to_cpu(dev->descriptor.idProduct) == 0xb720){
+				fw_8723bu = 1;
+				return dev;
