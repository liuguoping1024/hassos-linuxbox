+	U_BOOT_CMD_MKENT(get_in_range, 3, 0, do_saradc_get_in_range_12bit, "", ""),
+};
+
+static int do_saradc_12bit(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
+{
