+	switch (argc) {
+		case 1:
+			img_type_set(BMP_PIC); // default type
+			break;
+		case 2:
+			type = simple_strtoul(argv[1], NULL, 10);
+			switch (type) {
+				case BMP_PIC:
+				case RAW_PIC:
+					img_type_set(type);
+					break;
+				default:
+					return CMD_RET_USAGE;
+			}
+			break;
+		default:
+			return CMD_RET_USAGE;
+		}
+
+	return 0;
+}
