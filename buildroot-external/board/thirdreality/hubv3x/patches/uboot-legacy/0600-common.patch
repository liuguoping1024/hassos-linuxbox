+static const char* get_valid_part_name(void)
+{
+	int part_num = get_partition_num_by_name(PART_NAME_FTY);
+
+	memset(g_part_name, 0, sizeof(g_part_name));
+	if (part_num >= 0)
+		strcpy(g_part_name, PART_NAME_FTY);
+	else
+		strcpy(g_part_name, PART_NAME_RSV);
+
+	return g_part_name;
+}
