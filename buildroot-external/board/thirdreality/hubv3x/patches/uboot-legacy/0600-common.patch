+int pll_convert_to_ddr_clk_g12a(unsigned int ddr_pll)
+{
+	unsigned int ddr_clk = 0;
+	unsigned int od_div = 0xfff;
+
+	ddr_pll = ddr_pll & 0xfffff;
+	if (((ddr_pll >> 16) & 7) == 0)
+		od_div = 2;
+	if (((ddr_pll >> 16) & 7) == 1)
+		od_div = 3;
+
+	if (((ddr_pll >> 16) & 7) == 2)
+		od_div = 4;
+
+	if (((ddr_pll >> 16) & 7) == 3)
+		od_div = 6;
+
+	if (((ddr_pll >> 16) & 7) == 4)
+		od_div = 8;
+
+	if (((ddr_pll >> 10) & 0x1f))
+		ddr_clk = 2 * ((((24 * ((ddr_pll >> 0) & 0x1ff)) / ((ddr_pll >> 10) & 0x1f)) >> ((((ddr_pll >> 19) & 0x1) == 1) ? (2) : (1)))) / od_div;
+
+	return ddr_clk;
+}
