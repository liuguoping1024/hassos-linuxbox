+
+static inline int str2longlong(char *p, unsigned long long *num)
+{
+	char *endptr;
+
+	*num = simple_strtoull(p, &endptr, 16);
+	if (*endptr != '\0')
+	{
+	    switch (*endptr)
+	    {
+	        case 'g':
+	        case 'G':
+	            *num<<=30;
+		    endptr++;
+		    break;
+	        case 'm':
+	        case 'M':
+	            *num<<=20;
+		    endptr++;
+		    break;
+	        case 'k':
+	        case 'K':
+	            *num<<=10;
+	            endptr++;
+	            break;
+	    }
+	}
+
+	return (*p != '\0' && *endptr == '\0') ? 1 : 0;
+}
