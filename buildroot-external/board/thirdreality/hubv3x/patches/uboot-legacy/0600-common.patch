+
+	mode = (char *)malloc(64 * sizeof(char));
+	if (!mode) {
+		printf("cmd_vout: mode malloc falied, exit\n");
+		return CMD_RET_FAILURE;
+	}
+	memset(mode, 0, (sizeof(char) * 64));
+	sprintf(mode, "%s", argv[1]);
