+struct hdmi_format_para *hdmi_get_fmt_paras(enum hdmi_vic vic)
+{
+	int i;
+
+	for (i = 0; all_fmt_paras[i] != NULL; i++) {
+		if (vic == all_fmt_paras[i]->vic)
+			return all_fmt_paras[i];
+	}
+	return NULL;
+}
