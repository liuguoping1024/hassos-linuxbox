+/* usb id mode, only after M2
+	 mode = 0 : HARDWARE
+	 mode = 1 : SW_HOST
+	 mode = 2 : SW_DEVICE
+ */
+#define USB_ID_MODE_HARDWARE    (1)
+#define USB_ID_MODE_SW_HOST     (2)
