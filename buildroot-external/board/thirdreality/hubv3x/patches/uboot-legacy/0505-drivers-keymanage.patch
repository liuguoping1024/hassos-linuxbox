+            [_KM_DEV_INDEX_SECUREKEY]      = &_SecukeyOps,
+            [_KM_DEV_INDEX_EFUSE]          = &_efuseKeyOps,
+            [_KM_DEV_INDEX_PROVISION]	   = &_provisionKeyOps,
+};
