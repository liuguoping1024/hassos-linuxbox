+static void vpp_ofifo_init(void)
+{
+	unsigned int data32;
+
+	data32 = vpp_reg_read(VPP_OFIFO_SIZE);
+	switch (get_cpu_id().family_id) {
+	case MESON_CPU_MAJOR_ID_TXHD:
+		data32 |= 0x77f;
+		break;
+	default:
+		data32 |= 0xfff;
+		break;
+	}
+	vpp_reg_write(VPP_OFIFO_SIZE, data32);
+
+	data32 = 0x08080808;
+	vpp_reg_write(VPP_HOLD_LINES, data32);
+}
