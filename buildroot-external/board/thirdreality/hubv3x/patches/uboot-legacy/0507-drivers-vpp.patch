+void vpp_matrix_update(int type)
+{
+	if (vpp_init_flag == 0)
+		return;
+
+	VPP_PR("%s: %d\n", __func__, type);
+
+	switch (type) {
+	case VPP_CM_RGB:
+		if (get_cpu_id().family_id == MESON_CPU_MAJOR_ID_GXTVBB)
+			break;
+
+		/* 709 limit to RGB */
+		vpp_set_matrix_ycbcr2rgb(2, 3);
+		break;
+	case VPP_CM_YUV:
+		if (get_cpu_id().family_id == MESON_CPU_MAJOR_ID_GXTVBB) {
+			/* RGB to 709 limit */
+			vpp_set_post_matrix_rgb2ycbcr(0);
+		}
+		break;
+	default:
+		break;
+	}
+}
+
+void vpp_viu2_matrix_update(int type)
+{
+	if (vpp_init_flag == 0)
+		return;
+
+	if (get_cpu_id().family_id < MESON_CPU_MAJOR_ID_G12A)
+		return;
+
+	VPP_PR("%s: %d\n", __func__, type);
+
+	switch (type) {
+	case VPP_CM_RGB:
+		/* default RGB */
+		set_viu2_osd_matrix_rgb2yuv(0);
+		break;
+	case VPP_CM_YUV:
+		/* RGB to 709 limit */
+		set_viu2_osd_matrix_rgb2yuv(1);
+		break;
+	default:
+		break;
+	}
+}
