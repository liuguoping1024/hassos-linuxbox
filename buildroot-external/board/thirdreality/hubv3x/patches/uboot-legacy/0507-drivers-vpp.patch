+
+	vpp_set_lcd_gamma_table(gamma_table_r, H_SEL_R);
+	vpp_set_lcd_gamma_table(gamma_table_g, H_SEL_G);
+	vpp_set_lcd_gamma_table(gamma_table_b, H_SEL_B);
