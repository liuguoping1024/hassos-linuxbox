+			.section_size  = CONFIG_COMPRESSED_DATA_ADDR -
+					 CONFIG_SEG4_ADDR,
+			.section_index = 3,
+			.compress_type = RAM_COMPRESS_NORMAL,
+		}
+	},
+};
