+static unsigned int pwm_voltage_table[][2] = {
+	{0x180004, 900},
+	{0x170005, 910},
+	{0x160006, 920},
+	{0x150007, 930},
+	{0x140008, 940},
+	{0x130009, 950},
+	{0x12000a, 960},
+	{0x11000b, 970},
+	{0x10000c, 980},
+	{0x0f000d, 990},
+	{0x0e000e, 1000},
+	{0x0d000f, 1010},
+	{0x0c0010, 1020},
