+	{ 0x12000a,  910},
+	{ 0x11000b,  920},
+	{ 0x10000c,  930},
+	{ 0x0f000d,  940},
+	{ 0x0e000e,  950},
+	{ 0x0d000f,  960},
+	{ 0x0c0010,  970},
+	{ 0x0b0011,  980},
+	{ 0x0a0012,  990},
+	{ 0x090013, 1000},
+	{ 0x080014, 1010},
+	{ 0x070015, 1020},
+	{ 0x060016, 1030},
