+int board_eth_init(bd_t *bis)
+{
+	unsigned int tx_amp_bl2 = 0;
+	unsigned int cts_valid = 0;
+	unsigned int cts_amp = 0;
+#ifdef CONFIG_ETHERNET_NONE
+	return 0;
+#endif
+
+#ifdef ETHERNET_EXTERNAL_PHY
+	dwmac_meson_cfg_drive_strength();
+	setup_net_chip_ext();
