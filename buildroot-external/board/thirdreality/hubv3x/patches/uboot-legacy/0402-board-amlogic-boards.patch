+unsigned int pmu4_analog_reg[15] = {
+	0x00, 0x00, 0x00, 0x00, 0x00,	/* Reg   0x20 - 0x24 */
+	0x00, 0x00, 0x00, 0x00, 0x51,	/* Reg  0x25 - 0x29 */
+	0x42, 0x00, 0x42, 0x41, 0x02	/* Reg   0x2a - 0x2e */
+};
