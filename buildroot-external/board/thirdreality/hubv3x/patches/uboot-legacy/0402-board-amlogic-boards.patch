+#define dbgv(fmt, ...)
+#endif
+void quicksort1(unsigned int a[], int numsize)
+{
+	int i = 0, j = numsize-1;
+	int val = a[0];
+	if (numsize > 1) {
+		while (i < j) {
+			for (; j > i; j--)
+				if (a[j] < val) {
+					a[i] = a[j];
+					break;
+				}
+			for (; i < j; i++)
+				if (a[i] > val) {
+					a[j] = a[i];
+					break;
+				}
+		}
+	a[i] = val;
+	quicksort1(a, i);
+	quicksort1(a+i+1, numsize-1-i);
+}
