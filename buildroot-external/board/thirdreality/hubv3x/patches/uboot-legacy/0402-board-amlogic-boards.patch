+	PNL_REG_W(PNL_PREG_PAD_GPIO3_EN_N,
+		(PNL_REG_R(PNL_PREG_PAD_GPIO3_EN_N) & ~((1 << 4) | (1 << 5) | (1 << 6))));
+}
