+static void board_init_mem(void)
+{
+	unsigned int ddr_type;
+	char *env_tmp;
+
+	env_tmp = getenv("boot_ddr_type");
+	if (!env_tmp) {
+		ddr_type = (((readl(SEC_AO_SEC_GP_CFG0)) & 0x00070000) >> 16);
+		setenv("boot_ddr_type", 0);
