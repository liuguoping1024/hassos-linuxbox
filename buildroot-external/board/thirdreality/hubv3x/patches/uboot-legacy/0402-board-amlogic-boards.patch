+#if SUPPORT_HISENSE_WoBLE
+    u8 cmd[] = {0xC9, 0xFC, 0x02, 0x01, 0x0D}; // for Hisense WoBLE
+
+    usb_debug("issue wake up command for Hisense\n");
+#else
+    u8 cmd[] = {0xC9, 0xFC, 0x0D, 0x01, 0x0E, 0x00, 0x05, 0x43,
