+//---------------------------------------------------------------------------
+static int btmtk_usb_switch_iobase(struct LD_btmtk_usb_data *data, int base)
+{
+    int ret = 0;
+
+    switch (base)
+    {
+        case SYSCTL:
+            data->w_request = 0x42;
+            data->r_request = 0x47;
+            break;
+        case WLAN:
+            data->w_request = 0x02;
+            data->r_request = 0x07;
+            break;
+
+        default:
+            return -EINVAL;
+    }
+
+    return ret;
+}
