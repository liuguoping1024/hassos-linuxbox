--- a/board/amlogic/tm2_v901d_t501_v1/firmware/ramdump.h	1970-01-01 08:00:00.000000000 +0800
+++ b/board/amlogic/tm2_v901d_t501_v1/firmware/ramdump.h	2026-02-09 11:25:47.533024761 +0800
