+#ifdef CONFIG_MULTI_DTB
+int checkhw(char * name)
+{
+	/*
+	 * read board hw id
+	 * set and select the dts according the board hw id.
+	 *
+	 * hwid = 1	p321 v1
+	 * hwid = 2	p321 v2
+	 */
+	unsigned int hwid = 1;
+	char loc_name[64] = {0};
+
+	cpu_id_t cpu_id = get_cpu_id();
+	if (MESON_CPU_MAJOR_ID_TM2 == cpu_id.family_id) {
+		switch (cpu_id.chip_rev) {
+			case 0xA:
+				strcpy(loc_name, "tm2_t962e2_ab319\0");
+			break;
+			case 0xB:
+				strcpy(loc_name, "tm2-revb_t962e2_ab319\0");
+			break;
+			default:
+				strcpy(loc_name, "tm2_t962e2_unsupport");
+			break;
+		}
+	}
+	/* read hwid */
+	hwid = (readl(P_AO_SEC_GP_CFG0) >> 8) & 0xFF;
+
+	printf("checkhw:  hwid = %d\n", hwid);
+
+/*
+	switch (hwid) {
+		case 1:
+			strcpy(loc_name, "txl_p321_v1\0");
+			break;
+		case 2:
+			strcpy(loc_name, "txl_p321_v2\0");
+			break;
+		default:
+			strcpy(loc_name, "txl_p321_v1");
+			break;
+	}
+*/
+
+	strcpy(name, loc_name);
+	setenv("aml_dt", loc_name);
+	return 0;
+}
+#endif
