+	unsigned int val;
+
+	val = readl(P_PERIPHS_PIN_MUX_7);
+	val &= ~((1<<13)|(1<<12)|(1<<11)|(1<<10));
+	if (enable) {
+		val |= (1<<13)|(1<<12)|(1<<11);
+		val &= ~((1<<31)|(1<<28)|(1<<22)|(1<<21)|(1<<20));
+	}
+	writel(val, P_PERIPHS_PIN_MUX_7);
+	return 0;
+}
