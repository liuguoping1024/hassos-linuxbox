+int aml_pmu4_read(int add, uint8_t *val)
+{
+	int ret;
+	uint8_t buf[2] = { };
+	struct i2c_msg msg[] = {
+		{
+		 .addr = AML1220_ADDR,
+		 .flags = 0,
+		 .len = sizeof(buf),
+		 .buf = buf,
+		 }
+		,
+		{
+		 .addr = AML1220_ADDR,
+		 .flags = I2C_M_RD,
+		 .len = 1,
+		 .buf = val,
+		 }
+	};
+
+	buf[0] = add & 0xff;
+	buf[1] = (add >> 8) & 0x0f;
+	ret = aml_i2c_xfer(msg, 2);
+	if (ret < 0) {
+		printf("%s: i2c transfer failed, ret:%d\n", __func__, ret);
+		return ret;
+	}
+	return 0;
+}
+
+int aml_pmu4_write(int32_t add, uint8_t val)
+{
+	int ret;
+	uint8_t buf[3] = { };
+	struct i2c_msg msg[] = {
+		{
+		 .addr = AML1220_ADDR,
+		 .flags = 0,
+		 .len = sizeof(buf),
+		 .buf = buf,
+		 }
+	};
+
+	buf[0] = add & 0xff;
+	buf[1] = (add >> 8) & 0x0f;
+	buf[2] = val & 0xff;
+	ret = aml_i2c_xfer(msg, 1);
+	if (ret < 0) {
+		printf("%s: i2c transfer failed, ret:%d\n", __func__, ret);
+		return ret;
+	}
+	return 0;
+}
