+	printf("env ir_power_key = %lu\n", env_val);
+
+	if (send_usr_data(SCPI_CL_IR_POWER_KEY, (unsigned int *)&env_val,sizeof(env_val))) {
+		printf("send ir_power_key send error!...\n");
+		return -1;
+	}
+	return 0;
+}
