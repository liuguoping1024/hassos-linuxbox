+/* Reset BT-module */
+void reset_mt7668(void)
+{
+	/* Reset BT-module by reset-pin -- GPIOAO_5 */
+	clrbits_le32(P_AO_GPIO_O_EN_N, 1 << 5);
+	clrbits_le32(P_AO_GPIO_O_EN_N, 1 << 21);
+	mdelay(200);
+	setbits_le32(P_AO_GPIO_O_EN_N, 1 << 21);
+	mdelay(100);
+}
