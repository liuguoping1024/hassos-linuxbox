+/* SPDX-License-Identifier: (GPL-2.0+ OR MIT) */
+/*
+ * board/amlogic/tl1_t309_v1/firmware/scp_task/pwr_ctrl.c
+ *
+ * Copyright (C) 2020 Amlogic, Inc. All rights reserved.
+ *
+ */
