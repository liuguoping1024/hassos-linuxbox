+
+	b_id = get_board_id();
+
+	printf("%s board adc:%d\n", __func__, b_id);
+
+	switch (b_id) {
+	case 0:
+	case 1:
+	case 2:
+		strcpy(loc_name, "axg_s420_512m\0");
