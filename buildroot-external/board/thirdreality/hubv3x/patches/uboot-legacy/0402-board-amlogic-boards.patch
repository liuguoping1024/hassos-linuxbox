+int dvfs_get_voltage(unsigned int domain)
+{
+	int i = 0;
+	unsigned int reg_val = 0x040018;
+
+	if (domain == 0)
+		reg_val = P_AO_PWM_PWM_A;
+
+	if (domain == 1)
+		reg_val = P_PWM_PWM_F;
+
+	for (i = 0; i < ARRAY_SIZE(pwm_voltage_table); i++) {
+		if (pwm_voltage_table[i][0] == reg_val) {
+			return i;
+		}
+	}
+	if (i >= ARRAY_SIZE(pwm_voltage_table)) {
+	    return -1;
+	}
+	return -1;
+}
