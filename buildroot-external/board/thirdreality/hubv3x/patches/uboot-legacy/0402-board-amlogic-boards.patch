+	case pwm_ao_b:
+		for (to = 0; to < ARRAY_SIZE(pwm_voltage_table_ee); to++) {
+			if (pwm_voltage_table_ee[to][1] >= voltage) {
+				break;
+			}
+		}
+		if (to >= ARRAY_SIZE(pwm_voltage_table_ee)) {
+			to = ARRAY_SIZE(pwm_voltage_table_ee) - 1;
+		}
+		uart_puts("set vddee to 0x");
+		uart_put_hex(to, 16);
