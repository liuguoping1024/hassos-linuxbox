+#define P_EE_TIMER_E			(*((volatile unsigned *)(0xffd00000 + (0x3c62 << 2))))
+#define P_PWM_PWM_A			(*((volatile unsigned *)(0xffd1b000 + (0x0  << 2))))
+
+#define ON 1
+#define OFF 0
+
+static int pwm_voltage_table_ee[][2] = {
+	{ 0x1c0000,  810},
+	{ 0x1b0001,  820},
+	{ 0x1a0002,  830},
+	{ 0x190003,  840},
