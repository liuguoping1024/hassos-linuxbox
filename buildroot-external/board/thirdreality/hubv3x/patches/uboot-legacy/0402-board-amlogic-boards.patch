+	writel(readl(PREG_PAD_GPIO4_O) & (~(1 << 8)), PREG_PAD_GPIO4_O);
+	writel(readl(PREG_PAD_GPIO4_EN_N) & (~(1 << 8)), PREG_PAD_GPIO4_EN_N);
