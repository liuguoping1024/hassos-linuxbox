+
+#define MESON_PERIPHS1_VIRT_BASE	0xc1108400L
+#define MESON_PERIPHS1_PHYS_BASE	0xc1108400L
+
+#define MESON_PERIPHS1_VIRT_BASE	0xc1108400L
+#define MESON_PERIPHS1_PHYS_BASE	0xc1108400L
