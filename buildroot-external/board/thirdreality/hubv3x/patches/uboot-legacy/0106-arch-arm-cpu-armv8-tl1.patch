+static void cec_tx_buf_init(void)
+{
+	int i, j;
+	for (j = 0; j < CEX_TX_MSG_BUF_NUM; j++) {
+		for (i = 0; i < 16; i++) {
+			cec_tx_msgs.msg[j].buf[i] = 0;
+		}
+		cec_tx_msgs.msg[j].retry = 0;
+		cec_tx_msgs.msg[j].len = 0;
+	}
+}
