+static void hdmitx_output_blank(unsigned int blank)
+{
+	if (blank == 1)
+		hd_write_reg(P_VPU_HDMI_DATA_OVR,
+			((1 << 31) | (1 << 29) | (1 << 9)));
+	if (blank == 0)
+		hd_write_reg(P_VPU_HDMI_DATA_OVR, 0);
+}
