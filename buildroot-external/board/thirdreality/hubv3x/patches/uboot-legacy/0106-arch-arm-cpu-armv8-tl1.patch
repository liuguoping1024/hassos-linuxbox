+static int check_addr(int phy_addr)
+{
+	unsigned int local_addr = (readl(AO_DEBUG_REG1)) & 0xffff;
+	unsigned int i, mask = 0xf000, a, b;
+
+	for (i = 0; i < 4; i++) {
+		if (!(local_addr & mask)) {
+			break;
+		}
+		a = local_addr & mask;
+		b = phy_addr & mask;
+		if (a != b)	{// node is not same
+			cec_dbg_prints("addr fail 1\n");
+			return 0;
+		}
+		mask >>= 4;
+	}
+	cec_dbg_prints("addr ok\n");
+	return 1;
+}
