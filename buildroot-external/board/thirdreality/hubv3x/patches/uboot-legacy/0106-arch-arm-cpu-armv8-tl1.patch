+static void *cec_memcpy(void *memto, const void *memfrom, unsigned int size)
+{
+	char *tempfrom = (char *)memfrom;
+	char *tempto = (char *)memto;
+
+	if ((memto == NULL) || (memfrom == NULL))
+		return NULL;
+	while (size -- > 0)
+		*tempto++ = *tempfrom++;
+	return memto;
+}
