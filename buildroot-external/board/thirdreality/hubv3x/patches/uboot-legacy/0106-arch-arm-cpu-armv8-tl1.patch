+ * GPIOH_18: MOSI:reg9[11:8] =2
+ * GPIOH_19: CLK: reg9[15:12]=2
+ */
+int spicc0_pinctrl_enable(bool enable)
+{
+	unsigned int val;
+
+	val = readl(P_PERIPHS_PIN_MUX_9);
+	val &= ~(0xfff << 4);
+	if (enable)
+		val |= 0x222 << 4;
+	writel(val, P_PERIPHS_PIN_MUX_9);
+	return 0;
