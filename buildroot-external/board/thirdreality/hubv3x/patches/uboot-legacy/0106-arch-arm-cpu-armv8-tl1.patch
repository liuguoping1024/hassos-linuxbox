+int set_remote_mode(int mode)
+{
+	const reg_remote *reg;
+
+	if (mode >= sizeof(remoteregsTab)/sizeof(remoteregsTab[0])) {
+		uart_puts("invalid IR protocol: 0x");
+		uart_put_hex(mode, 16);
+		uart_puts("\n");
+		return -1;
+	}
+	reg = remoteregsTab[mode];
+	while (CONFIG_END != reg->reg)
+		setremotereg(reg++);
