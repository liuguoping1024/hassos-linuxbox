+{
+	if (((cec_msg.log_addr & 0xf) == 0) &&
+	    ((hdmi_cec_func_config >> CEC_FUNC_MASK) & 0x1) &&
+	    ((hdmi_cec_func_config >> ONE_TOUCH_STANDBY_MASK) & 0x1)) {
