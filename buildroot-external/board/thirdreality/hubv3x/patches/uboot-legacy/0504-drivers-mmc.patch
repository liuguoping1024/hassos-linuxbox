+#define MAX_CALI_RETRY	(3)
+#define MAX_DELAY_CNT	(16)
+#define CALI_BLK_CNT	(10)
+#define REFIX_BLK_CNT	(100)
+#define CALI_PATTERN_ADDR	(0x13800)
+u8 line_x, cal_time;
+u8 dly_tmp;
+u8 max_index;
