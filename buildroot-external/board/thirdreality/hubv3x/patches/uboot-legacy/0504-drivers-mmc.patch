+int aml_write_chip_id(struct mmc *mmc)
+{
+	struct aml_card_sd_info *aml_priv = mmc->priv;
+	struct tuning_para *parameter = aml_priv->para;
+	struct tuning_para *para;
+	uint8_t chip_id[16];
+	void *buf;
+	int same_para = 1;
+	int i, blk, off;
+	int n;
+	int para_size;
+	int size;
+	unsigned int vddee = CONFIG_VDDEE_INIT_VOLTAGE;
