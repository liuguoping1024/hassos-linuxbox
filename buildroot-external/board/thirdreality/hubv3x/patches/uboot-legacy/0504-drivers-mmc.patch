+static int emmc_detect_base_line(u64 *arr)
+{
+	u32 i = 0, first[10] = {0};
+	u32  max = 0, l_max = 0xff;
+	for (i = 0; i < 8; i++) {
+		first[i] = fbinary(arr[i]);
+		if (first[i] > max) {
+			l_max = i;
+			max = first[i];
+		}
+	}
+	printf("%s [%d] detect line:%d, max: %u\n",
+			__func__, __LINE__, l_max, max);
+	return max;
+}
