+
+       if (NULL == p_iptbl_ept)
+			   goto _out;
+	   partition = p_iptbl_ept->partitions;
+	   ret = _get_part_index_by_name(partition,
+					   p_iptbl_ept->count, name);
+_out:
+	   return ret;
+}
