+//Clear response data buffer
+static void sd_inand_clear_response(unsigned * res_buf)
+{
+	int i;
+	if (res_buf == NULL)
+		return;
+
+	for (i = 0; i < MAX_RESPONSE_BYTES; i++)
+		res_buf[i]=0;
+}
