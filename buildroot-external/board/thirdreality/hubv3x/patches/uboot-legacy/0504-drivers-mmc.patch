+int aml_sd_init(struct mmc *mmc)
+{
+	struct aml_card_sd_info *sdio=mmc->priv;
+
+	if (sdio->inited_flag) {
+		sdio->sd_emmc_init(sdio->sd_emmc_port);
+		mmc->cfg->ops->set_ios(mmc);
+		return 0;
+	}
+
+	if (sd_inand_check_insert(mmc)) {
+		sd_inand_staff_init(mmc);
+		return 0;
+	} else
+		return 1;
+}
