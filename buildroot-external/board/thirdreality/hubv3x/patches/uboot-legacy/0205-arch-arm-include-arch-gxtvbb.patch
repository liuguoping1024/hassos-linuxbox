+//Bit 7:0   hist_min    minimum value
+//read only
+#define   VI_HIST_MAX_MIN                          (0x2e03)
+#define P_VI_HIST_MAX_MIN                          (volatile unsigned int *)((0x2e03  << 2) + 0xff900000)
