+#define __asmeq(x, y)  ".ifnc " x "," y " ; .err ; .endif\n\t"
+static void hdcp14_init(void)
+{
+	register long x0 asm("x0") = 0x82000012;
+	asm volatile(
+		__asmeq("%0", "x0")
+		"smc #0\n"
+		: : "r"(x0)
+	);
+}
