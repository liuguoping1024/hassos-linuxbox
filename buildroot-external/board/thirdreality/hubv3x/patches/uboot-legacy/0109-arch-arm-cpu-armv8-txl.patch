+/* SPDX-License-Identifier: (GPL-2.0+ OR MIT) */
+/*
+ * arch/arm/cpu/armv8/txl/firmware/scp_task/hdmi_cec_arc.c
+ *
+ * Copyright (C) 2020 Amlogic, Inc. All rights reserved.
+ *
