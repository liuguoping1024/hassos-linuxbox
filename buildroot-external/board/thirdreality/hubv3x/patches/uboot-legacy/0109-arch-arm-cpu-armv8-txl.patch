+	{{HDMI_3840x2160p24_16x9, HDMI_3840x2160p24_64x27, HDMI_3840x2160p25_16x9, HDMI_3840x2160p25_64x27,
+	HDMI_3840x2160p30_16x9, HDMI_3840x2160p30_64x27,
