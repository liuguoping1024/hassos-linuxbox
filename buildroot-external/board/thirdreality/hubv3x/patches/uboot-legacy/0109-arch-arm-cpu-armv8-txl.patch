+int spicc_clk_enable(bool enable)
+{
+	u32 regv;
+
+	regv = readl(P_HHI_GCLK_MPEG0);
+	if (enable)
+		regv |= 1 << 8;
+	else
+		regv &= ~(1 << 8);
+	writel(regv, P_HHI_GCLK_MPEG0);
+	return 0;
+}
