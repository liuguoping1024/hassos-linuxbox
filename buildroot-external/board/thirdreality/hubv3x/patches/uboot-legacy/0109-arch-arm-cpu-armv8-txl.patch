+static int sys_pll_test_all(sys_pll_cfg_t * sys_pll_cfg) {
+	unsigned int i=0;
+	int ret=0;
+	for (i=0; i<(sizeof(sys_pll_cfg_t)/sizeof(sys_pll_set_t)); i++) {
+		ret += sys_pll_test(&(sys_pll_cfg->sys_pll[i]));
+	}
+	return ret;
+}
