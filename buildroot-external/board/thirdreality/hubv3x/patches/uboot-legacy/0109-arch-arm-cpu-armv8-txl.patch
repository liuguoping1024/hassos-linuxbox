+	}
+
+	if (frac) {
+		if (hdmitx_likely_frac_rate_mode(mode) == 0) {
+			printf("hdmitx: outputmode[%s] don't support frac\n", mode);
+			return 0xff;
+		}
+	}
+	if ((!strcmp(mode, "480i60hz")) || (!strcmp(mode, "576i50hz")))
+		ret = VIU_MUX_ENCI;
+	else
+		ret = VIU_MUX_ENCP;
+	return ret;
+}
