+            unsigned sync_mode:2;  // 27 from efuse
+            unsigned size:2;       // 29 from efuse
+            unsigned active:1;     // 31
+        } b;
+    } cfg;
+    uint16_t id;
+    uint16_t max; // id:0x100 user, max:0 disable.
