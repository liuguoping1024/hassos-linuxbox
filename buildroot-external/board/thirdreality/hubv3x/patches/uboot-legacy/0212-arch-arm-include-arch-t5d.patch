+                              // SequenceCtrl[10] = Run Reserved
+                              // SequenceCtrl[11] = Run Reserved
+                              // SequenceCtrl[12] = Run Reserved
+                              // SequenceCtrl[13] = Run Reserved
+                              // SequenceCtrl[15-14] =  RFU, must be zero
