+                ret = __LINE__; goto _finish;
+        }
+        optimus_progress_ui_direct_update_progress(hUiProgress, UPGRADE_STEPS_AFTER_DISK_INIT_OK);
+
+        datapartsSz = optimus_img_decoder_get_data_parts_size(hImg, &hasBootloader);
