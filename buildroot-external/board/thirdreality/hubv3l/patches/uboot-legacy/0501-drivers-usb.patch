+			}
+		}
+		info.lock_state = 1;
+	} else {
+		error("unknown variable: %s\n", cmd);
+		strcpy(response, "FAILVariable not implemented");
+	}
+
+	dump_lock_info(info);
+	sprintf(lock_d, "%d%d%d0%d%d%d0", info.version_major, info.version_minor,
