+static void do_setup_in_status_phase( pcd_struct_t *_pcd)
+{
+        dwc_ep_t *ep0 = &g_dwc_eps[0];
+        if (_pcd->ep0state == EP0_STALL) {
+                return;
+        }
+
+        _pcd->ep0state = EP0_STATUS;
