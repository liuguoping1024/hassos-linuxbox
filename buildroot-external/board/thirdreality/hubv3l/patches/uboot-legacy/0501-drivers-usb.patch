+unsigned add_sum(const void* pBuf, const unsigned size)
+{
+    unsigned sum		 =	0;
+    const unsigned* data = (const unsigned*)pBuf;
+    unsigned wordLen 	 = size>>2;
+    unsigned rest 		 = size & 3;
+
+    for (; wordLen/4; wordLen -= 4)
+    {
+        sum += *data++;
+        sum += *data++;
+        sum += *data++;
+        sum += *data++;
+    }
+    while (wordLen--)
+    {
+        sum += *data++;
+    }
+
+    if (rest == 0)
+    {
+        ;
+    }
+    else if(rest == 1)
+    {
+        sum += (*data) & 0xff;
+    }
+    else if(rest == 2)
+    {
+        sum += (*data) & 0xffff;
+    }
+    else if(rest == 3)
+    {
+        sum += (*data) & 0xffffff;
+    }
+
+    return sum;
+}
