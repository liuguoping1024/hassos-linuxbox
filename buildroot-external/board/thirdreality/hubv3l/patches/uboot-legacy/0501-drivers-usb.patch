+char generalDataChange(const char input)
+{
+	int i;
+	char result = 0;
+
+	for (i=0; i<8; i++) {
+         if ((input & (1<<i)) != 0)
+            result |= (1<<(7-i));
+         else
+            result &= ~(1<<(7-i));
+	}
+
+	return result;
+}
+
+void hdcpDataEncryption(const int len, const char *input, char *out)
+{
+     int i = 0;
+
+     for (i=0; i<len; i++)
+         *out++ = generalDataChange(*input++);
+}
+
+void hdcpDataDecryption(const int len, const char *input, char *out)
+{
+     int i = 0;
+
+     for (i=0; i<len; i++)
+         *out++ = generalDataChange(*input++);
+}
