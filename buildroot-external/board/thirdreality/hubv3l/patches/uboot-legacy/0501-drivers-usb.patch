+static char hex_to_asc(char para)
+{
+    if (para >= 0 && para <= 9)
+        para = para + '0';
+    else if(para >= 0xa && para <= 0xf)
+        para = para + 'a' - 0xa;
+
+    return para;
+}
+
+static char asc_to_hex(char para)
+{
+    if (para >= '0' && para <= '9')
+        para = para - '0';
+    else if(para >= 'a' && para <= 'f')
+        para = para - 'a' + 0xa;
+    else if(para >= 'A' && para <= 'F')
+        para = para - 'A' + 0xa;
+
+    return para;
+}
