+int cmd_securestore(int argc, char *argv[], char *buf)
+{
+    int error = -1;
+    unsigned int key_status = 0, sstorekey_len = 0;
+    char *sstorekey_cmd, *sstorekey_name, *sstorekey_data;
+    char name_buf[20], data_buf[4096];
+
+    /* at least two arguments please */
+    if (argc < 2)
+        goto err;
+
