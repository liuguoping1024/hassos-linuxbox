+#define debugP(fmt...) //printf("Dbg[WRP]L%d:", __LINE__),printf(fmt)
+#define errorP(fmt...) printf("Err[WRP]L%d:", __LINE__),printf(fmt)
+#define wrnP(fmt...)   printf("wrn:"fmt)
+#define MsgP(fmt...)   printf("[WRP]"fmt)
