+/**
+  *     cmd_securestore
+  *     read: command in *argv[], don't allow to read datas
+  *     return: 0->success, 1->have not writen, -1->failed
+  *
+  *     write: command in *argv[], and datas length in buf
+  *     return: 0->success, -1->failed
