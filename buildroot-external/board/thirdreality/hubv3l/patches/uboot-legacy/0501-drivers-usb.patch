+        DBG( "EP0 IN ZLP\n");
+        ep0->xfer_len = 0;
+        ep0->xfer_count = 0;
+        ep0->is_in = 1;
+
+        dwc_otg_ep_start_transfer( ep0 );
+
+        /* Prepare for more SETUP Packets */
+        ep0_out_start();
