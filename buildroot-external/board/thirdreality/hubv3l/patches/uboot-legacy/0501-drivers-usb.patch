+	if (b_platform_usb_check_g12b_revb() || b_platform_usb_check_sm1())
+		return;
+	(*(volatile uint32_t *)(phy_reg_base + 0x38)) = 0x0;
+	(*(volatile uint32_t *)(phy_reg_base + 0x34)) = USB_G12x_PHY_PLL_SETTING_3;
+#endif
+}
