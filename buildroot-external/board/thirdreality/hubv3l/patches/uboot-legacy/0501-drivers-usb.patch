+#define OPTIMUS_DOWNLOAD_SLOT_NUM               (OPTIMUS_DOWNLOAD_TRANSFER_BUF_TOTALSZ/OPTIMUS_DOWNLOAD_SLOT_SZ)
+
+//[Buffer 3] This buffer is used to Back up sparse chunk headers for verifying sparse image
