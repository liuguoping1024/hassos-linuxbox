+#ifndef __DWC_OTG_REGS_294_H__
+#define __DWC_OTG_REGS_294_H__
+
+/** Maximum number of Periodic FIFOs */
+#define MAX_PERIO_FIFOS 15
+/** Maximum number of Periodic FIFOs */
