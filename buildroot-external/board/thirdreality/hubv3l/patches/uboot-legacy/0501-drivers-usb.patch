+static int usb_bootm(const void *addr)
+{
+	char cmd[128];
+	memset(cmd, 0, sizeof(cmd));
+	sprintf(cmd, "bootm %llx", (unsigned long long)addr);
+	return run_command(cmd, 0);
+}
