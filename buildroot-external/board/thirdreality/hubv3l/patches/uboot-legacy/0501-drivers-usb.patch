+/*
+ * Convert a string to lowercase.
+ */
+static void downcase(char *str)
+{
+   char c = *str;
+   for (; '\0' != c; ++str, c = *str) {
+        if (c < 0) continue;
+        if (!isascii(c)) continue;
+        *str = tolower(c);
+    }
