+static int opimus_func_write_bootloader(unsigned long addr)
+{
+        int ret = 0;
+        loff_t size = 0;
+
+        size = 0x60000;//FIXME: 256K at most ??
+
+        ret = store_boot_write((u8*)addr, (loff_t)0, size);
