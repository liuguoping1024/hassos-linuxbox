+int optimus_progress_ui_release(__hdle hUiPrgress)
+{
+    UiProgress_t* pUiProgress = (UiProgress_t*)hUiPrgress;
+
+    DWN_MSG("Release progress bar res\n");
+    if (pUiProgress)
+    {
+        free(pUiProgress), pUiProgress = NULL;
+    }
+
+    return 0;
+}
