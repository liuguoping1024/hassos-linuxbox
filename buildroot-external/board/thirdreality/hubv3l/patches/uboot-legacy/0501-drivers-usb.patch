+		r1.d32 = usb_aml_reg->usb_r1;
+		r1.b.u3h_host_port_power_control_present = 1;
+		r1.b.u3h_fladj_30mhz_reg = 0x20;
+		usb_aml_reg->usb_r2 = r1.d32;
+		udelay(2);
