+/**
+ * Contains pointers to register base addresses
+ * for the usb controller.
+ */
+struct amlogic_xhci {
+	struct amlogic_usb2_phy *usb2_phy;
+	struct amlogic_usb3_phy *usb3_phy;
+	struct xhci_hccr *hcd;
+	struct dwc3 *dwc3_reg;
+};
