+int do_usb_update(cmd_tbl_t *cmdtp, int flag, int argc, char * const argv[])
+{
+	int rcode = 0;
+
+    const char* partName    = argv[1];
+    const char* imgItemPath = argv[2];
+    const char* fileFmt     = argc > 3 ? argv[3] : NULL;
+    const char* verifyFile  = argc > 4 ? argv[4] : NULL;
