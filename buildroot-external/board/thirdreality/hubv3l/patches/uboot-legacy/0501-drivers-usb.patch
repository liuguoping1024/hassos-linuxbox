+static int _get_chipid(char* buff)
+{
+    int i = 0;
+    unsigned char chipid[16];
+    int ret = get_chip_id(chipid, 16);
+    if ( ret ) {
+        DWN_ERR("_get_chipid %d", ret);
+        return ret;
+    }
+
+    buff[0] = ':';
+    for (; i < 12; ++i) {
+        sprintf(buff + 1 + i*2, "%02x", chipid[15-i]);
+    }
+    buff[1 + i*2] = '\0';
+    return 0;
+}
