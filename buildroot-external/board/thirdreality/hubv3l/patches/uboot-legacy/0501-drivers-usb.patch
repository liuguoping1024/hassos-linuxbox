+//Image info for burnning and verify
+//FIXME: how to assert that image not larger than the partition
+#define IMG_BURN_INFO_SZ    96
+struct ImgBurnInfo{
+    u8  imgType;    //0 normal, 1 sparse
+    u8  verifyAlgorithm;//0--sha1sum, 1--crc32, 2--addsum
+    u8  imgBurnSta;//
