+    FB_DBG("SYSCTRL_SEC_STATUS_REG1 0x%x\n", cfg9);
+    return !(cfg9 & (1U<<12));
+#else
+    const unsigned cfg9 = readl(P_AO_SEC_SD_CFG9);
+    FB_DBG("cfg9 0x%x\n", cfg9);
+    return cfg9 & (1U<<15);
+#endif// #ifdef SYSCTRL_SEC_STATUS_REG1
+}
+#endif
