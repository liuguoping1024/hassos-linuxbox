+/* LinuxBox Lite RGB LED early-on: high=on, all-high=white (common cathode).
+ * Direct-register writes -> immune to GPIO bank-number drift across u-boot trees.
+ * RGB_R=GPIOAO_3, RGB_G=GPIOZ_4, RGB_B=GPIOZ_5 (schematic Core page).
+ */
+static void rgb_led_early_white(void)
+{
+	/* RGB_R = GPIOAO_3 (AO domain): OEN & OUT both in 0xff800024 */
+	clrbits_le32(0xff800014, 0xf << 12);	/* pinmux -> GPIO */
+	clrbits_le32(0xff800024, 1 << 3);	/* dir = output (0) */
+	setbits_le32(0xff800024, 1 << 19);	/* out high (bit 16+3) */
+
+	/* RGB_G = GPIOZ_4, RGB_B = GPIOZ_5 (EE domain) */
+	clrbits_le32(0xff634488, (0xf << 16) | (0xf << 20));	/* pinmux -> GPIO */
+	clrbits_le32(0xff634454, (1 << 4) | (1 << 5));	/* dir = output */
+	setbits_le32(0xff634458, (1 << 4) | (1 << 5));	/* out high */
+
+	printf("RGB LED: early white on\n");
+}
