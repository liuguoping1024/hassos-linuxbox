+
+					mtd->ecc_stats.failed++;
+					printk("rdoob pl0 failed pg%d chip%d\n",
+						page_addr, i);
+				} else {
+if (aml_chip->ecc_cnt_cur > aml_chip->ecc_cnt_limit) {
