+/*...other way to access cfg...*/
+typedef union _nand_cfg {
+    /** raw register data */
+    u32 d;
+    /** register bits */
+    struct {
+        u32 bus_cyc:5;	//0
+        u32 bus_tim:5;	//5
+        u32 sync:2;	//10
+        u32 cmd_start:1;	//12
