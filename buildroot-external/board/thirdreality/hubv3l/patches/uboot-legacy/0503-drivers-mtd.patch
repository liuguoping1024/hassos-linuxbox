+void aml_nand_read_retry_exit_toshiba(struct mtd_info *mtd, int chipnr)
+{
+	struct aml_nand_chip *aml_chip = mtd_to_nand_chip(mtd);
+
+	struct nand_chip *chip = &aml_chip->chip;
+	uint8_t buf[5] = {0};
