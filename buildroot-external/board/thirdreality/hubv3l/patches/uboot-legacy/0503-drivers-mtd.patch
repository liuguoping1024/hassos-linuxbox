+#ifdef NEW_NAND_SUPPORT
+			readretry_failed_cnt = 0;
+read_retry:
+#endif
+			page_addr = aml_chip->page_addr;
+			for (j = 0; j < internal_chipnr; j++) {
+			if (j > 0) {
+				page_addr = aml_chip->page_addr;
+				page_addr |=
+				(1 << aml_chip->internal_chip_shift) * j;
+				aml_chip->aml_nand_select_chip(aml_chip, i);
