+static int do_bl2_ops(cmd_tbl_t * cmdtp, int flag, int argc, char * const argv[])
+{
+	int ret = 0;
+	int copy_num = 4;
+	int i;
+	ulong cpy;
+	char *sub;
+	nand_info_t *nand;
+	unsigned long addr;
+	int base = 2;
+	u64 off, maxsize;
