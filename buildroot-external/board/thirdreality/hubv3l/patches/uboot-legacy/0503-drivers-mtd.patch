+	((AML_NAND_CE0) | \
+	(AML_NAND_CE1 << 4) | \
+	(AML_NAND_CE2 << 8) | \
+	(AML_NAND_CE3 << 12))
+
+#define	RB_PAD_DEFAULT	(AML_NAND_CE0)
+#define MAX_CHIP_NUM 4
+
+/*** HW controller configuration ***/
+struct hw_controller {
+	u32 chip_selected;
+	u32 rb_received;
+	u8 chip_num;
+	u32 ce_enable[MAX_CHIP_NUM];
+	u32 rb_enable[MAX_CHIP_NUM];
