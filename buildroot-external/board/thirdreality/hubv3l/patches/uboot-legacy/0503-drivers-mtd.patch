+			if ((aml_chip->new_nand_info.type == SANDISK_19NM)
+			||(aml_chip->new_nand_info.type == SANDISK_24NM))
+				aml_nand_dynamic_read_init_start(aml_chip, i);
+		}
+	}
+}
