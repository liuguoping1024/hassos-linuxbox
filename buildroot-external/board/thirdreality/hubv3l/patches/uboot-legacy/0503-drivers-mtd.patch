+		addr = (ulong)simple_strtoul(argv[base], NULL, 16);
+		cpy = (ulong)simple_strtoul(argv[base + 1], NULL, 16);
+		rwsize = (ulong)simple_strtoul(argv[base + 2], NULL, 16);
+		off = cpy * limit;
+		ret = nand_read_skip_bad(nand, off, &rwsize,
+							 NULL, limit,
