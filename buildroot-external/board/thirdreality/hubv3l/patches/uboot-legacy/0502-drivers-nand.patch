+					/* plane 0 is good , set plane 1 */
+					ret = set_block_status(aml_chip,
+						chipnr, (blk_addr),
+						NAND_BLOCK_USED_BAD);
+					ret = set_block_status(aml_chip,
+						chipnr, (blk_addr+1),
+						NAND_BLOCK_USED_BAD);
+				aml_nand_dbg("set blk bad at chip%d blk=%d",
+						chipnr, blk_addr);
+				aml_nand_dbg("set blk bad at chip %d blk %d",
+						chipnr, (blk_addr+1));
+				} else {/* plane 1 is good, set plane 0 */
+					ret = set_block_status(aml_chip, chipnr,
+						(blk_addr),
+						NAND_BLOCK_USED_BAD);
+					ret = set_block_status(aml_chip, chipnr,
