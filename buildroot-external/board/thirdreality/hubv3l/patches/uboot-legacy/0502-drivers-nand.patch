+
+static struct class uboot_class = {
+
+	.name = "bootloader",
+	.owner = THIS_MODULE,
+	.suspend = uboot_suspend,
+	.resume = uboot_resume,
+};
+
+static const struct file_operations uboot_fops = {
+	.owner = THIS_MODULE,
+	.open = uboot_open,
+	.read = uboot_read,
