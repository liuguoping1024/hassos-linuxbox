+	memset(buf, 0, 528);
+	for (i=0; i<528; i++) {
+		buf[i] = controller->readbyte(controller);
+		 NFC_SEND_CMD_IDLE(controller, 0);
+		  NFC_SEND_CMD_IDLE(controller, 0);
+	}
+
+//	unsigned char temp_orgin[8],temp_inverse[8];
