+	ops_para->data_buf = aml_chip->user_page_buf;
+	ops_para->oob_buf = aml_chip->user_oob_buf;
+
+	memset(ops_para->data_buf, 0xAA, flash->pagesize);
+	memset(ops_para->oob_buf, 0x55, DBG_OOB_LEN);
