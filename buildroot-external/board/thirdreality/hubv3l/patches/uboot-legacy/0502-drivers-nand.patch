+#include "../include/phynand.h"
+#ifndef AML_NAND_UBOOT
+#include<linux/cdev.h>
+#include <linux/device.h>
+
+#define CONFIG_ENV_SIZE  \
+	((get_cpu_type() >= MESON_CPU_MAJOR_ID_M8) ? (64*1024U) : (0x8000U))
+
+
+#define ENV_NAME	"nand_env"
