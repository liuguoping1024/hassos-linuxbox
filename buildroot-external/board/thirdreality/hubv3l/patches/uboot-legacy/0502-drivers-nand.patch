+void set_spare_data(uchar* buf,uint32 data,uchar offset,uchar num)
+{
+    uint32 shift,i;
+    for(i=0;i<num;i++)
+    {
+        shift = num-i;
+        shift -= 1;
+        shift <<= 3;
+        buf[offset+i] = data>>shift;
+    }
+}
+
+uint32 get_spare_data(uchar* buf,uchar offset,uchar num)
+{
+    uint32 data,i;
+    for(i=0,data=0;i<num;i++)
+    {
+        data <<= 8;
+        data |= buf[offset+i];
+    }
+    return data;
+
+}
