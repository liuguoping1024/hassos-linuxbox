+int add_to_gc_list_tail(_prio_gc *prio_gc,_prio_gc_node* gc_node)
+{
+	_prio_gc_node * p = &prio_gc->prio_gc_head;
+
+	while(p->prio_gc_next != NULL)
+	{
+		p = p->prio_gc_next;
+	}
+
+	p->prio_gc_next = gc_node;
+	gc_node->prio_gc_next = NULL;
+	gc_node->prio_gc_prev = p;
+	prio_gc->gc_num += 1;
+	return 0;
+}
