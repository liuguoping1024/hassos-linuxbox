+				return -1;
+			}
+			ret = nftl_dev->flush(nftl_dev);
+			if (ret < 0) {
+				aml_nand_dbg("nftl flush cache failed");
+				return -1;
+			}
+		}
+
+		aml_nand_msg(" %d sector %s : %s",
