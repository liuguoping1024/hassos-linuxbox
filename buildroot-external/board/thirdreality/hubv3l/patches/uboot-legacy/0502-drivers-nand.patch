+	controller->select_chip(controller, ops_para->chipnr);
+	nand_get_chip(aml_chip);
+	ret = operation->write_page(aml_chip);
+	if (ret < 0) {
+		aml_nand_msg("%s() %d: nand write failed", __func__, __LINE__);
+	}
+	nand_release_chip(aml_chip);
+
+}
