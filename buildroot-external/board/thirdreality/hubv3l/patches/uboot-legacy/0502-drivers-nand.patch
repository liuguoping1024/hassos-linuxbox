+static void show_nand_driver_version(void)
+{
+	aml_nand_msg("Nand PHY Ver:%d.%02d.%03d.%04d (c) 2013 Amlogic Inc.",
+		(DRV_PHY_VERSION >> 24)&0xff,
+		(DRV_PHY_VERSION >> 16)&0xff,
