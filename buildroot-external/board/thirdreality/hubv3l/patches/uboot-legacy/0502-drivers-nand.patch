+
+        }
+		printf("NAND %s %s\n", "MARKBAD", (ret <0) ? "ERROR" : "OK");
+		return 0;
+	}
+    if (strcmp(cmd, "markbad_reserved") == 0) {
+
+		if (argc < 3) {
+			goto usage;
+		}
+
+		if (!(str2long(argv[2], (unsigned long*)&markbad_reserved_addr))) {
