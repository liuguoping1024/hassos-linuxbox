+/* basic operation test here, read/write/erase */
+#if 0
+	amlchip_opstest(aml_chip);
+#endif
+
+	return NAND_SUCCESS;
+error_exit1:
+	nand_buf_free(aml_chip);
+error_exit0:
+	return ret;
+
