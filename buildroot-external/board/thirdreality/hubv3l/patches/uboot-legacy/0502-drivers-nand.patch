+	amlnf_logicdev->nftl_cfg.nftl_use_cache = NFTL_DONT_CACHE_DATA;
+	amlnf_logicdev->nftl_cfg.nftl_support_gc_read_reclaim = SUPPORT_GC_READ_RECLAIM;
