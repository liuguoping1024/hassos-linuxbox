+
+	/*
+	if (flash->new_type != TOSHIBA_2XNM)
+		return NAND_SUCCESS;
+	*/
+	cur_cnt = retry_info->cur_cnt_lp[chipnr];
+	/*
+	aml_nand_dbg("flash->new_type:%d, cur_cnt:%d",flash->new_type,cur_cnt);
+	*/
+	ret = set_reg_value_toshiba(controller,
