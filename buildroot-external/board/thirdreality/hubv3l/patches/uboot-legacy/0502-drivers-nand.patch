+int amlnf_logic_init(u32 flag)
+{
+	struct amlnand_phydev *phydev = NULL;
+	int ret = 0;
+
+	aml_nand_msg("amlnand_add_nftl:");
+	/* amlnand_show_dev_partition(aml_chip); */
+	list_for_each_entry(phydev, &nphy_dev_list, list) {
