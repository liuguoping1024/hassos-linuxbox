+	   //printk("argc %d\n", argc);
+	   if (argc == 2) {
+		   show_ldev_list();
+		   return 0;
+	   }
+	   //fixme,
+	   goto usage;
+	   return 0;
+	}
+
+	if ((strcmp(cmd, "read_byte") == 0)
+		|| (strcmp(cmd, "write_byte") == 0)
+		|| (strcmp(cmd, "lwrite") == 0)
+		||(strcmp(cmd, "lread") == 0)) {
+
+		if (argc < 6)
+			goto usage;
+
+		dev_name = argv[2];
+		nftl_dev = NULL;
