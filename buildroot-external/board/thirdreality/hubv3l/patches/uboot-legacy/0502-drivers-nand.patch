+
+		if (arg_off_size(argc - 4, (char **)(argv + 4), 0x0, &off, &size) != 0)
+			goto usage;
+
+		if (off % 512) {
+			start_secor = ((int) (off / 512) + 1);
+			aml_nand_dbg("secor+1");
+		} else
+			start_secor = (int) (off / 512);
+
+		if (size % 512) {
+			length = ((int)((size / 512))+1);
+			aml_nand_dbg("length+1");
+		} else
+			length = (int)((size / 512));
+
+		aml_nand_dbg("start_secor =%d", start_secor);
