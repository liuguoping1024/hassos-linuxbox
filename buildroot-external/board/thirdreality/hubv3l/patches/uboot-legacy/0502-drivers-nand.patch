+	if (flash->new_type == HYNIX_1YNM)
+		return NAND_SUCCESS;
+	/* aml_nand_dbg("flash->new_type:%d", flash->new_type); */
+
+	for (i = 0; i < controller->chip_num; i++) {
+		ret = set_reg_value_hynix(controller,
