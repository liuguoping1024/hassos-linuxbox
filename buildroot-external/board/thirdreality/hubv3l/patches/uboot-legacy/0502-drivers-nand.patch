+		if (strncmp(cmd, "rom_read", 8) == 0)
+				nfread_flag = 1;
+
+		if (argc < 4)
+			goto usage;
+
+		addr = (ulong)strtoul(argv[2], NULL, 16);
+		aml_nand_msg("AMLNAND %s: ",
