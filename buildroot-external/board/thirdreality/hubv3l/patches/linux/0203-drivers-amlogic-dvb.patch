+#define dprint_i(fmt, args...)   \
+	dprintk(LOG_ERROR, debug_mem_desc, fmt, ## args)
+#define dprint(fmt, args...)     \
+	dprintk(LOG_ERROR, debug_mem_desc, "mem_desc:" fmt, ## args)
