+	case AM_DTV_DEMOD_CXD2878:
+		attch ? (p = aml_dvb_attach(cxd2878_attach, cfg)) :
+				aml_dvb_detach(cxd2878_attach);
+		break;
+	default:
+		p = NULL;
+		break;
+	}
+
+	return p;
