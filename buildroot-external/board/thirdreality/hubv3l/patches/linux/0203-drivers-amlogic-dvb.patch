+	n += sprintf(buff + n, "\tDVBS         : 5\n");
+	n += sprintf(buff + n, "\tDVBS2        : 6\n");
+	n += sprintf(buff + n, "\tDVBH         : 7\n");
+	n += sprintf(buff + n, "\tISDBT        : 8\n");
+	n += sprintf(buff + n, "\tISDBS        : 9\n");
+	n += sprintf(buff + n, "\tISDBC        : 10\n");
