+static irqreturn_t aucpu_irq_handler(s32 irq, void *dev_id)
+{
+	struct aucpu_ctx_t *dev = (struct aucpu_ctx_t *)dev_id;
+
+	aucpu_pr(LOG_ALL, "Receive an AUCPU interrupt\n");
