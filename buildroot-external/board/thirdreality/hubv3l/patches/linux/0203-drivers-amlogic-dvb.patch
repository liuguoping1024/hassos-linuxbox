+{
+	s32 ret = 0;
+	struct aucpu_ctx_t *dev = (struct aucpu_ctx_t *)filp->private_data;
+
+	aucpu_pr(LOG_ERROR, "IOCTL NO supported, dev %p ret: %d\n", dev, ret);
