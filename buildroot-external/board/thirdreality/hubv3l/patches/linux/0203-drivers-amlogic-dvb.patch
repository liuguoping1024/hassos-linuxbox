+	else if (cpu_type == MESON_CPU_MAJOR_ID_S4)
+		total = sprintf(buf, "s4-%x\n", minor_type);
+	else if (cpu_type == MESON_CPU_MAJOR_ID_S4D)
+		total = sprintf(buf, "s4d-%x\n", minor_type);
+	else if (cpu_type == MESON_CPU_MAJOR_ID_T3)
