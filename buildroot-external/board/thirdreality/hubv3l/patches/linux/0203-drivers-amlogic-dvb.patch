+	pr_err("[%s] ts_clk: %d, ts_clk_pol: %d (0:Negative, 1:Positive).\n",
+			title, cfg->ts_clk, cfg->ts_clk_pol);
+	pr_err("[%s] reset pin: %d, dir: %d, value: %d.\n",
