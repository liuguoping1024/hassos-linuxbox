+	for (i = 0; i < 4; i++) {
+		value = 0;
+		base = 0;
+		if (print_stc) {
+			ret = dmx_get_stc(&dvb->dmx[print_dmx].dmx, i,
+				&value, &base);
+			if (ret != 0)
+				continue;
+			r = sprintf(buf, "dmx:%d num%d stc:0x%llx base:%d\n",
+				print_dmx, i, value, base);
+		} else {
+			ret = dmx_get_pcr(&dvb->dmx[print_dmx].dmx, i, &value);
+			if (ret != 0)
+				continue;
+			r = sprintf(buf, "dmx:%d num%d pcr:0x%llx\n",
+				print_dmx, i, value);
+		}
+
+		buf += r;
+		total += r;
+	}
+
+	return total;
+}
