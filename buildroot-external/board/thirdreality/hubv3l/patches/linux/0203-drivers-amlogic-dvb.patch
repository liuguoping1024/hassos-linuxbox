+	} else {
+		pr_err("[%s] ts_header_bytes: %d.\n", title, cfg->ts_header_bytes);
+		for (i = 0; i < cfg->ts_header_bytes; ++i)
+			pr_err("[%s] ts_header_data: 0x%x.\n",
