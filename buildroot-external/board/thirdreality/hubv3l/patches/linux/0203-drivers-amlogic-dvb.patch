+
+	for (i = 0; i < demux->ts_feed_num; i++)
+		if (demux->ts_feed[i].state == DMX_STATE_FREE)
+			break;
+
+	if (i == demux->ts_feed_num)
+		return NULL;
+
+	demux->ts_feed[i].state = DMX_STATE_ALLOCATED;
+
+	return &demux->ts_feed[i];
+}
