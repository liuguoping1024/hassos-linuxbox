+void tso_set(int path)
+{
+	unsigned int data;
+
+	data = READ_CBUS_REG(DEMOD_TS_O_PATH_CTRL);
+	switch (path) {
+	case 0:
+		//ts0
+		data &= ~(0xF);
+		break;
+	case 1:
+		//ts1
+		data &= ~(0xF);
+		data |= 1;
+		break;
+	case 2:
+		//ts2
+		data &= ~(0xF);
+		data |= 2;
+		break;
+	default:
+		//ts2
+		data &= ~(0xF);
+		data |= 2;
+		break;
+	}
+
+	WRITE_CBUS_REG(DEMOD_TS_O_PATH_CTRL, data);
+	pr_dbg("%s data:0x%0x\n", __func__, data);
+}
