+void wdma_irq(u8 chan_id, int enable)
+{
+	unsigned int data;
+	unsigned int offset = chan_id / 32 * 4;
+
+	data = READ_CBUS_REG(TS_DMA_WCH_INT_MASK + offset);
+
+	if (enable)
+		data |= (1 << (chan_id % 32));
+	else
+		data &= (~(1 << (chan_id % 32)));
