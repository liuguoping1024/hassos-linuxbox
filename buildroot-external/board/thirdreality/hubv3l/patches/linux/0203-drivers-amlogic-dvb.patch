+static int _dmx_remove_frontend(struct dmx_demux *dmx,
+				struct dmx_frontend *frontend)
+{
+	struct aml_dmx *demux = (struct aml_dmx *)dmx->priv;
+	struct list_head *pos, *n, *head = &demux->frontend_list;
