+	}
+	if (!p) {
+		dprint_i("mem_start fail\n");
+		return;
+	}
+	//detect packet alignm
+	for (n = 0; n < detect_len / 188; n++) {
+		if (p[n * 188] != 0x47) {
+			dprint_i("packet not alignm at %d,header:0x%0x\n",
+				n * 188, p[n * 188]);
+			break;
+		}
+	}
+}
