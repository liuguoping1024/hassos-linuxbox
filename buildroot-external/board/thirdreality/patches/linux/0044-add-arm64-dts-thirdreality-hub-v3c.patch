From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: "guoping.liu" <guoping.liu@3reality.com>
Date: Sun, 27 Sep 2026 10:00:00 +0800
Subject: [PATCH] add arm64 dts ThirdReality linuxbox hub-v3c

V3C is the earliest LinuxBox hardware revision, predating the hub-v3
production board:
- Single 2GB DDR3 chip (hub-v3/v3b use 1x2GB too, so RAM node is unchanged)
- 32GB eMMC (MTFC32GAZAQHD-IT) instead of the 8GB used on hub-v3/v3b
- Own PCB, some pins differ from hub-v3 - this initial DTS is copied from
  hub-v3b as a starting skeleton (WiFi/BT/UART pinout not yet re-verified
  against the V3C schematic (Sch_HubV3MB0.3.PDF); expect follow-up fixes
  once hardware is available for bring-up)
- Zigbee + Thread supported, same as hub-v3/v3b

---
 arch/arm64/boot/dts/amlogic/Makefile              |  1 +
 .../amlogic/meson-axg-thirdreality-hub-v3c.dts    | 93 ++++++++++++++++++++++
 2 files changed, 94 insertions(+)
 create mode 100644 arch/arm64/boot/dts/amlogic/meson-axg-thirdreality-hub-v3c.dts

diff --git a/arch/arm64/boot/dts/amlogic/Makefile b/arch/arm64/boot/dts/amlogic/Makefile
--- a/arch/arm64/boot/dts/amlogic/Makefile
+++ b/arch/arm64/boot/dts/amlogic/Makefile
@@ -8,6 +8,7 @@
 dtb-$(CONFIG_ARCH_MESON) += meson-axg-jethome-jethub-j110-rev-3.dtb
 dtb-$(CONFIG_ARCH_MESON) += meson-axg-thirdreality-hub-v3.dtb
 dtb-$(CONFIG_ARCH_MESON) += meson-axg-thirdreality-hub-v3b.dtb
+dtb-$(CONFIG_ARCH_MESON) += meson-axg-thirdreality-hub-v3c.dtb
 # dtb-$(CONFIG_ARCH_MESON) += meson-axg-s400.dtb
 # dtb-$(CONFIG_ARCH_MESON) += meson-g12a-radxa-zero.dtb
 # dtb-$(CONFIG_ARCH_MESON) += meson-g12a-sei510.dtb
diff --git a/arch/arm64/boot/dts/amlogic/meson-axg-thirdreality-hub-v3c.dts b/arch/arm64/boot/dts/amlogic/meson-axg-thirdreality-hub-v3c.dts
new file mode 100644
--- /dev/null
+++ b/arch/arm64/boot/dts/amlogic/meson-axg-thirdreality-hub-v3c.dts
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (c) 2022 Vyacheslav Bocharov <adeep@lexina.in>
+ * Copyright (c) 2022 JetHome
+ * Author: Vyacheslav Bocharov <adeep@lexina.in>
+ */
+
+/dts-v1/;
+
+#include "meson-axg-jethome-jethub-j1xx.dtsi"
+
+/ {
+	compatible = "ThirdReality,hub-v3c", "amlogic,a113d", "amlogic,meson-axg";
+	model = "ThirdReality Linuxbox Hub-v3c";
+
+
+	/* 2048MB RAM (single 2GB DDR3 chip) */
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x0 0x0 0x80000000>;
+	};
+
+	/* Amlogic Bluetooth controller */
+	aml_bt: aml_bt {
+		compatible = "amlogic, aml-bt";
+		status = "okay";
+	};
+
+	aml_wifi: aml_wifi {
+		compatible = "amlogic, aml-wifi";
+		status = "okay";
+		irq_trigger_type = "IRQF_TRIGGER_LOW";
+		//dhd_static_buf; /* if use bcm wifi, config dhd_static_buf */
+		//pinctrl-0 = <&pwm_e_pins>;
+		//pinctrl-names = "default";
+		pwm_config = <&wifi_pwm_conf>;
+		//pwm_config = <&sdio_pwrseq>;
+	};
+
+	
+	wifi_pwm_conf:wifi_pwm_conf{
+		pwm_channel1_conf {
+			pwms = <&pwm_AO_cd 0 30541 0>;
+			duty-cycle = <15270>;
+			times = <10>;
+		};
+		
+		pwm_channel2_conf {
+			pwms = <&pwm_AO_cd 2 30500 0>;
+			duty-cycle = <15250>;
+			times = <12>;
+		};
+	};
+};
+
+/* wifi module */
+&sd_emmc_b {
+	broken-cd;/* cd-gpios = <&gpio_ao GPIOAO_3 GPIO_ACTIVE_LOW>;*/
+};
+
+
+&aml_wifi{
+	status = "okay";
+	interrupt-gpios = <&gpio  GPIOX_6  GPIO_ACTIVE_HIGH>;
+	power_on-gpios = <&gpio   GPIOX_7  GPIO_ACTIVE_HIGH>;
+	//power_on_2-gpios= <&gpio  GPIOX_16 GPIO_ACTIVE_HIGH>;
+};
+
+&aml_bt {
+	status = "okay";
+	reset-gpios = <&gpio    GPIOX_21 GPIO_ACTIVE_HIGH>;
+	btwakeup-gpios = <&gpio GPIOZ_6 GPIO_ACTIVE_HIGH>; /* BT_WAKE_HOST: W1 pin50 out -> SoC in; bt_device.c sets input + request_irq */
+	hostwake-gpios = <&gpio GPIOZ_7 GPIO_ACTIVE_HIGH>; /* HOST_WAKE_BT: SoC out -> W1 pin49 in; bt_device.c sets output 1 */
+};
+
+/*
+ * i2c1 and spicc1 come from the JetHub j1xx dtsi, but neither exists on this
+ * board. Per the schematic the pins they would need are wired as UARTs, or
+ * not wired at all:
+ *   GPIOZ_8/GPIOZ_9   = DB_TXD1/DB_RXD1 -> uart_AO_B (ttyAML3, Zigbee)
+ *   GPIOX_16/GPIOX_17 = DB_TXD2/DB_RXD2 -> uart_B    (ttyAML6, Thread)
+ *   GPIOX_18/GPIOX_19 = not connected (SPI1 MISO/CLK would need these)
+ * There is consequently no pcf8563 RTC on the i2c1 bus. Disable both nodes so
+ * they stop losing a pinctrl fight against the UARTs on every boot.
+ * TODO: re-verify against Sch_HubV3MB0.3.PDF once V3C hardware is available.
+ */
+&i2c1 {
+	status = "disabled";
+};
+
+&spicc1 {
+	status = "disabled";
+};
-- 
