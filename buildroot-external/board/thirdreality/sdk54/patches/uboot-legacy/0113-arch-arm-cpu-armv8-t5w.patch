+	dev_offset = TOP_DWC_BASE_OFFSET +
+		HDMIRX_DWC_BASE_OFFSET;
+	if ((addr >= TOP_EDID_ADDR_S) &&
+		(addr <= TOP_EDID_PORT3_ADDR_E)) {
+		rx_wr_reg_b(dev_offset + addr, (unsigned char)data);
+	} else {
+		rx_wr_reg(dev_offset + (addr << 2), data);
+	}
+}
