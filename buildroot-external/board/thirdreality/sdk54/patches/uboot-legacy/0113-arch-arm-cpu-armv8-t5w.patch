+		printf("TCON pll lock OK! - %4d MHz.Div%4d  - %4d MHz. ", pll_clk, od * 15, pll_clk / od / 15);
+		/* get tcon_pll_clk */
+		clk_msr_val = clk_util_clk_msr(55);
+		printf("CLKMSR(55) - %4d MHz ", clk_msr_val);
+		if (clk_around(clk_msr_val, pll_clk / od / 15)) {
