+static int clk_around(unsigned int clk, unsigned int cmp)
+{
+	if (cmp == 1)
+		cmp += 1;
+	if (((cmp-2) <= clk) && (clk <= (cmp+2)))
+		return 1;
+	else
+		return 0;
+}
