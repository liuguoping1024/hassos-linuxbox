+	//CLK_GATE_OFF(ROM_CLK);
+
+*/
+	/*************************/
+	CLK_GATE_OFF(AHB_ARB0);
+	CLK_GATE_OFF(ASYNC_FIFO);
+	CLK_GATE_OFF(STREAM);
+	CLK_GATE_OFF(RANDOM_NUM_GEN);
