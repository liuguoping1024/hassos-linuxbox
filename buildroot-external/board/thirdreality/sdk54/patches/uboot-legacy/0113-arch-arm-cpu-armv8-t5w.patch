+static int hdmitx_read_edid(unsigned char *buf, unsigned char addr,
+	unsigned char blk_no)
+{
+	ddc_init();
+	return read_edid_8bytes(buf, (addr + blk_no * 128) & 0xff, blk_no);
+}
