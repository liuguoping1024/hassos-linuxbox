+	hd_set_reg_bits(P_HHI_VID_CLK_DIV, div, 24, 4);
+	hd_set_reg_bits(P_HHI_VID_CLK_CNTL2, 1, 2, 1);   //enable gate
+	hd_set_reg_bits(P_HHI_VID_CLK_CNTL, 1, 19, 1);
+}
