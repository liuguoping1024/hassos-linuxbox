+int clear_pinmux(unsigned int pin)
+{
+	struct pin_mux_desc *pmux_desc = &pin_to_gpio[pin];
+
+	regmap_update_bits(domain[pmux_desc->domain] + (pmux_desc->reg << 2),
+			0xf << (pmux_desc->bit), 0 << (pmux_desc->bit));
+
+	return 0;
