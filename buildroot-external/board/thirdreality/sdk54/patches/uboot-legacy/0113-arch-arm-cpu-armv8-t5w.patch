+
+#ifndef _HDMIRX_H
+#define _HDMIRX_H
+
+enum port_sts {
+	E_PORT0,
+	E_PORT1,
+	E_PORT2,
+	E_PORT3,
+	E_PORT_NUM,
+	E_5V_LOST = 0xfd,
+	E_HPD_RESET = 0xfe,
+	E_INIT = 0xff,
+};
