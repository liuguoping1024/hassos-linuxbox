+            "\0"\
+        "clr_adb_debuggable="\
+            "echo disable adb debug prop;"\
+            "setenv bootargs ${bootargs} android.debuggable=0 android.secure=1;"\
+            "setenv bootargs ${bootargs} console=ttyS9,115200 no_console_suspend;"\
+            "\0"\
+        "adb_setting="\
