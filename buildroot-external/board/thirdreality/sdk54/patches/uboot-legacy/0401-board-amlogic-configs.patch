+                    "setenv bootargs ${bootargs} androidboot.oem.key1=${oemkey};"\
+                "fi;"\
+            "else "\
+                "setenv bootargs ${bootargs} androidboot.serialno=at301${cpu_id};"\
+                "setenv serial at301${cpu_id};"\
+            "fi;"\
