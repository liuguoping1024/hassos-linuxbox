+phys_size_t get_effective_memsize(void)
+{
+	phys_size_t phys_size = (readl(AO_SEC_GP_CFG0) & 0xFFFF0000) << 4;
+
+#if defined(CONFIG_SYS_MEM_TOP_HIDE)
+	phys_size -= CONFIG_SYS_MEM_TOP_HIDE;
+#endif
+
+	return phys_size;
+}
