+struct scpi_opp_entry cpu_dvfs_tbl[] = {
+	DVFS( 100000000,  860),
+	DVFS( 250000000,  860),
+	DVFS( 500000000,  860),
+	DVFS( 667000000,  900),
+	DVFS(1000000000,  940),
+	DVFS(1200000000,  980),
+	DVFS(1296000000, 1000),
