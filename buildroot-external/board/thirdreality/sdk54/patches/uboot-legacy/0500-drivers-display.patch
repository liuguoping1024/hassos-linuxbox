+static void lcd_phy_print(struct lcd_config_s *pconf)
+{
+	struct phy_config_s *phy = pconf->lcd_control.phy_cfg;
+	int i;
+
+	printf("vswing             %u\n"
+		"ext_pullup        %u\n"
+		"vcm               %u\n"
+		"mode              %u\n",
+		phy->vswing,
+		phy->ext_pullup,
+		phy->vcm,
+		phy->mode);
+	for (i = 0; i < phy->lane_num; i++) {
+		printf("lane%d_amp =       %u\n"
+			"lane%d_preem =     %u\n",
+			i, phy->lane[i].amp,
+			i, phy->lane[i].preem);
+	}
+	printf("\n");
+}
