+				   (type == LCD_EXT_CMD_TYPE_CMD3_BIN) ||
+				   (type == LCD_EXT_CMD_TYPE_CMD3_BIN_DATA)) {
+				i2c_addr = ext_config->i2c_addr3;
+				lcd_extern_init_reg_check(i2c_bus,
