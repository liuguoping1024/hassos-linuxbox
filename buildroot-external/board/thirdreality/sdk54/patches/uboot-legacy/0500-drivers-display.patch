+	for (i = 0; i < count; i++) {
+		if (pconf->lcd_basic.h_active == lcd_vmode_info[i].width &&
+		    pconf->lcd_basic.v_active == lcd_vmode_info[i].height) {
+			pconf->output_vmode = i;
+			pconf->std_duration = lcd_vmode_info[i].duration;
+			return 0;
