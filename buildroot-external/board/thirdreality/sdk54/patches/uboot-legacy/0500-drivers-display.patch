+
+		if (pwm_combo1->pwm_port == BL_PWM_VS)
+			sprintf(propname,"%s", bl_pinmux_str[5]);
+		else
+			sprintf(propname,"%s", bl_pinmux_str[3]);
+
+		pinmux = bconf->bl_pinmux;
+		set_cnt = 0;
+		clr_cnt = 0;
+		for (i = 0; i < LCD_PINMX_MAX; i++) {
+			if (pinmux == NULL)
