+static int lcd_extern_reg_write(unsigned char *buf, unsigned int len)
+{
+	int ret = 0;
+
+	if (buf == NULL) {
+		EXTERR("%s: buf is null\n", __func__);
+		return -1;
+	}
+
+	if (!len) {
+		EXTERR("%s: invalid len\n", __func__);
+		return -1;
