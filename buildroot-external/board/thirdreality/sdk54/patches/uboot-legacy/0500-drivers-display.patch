+static int lcd_type_supported(struct lcd_config_s *pconf)
+{
+	int lcd_type = pconf->lcd_basic.lcd_type;
+	int ret = -1;
+
+	switch (lcd_type) {
+	case LCD_LVDS:
+	case LCD_VBYONE:
+	case LCD_MLVDS:
+	case LCD_P2P:
+		ret = 0;
+		break;
+	default:
+		LCDERR("invalid lcd type: %s(%d)\n",
+			lcd_type_type_to_str(lcd_type), lcd_type);
+		break;
+	}
+	return ret;
+}
