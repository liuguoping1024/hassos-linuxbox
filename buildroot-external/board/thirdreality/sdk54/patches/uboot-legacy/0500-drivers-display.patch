+	osd_setup_hw(index,
+		     xoffset,
+		     yoffset,
+		     xres,
+		     yres,
+		     xres_virtual ,
+		     yres_virtual,
+		     disp_start_x,
+		     disp_start_y,
+		     disp_end_x,
+		     disp_end_y,
+		     fbmem,
+		     color);
