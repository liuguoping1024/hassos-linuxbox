+static int check_lcd_output_mode(char *mode, unsigned int frac)
+{
+	if (frac) {
+		LCDERR("don't support frac\n");
+		return -1;
+	}
+
+	if (strcmp(mode, "panel") != 0) {
+		LCDERR("outputmode[%s] is not support\n", mode);
+		return -1;
+	}
+
+	return 0;
+}
