+
+#include <common.h>
+#include <malloc.h>
+#include <asm/arch/gpio.h>
+#ifdef CONFIG_OF_LIBFDT
+#include <libfdt.h>
+#endif
+#include <amlogic/aml_lcd.h>
+#include <amlogic/aml_lcd_extern.h>
