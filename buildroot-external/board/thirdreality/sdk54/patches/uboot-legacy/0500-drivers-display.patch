+				LCDPR("bl: pwm_combo1_freq     = %d x vfreq\n", bl_pwm->pwm_freq);
+				LCDPR("bl: pwm_combo1_cnt      = %u\n", bl_pwm->pwm_cnt);
+				if (bl_pwm->pwm_duty_max > 100)
+					LCDPR("bl:pwm_combo1_duty = %d%% %d\n",
+					      bl_pwm->pwm_duty * 100 / bl_pwm->pwm_duty_max,
+					      bl_pwm->pwm_duty);
+				else
+					LCDPR("bl:pwm_combo1_duty = %d%% %d\n",
+					      bl_pwm->pwm_duty,
+					      bl_pwm->pwm_duty);
