+					pwm_combo0->pinmux_set[i][1] = be32_to_cpup((((u32*)propdata)+2*i+1));
+				}
+				if (temp < (LCD_PINMUX_NUM - 1)) {
+					pwm_combo0->pinmux_set[temp][0] = LCD_PINMUX_END;
+					pwm_combo0->pinmux_set[temp][1] = 0x0;
