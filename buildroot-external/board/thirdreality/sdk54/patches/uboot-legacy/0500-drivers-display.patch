+static int ldim_power_cmd_dynamic_size(void)
+{
+	unsigned char *table;
+	int i = 0, j, step = 0, max_len = 0;
+	unsigned char type, cmd_size;
+	int delay_ms, ret = 0;
+
+	table = bl_iw7027_he->init_data;
+	max_len = bl_iw7027_he->init_data_cnt;
+
+	while ((i + 1) < max_len) {
+		type = table[i];
+		if (type == LCD_EXT_CMD_TYPE_END)
+			break;
+		if (lcd_debug_print_flag) {
+			LDIMPR("%s: step %d: type=0x%02x, cmd_size=%d\n",
+				__func__, step, type, table[i+1]);
+		}
+		cmd_size = table[i+1];
+		if (cmd_size == 0)
+			goto power_cmd_dynamic_next;
+		if ((i + 2 + cmd_size) > max_len)
+			break;
+
+		if (type == LCD_EXT_CMD_TYPE_NONE) {
+			/* do nothing */
+		} else if (type == LCD_EXT_CMD_TYPE_DELAY) {
+			delay_ms = 0;
+			for (j = 0; j < cmd_size; j++)
+				delay_ms += table[i+2+j];
+			if (delay_ms > 0)
+				mdelay(delay_ms);
+		} else if (type == LCD_EXT_CMD_TYPE_CMD) {
+			ret = iw7027_he_wreg(bl_iw7027_he->spi,
+				table[i+2], table[i+3]);
+			udelay(1);
+		} else if (type == LCD_EXT_CMD_TYPE_CMD_DELAY) {
+			ret = iw7027_he_wreg(bl_iw7027_he->spi,
+				table[i+2], table[i+3]);
+			udelay(1);
+			if (table[i+4] > 0)
+				mdelay(table[i+4]);
+		} else {
+			LDIMERR("%s: type 0x%02x invalid\n", __func__, type);
+		}
+power_cmd_dynamic_next:
+		i += (cmd_size + 2);
+		step++;
+	}
+
+	return ret;
+}
+
+static int ldim_power_cmd_fixed_size(void)
+{
+	unsigned char *table;
+	int i = 0, j, step = 0, max_len = 0;
+	unsigned char type, cmd_size;
+	int delay_ms, ret = 0;
+
+	cmd_size = bl_iw7027_he->cmd_size;
+	if (cmd_size < 2) {
+		LDIMERR("%s: invalid cmd_size %d\n", __func__, cmd_size);
+		return -1;
+	}
+
+	table = bl_iw7027_he->init_data;
+	max_len = bl_iw7027_he->init_data_cnt;
+
+	while ((i + cmd_size) <= max_len) {
+		type = table[i];
+		if (type == LCD_EXT_CMD_TYPE_END)
+			break;
+		if (lcd_debug_print_flag) {
+			LDIMPR("%s: step %d: type=0x%02x, cmd_size=%d\n",
+				__func__, step, type, cmd_size);
+		}
+		if (type == LCD_EXT_CMD_TYPE_NONE) {
+			/* do nothing */
+		} else if (type == LCD_EXT_CMD_TYPE_DELAY) {
+			delay_ms = 0;
+			for (j = 0; j < (cmd_size - 1); j++)
+				delay_ms += table[i+1+j];
+			if (delay_ms > 0)
+				mdelay(delay_ms);
+		} else if (type == LCD_EXT_CMD_TYPE_CMD) {
+			ret = iw7027_he_wreg(bl_iw7027_he->spi,
+				table[i+1], table[i+2]);
+			udelay(1);
+		} else if (type == LCD_EXT_CMD_TYPE_CMD_DELAY) {
+			ret = iw7027_he_wreg(bl_iw7027_he->spi,
+				table[i+1], table[i+2]);
+			udelay(1);
+			if (table[i+3] > 0)
+				mdelay(table[i+3]);
+		} else {
+			LDIMERR("%s: type 0x%02x invalid\n", __func__, type);
+		}
+		i += cmd_size;
+		step++;
+	}
+
+	return ret;
+}
+
+static int iw7027_he_power_on_init(void)
+{
+	unsigned char cmd_size;
+	int ret = 0;
+
+	cmd_size = bl_iw7027_he->cmd_size;
+	if (cmd_size < 2) {
+		LDIMERR("%s: invalid cmd_size %d\n", __func__, cmd_size);
+		return -1;
+	}
+	if (cmd_size == LCD_EXT_CMD_SIZE_DYNAMIC)
+		ret = ldim_power_cmd_dynamic_size();
+	else
+		ret = ldim_power_cmd_fixed_size();
+
+	return ret;
+}
+
+static int iw7027_he_hw_init_on(void)
+{
+	int i;
+	unsigned char reg_duty_chk = 0;
+	unsigned char reg_chk = 0, done = 0;
+	unsigned int device_count;
+	unsigned int spi_device_id;
+	struct aml_ldim_driver_s *ldim_drv = aml_ldim_get_driver();
+
+	/* step 1: system power_on */
+	LDIMPR("%s: iw7027 system power_on\n", __func__);
+	ldim_set_gpio(ldim_drv->ldev_conf->en_gpio,
+		      ldim_drv->ldev_conf->en_gpio_on);
+	ldim_set_duty_pwm(&(ldim_drv->ldev_conf->ldim_pwm_config));
+	ldim_set_duty_pwm(&(ldim_drv->ldev_conf->analog_pwm_config));
+
+	/* step 2: delay for internal logic stable */
+	mdelay(10);
+
+	/* step 3: SPI communication check */
+	LDIMPR("%s: SPI Communication Check\n", __func__);
+	device_count = ldim_drv->ldev_conf->device_count;
+	for (spi_device_id = 0; spi_device_id < device_count;
+	     spi_device_id++) {
+		iw7027_he_wreg(bl_iw7027_he->spi, spi_device_id, 0x06);
+		for (i = 0; i <= 10; i++) {
+			reg_chk = 0;
+			iw7027_he_rreg(bl_iw7027_he->spi, spi_device_id,
+				       0x00, &reg_chk);
+			if (reg_chk == 0x06)
+				break;
+			if (i == 10) {
+				LDIMERR
+				("%s: SPI communication check dev error\n",
+				__func__);
+			}
+		}
+	}
+
+	/* step 4: configure initial registers */
+	LDIMPR("%s: Write initial control registers\n", __func__);
+	iw7027_he_power_on_init();
+
+	/* step 5: supply stable vsync */
+	LDIMPR("%s: open Vsync\n", __func__);
+	ldim_drv->pinmux_ctrl(1);
+
+	/* step 6: delay for system clock and light bar PSU stable */
+	mdelay(550);
+
+	/* step 7: start calibration */
+	LDIMPR("%s: start calibration\n", __func__);
+	iw7027_he_wreg(bl_iw7027_he->spi, 0x00, 0x07);
+	mdelay(200);
+
+	/* step 8: calibration done or not */
+	i = 0;
+	while (++i < 100) {
+		for (spi_device_id = 0; spi_device_id < device_count;
+		     spi_device_id++) {
+			iw7027_he_rreg(bl_iw7027_he->spi, spi_device_id, 0xb3,
+				       &reg_duty_chk);
+			/*VDAC statue reg :FB1=[0x5] FB2=[0x50]*/
+			/*The current platform using FB1*/
+			if ((reg_duty_chk & 0xf) == 0x05) {
+				done = 1;
+				break;
+			}
+			mdelay(10);
+		}
+	}
+
+	LDIMPR("%s: calibration %s: [%d] = %x\n",
+	       __func__, (done ? "OK" : "fail"), i, reg_duty_chk);
+
+	return 0;
+}
+
+static int iw7027_he_hw_init_off(void)
+{
+	struct aml_ldim_driver_s *ldim_drv = aml_ldim_get_driver();
+
+	ldim_drv->pinmux_ctrl(0);
+	ldim_set_gpio(ldim_drv->ldev_conf->en_gpio,
+		      ldim_drv->ldev_conf->en_gpio_off);
+
+	return 0;
+}
+
+static unsigned int dim_max, dim_min;
+static unsigned int iw7027_he_get_value(unsigned int level)
+{
+	unsigned int val;
+
+	val = dim_min + ((level * (dim_max - dim_min)) / LD_DATA_MAX);
+
+	return val;
+}
+
+static int iw7027_he_smr(unsigned short *buf, unsigned char len)
+{
+	unsigned int i, temp;
+	unsigned short num;
+	struct aml_ldim_driver_s *ldim_drv = aml_ldim_get_driver();
+
+	if (iw7027_he_on_flag == 0) {
+		LDIMPR("%s: on_flag=%d\n", __func__, iw7027_he_on_flag);
+		return 0;
+	}
+	num = ldim_drv->ldev_conf->bl_regnum;
+	if (len != num) {
+		LDIMERR("%s: data len %d invalid\n", __func__, len);
+		return -1;
+	}
+
+	if (val_brightness == NULL) {
+		LDIMERR("%s: val_brightness is null\n", __func__);
+		return -1;
+	}
+
+	dim_max = ldim_drv->ldev_conf->dim_max;
+	dim_min = ldim_drv->ldev_conf->dim_min;
+
+	for (i = 0; i < num; i++) {
+		temp = iw7027_he_get_value(buf[i]);
+		val_brightness[BRIGHTNESS_OFFSET+2*i] = (temp >> 8) & 0xf;
+		val_brightness[BRIGHTNESS_OFFSET+2*i+1] = temp & 0xff;
+	}
+
+	iw7027_he_wreg_MultipleByte(bl_iw7027_he->spi, 0x40,
+				    val_brightness, (num * 2));
+
+	return 0;
+}
+
+static int iw7027_he_power_on(void)
+{
+	iw7027_he_hw_init_on();
+	iw7027_he_on_flag = 1;
+
+	LDIMPR("%s: ok\n", __func__);
+	return 0;
+}
+
+static int iw7027_he_power_off(void)
+{
+	iw7027_he_on_flag = 0;
+	iw7027_he_hw_init_off();
+
+	LDIMPR("%s: ok\n", __func__);
+	return 0;
+}
+
+static int iw7027_he_ldim_driver_update(struct aml_ldim_driver_s *ldim_drv)
+{
+	ldim_drv->device_power_on = iw7027_he_power_on;
+	ldim_drv->device_power_off = iw7027_he_power_off;
+	ldim_drv->device_bri_update = iw7027_he_smr;
+	return 0;
+}
+
+int ldim_dev_iw7027_he_probe(struct aml_ldim_driver_s *ldim_drv)
+{
+	if (ldim_drv->spi_info->spi == NULL) {
+		LDIMERR("%s: spi is null\n", __func__);
+		return -1;
+	}
+
+	bl_iw7027_he = (struct iw7027_he *)malloc(sizeof(struct iw7027_he));
+	if (bl_iw7027_he == NULL) {
+		LDIMERR("iw7027_he malloc error\n");
+		return -1;
+	}
+	memset(bl_iw7027_he, 0, sizeof(struct iw7027_he));
+
+	iw7027_he_on_flag = 0;
+
+	bl_iw7027_he->spi = ldim_drv->spi_info->spi;
+	bl_iw7027_he->cs_hold_delay = ldim_drv->ldev_conf->cs_hold_delay;
+	bl_iw7027_he->cs_clk_delay = ldim_drv->ldev_conf->cs_clk_delay;
+	bl_iw7027_he->cmd_size = ldim_drv->ldev_conf->cmd_size;
+	bl_iw7027_he->init_data = ldim_drv->ldev_conf->init_on;
+	bl_iw7027_he->init_data_cnt = ldim_drv->ldev_conf->init_on_cnt;
+
+	val_brightness = (unsigned char *)malloc(
+		(ldim_drv->ldev_conf->bl_regnum * 2) + 4);
+	if (val_brightness == NULL) {
+		LDIMERR("malloc val_brightness failed\n");
+		free(bl_iw7027_he);
+		return -1;
+	}
+
+	iw7027_he_ldim_driver_update(ldim_drv);
+
+	printf("%s: ok\n", __func__);
+
+	return 0;
+}
+
+int ldim_dev_iw7027_he_remove(struct aml_ldim_driver_s *ldim_drv)
+{
+	if (val_brightness) {
+		free(val_brightness);
+		val_brightness = NULL;
+	}
+
+	if (bl_iw7027_he) {
+		free(bl_iw7027_he);
+		bl_iw7027_he = NULL;
+	}
+	return 0;
+}
+
diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=.mailmap' '--exclude=*.o' '--exclude=*.a' '--exclude=*.pyc' '--exclude=aml-user-key.sig' '--exclude=aml-user-key-v3.sig' '--exclude=aml-key' a/drivers/display/lcd/aml_ldim/iw7038.c b/drivers/display/lcd/aml_ldim/iw7038.c
