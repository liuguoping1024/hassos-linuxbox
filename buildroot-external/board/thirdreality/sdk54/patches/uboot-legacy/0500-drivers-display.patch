+#define LDIM_PINMUX_MAX    4
+static char *ldim_pinmux_str[LDIM_PINMUX_MAX] = {
+	"ldim_pwm_pin",        /* 0 */
+	"ldim_pwm_vs_pin",     /* 1 */
+	"analog_pwm_pin",      /* 2 */
+	"none",
+};
