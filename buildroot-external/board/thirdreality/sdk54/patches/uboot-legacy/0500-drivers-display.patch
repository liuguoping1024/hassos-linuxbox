+		lcd_vcbus_setb(VBO_FSM_HOLDER_H, 0xffff, 0, 16);
+	} else {
+		mdelay(vx1_conf->cdr_training_hold);
+		lcd_vcbus_setb(VBO_FSM_HOLDER_H, 0, 0, 16);
