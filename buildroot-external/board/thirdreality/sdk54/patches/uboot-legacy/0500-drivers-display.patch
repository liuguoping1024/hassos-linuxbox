+static unsigned long my_hex_atol(const char *str)
+{
+	unsigned long result = 0;
+	char p1;
+	char p2;
+	const char *p = str;
+
+	if (str) {
+		//remove ”0x“
+		p1 = *str;
+		p2 = *(++str);
+		if (p1 == '0' && (p2 == 'x' || p2 == 'X')) {
+			p += 2;
+		}
+		while (*p) {
+			if (*p >= '0' && *p <= '9')
+				result = result * 16 + (*p++ -'0');
+			else if (*p >= 'a' && *p <= 'f')
+				result = result * 16 + (*p++ -'a' + 10);
+			else if (*p >= 'A' && *p <= 'F')
+				result = result * 16 + (*p++ -'A' + 10);
+			else {
+				printf("invalid character!\n");
+				return 0;
+			}
+		}
+	}
+
+	return result;
+}
