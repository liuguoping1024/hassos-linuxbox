+	HHI_HDMI_PLL_CNTL2,
+	HHI_HDMI_PLL_CNTL3,
+	HHI_HDMI_PLL_CNTL4,
+	HHI_HDMI_PLL_CNTL5,
+#if (defined(CONFIG_CHIP_AML_GXB) || \
+		defined(CONFIG_AML_MESON_GXTVBB) || \
