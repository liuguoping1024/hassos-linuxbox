+
+	ret = aml_lcd_extern_i2c_write(ext_config->i2c_bus,
+				       ext_config->i2c_addr,
+				       buf, len);
+	if (ret)
+		EXTERR("%s: faild\n", __func__);
+
+	return ret;
+}
