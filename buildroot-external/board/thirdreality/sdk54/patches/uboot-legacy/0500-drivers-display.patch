+		for (xd = 1; xd <= cConf->xd_max; xd++) {
+			pll_fout = cConf->fout * xd;
+			if ((pll_fout > dsi_bit_rate_max) ||
+				(pll_fout < dsi_bit_rate_min)) {
+				continue;
