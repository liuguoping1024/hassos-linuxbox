+int aml_lcd_extern_gpio_get(unsigned char index)
+{
+	int gpio;
+	char *str;
+
+	if (lcd_ext_driver == NULL) {
+		EXTERR("no lcd_extern driver\n");
+		return LCD_GPIO_MAX;
+	}
+
+	if (index >= LCD_EXTERN_GPIO_NUM_MAX) {
+		return LCD_GPIO_MAX;
+	}
