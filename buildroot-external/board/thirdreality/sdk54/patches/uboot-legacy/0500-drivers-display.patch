+/* iw7027 register read */
+static int iw7027_he_rreg(struct spi_slave *spi, unsigned char DevAddr,
+			  unsigned char addr,
+			  unsigned char *val)
+{
+	unsigned char tbuf[4], rbuf[4], temp;
+	int ret, i;
+
+	/*set read flag*/
+	temp = (addr >= 0x80) ? 0x80 : 0x0;
+	iw7027_he_wreg(spi, 0x78, temp);
+
+	tbuf[0] = DevAddr | 0x40;
+	tbuf[1] = addr | 0x80;
+	tbuf[2] = 0;
+	for (i = 0; i < 2; i++)
+		tbuf[i+2] = 0x00;
+	ret = ldim_spi_read(spi, tbuf, 4, rbuf, 1);
+	*val = rbuf[3];
+
+	return ret;
+}
