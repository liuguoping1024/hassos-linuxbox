+	if (lcd_prbs_mode == LCD_PRBS_MODE_VX1) {
+		lcd_hiu_setb(reg_vid2_clk_ctrl, 0, VCLK2_EN, 1);
+		lcd_prbs_set_pll_vx1_tl1();
+	} else if (lcd_prbs_mode == LCD_PRBS_MODE_LVDS) {
+		lcd_hiu_setb(reg_vid2_clk_ctrl, 0, VCLK2_EN, 1);
+		lcd_prbs_set_pll_lvds_tl1();
