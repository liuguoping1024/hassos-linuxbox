+static void lcd_backlight_enable(void)
+{
+	struct aml_lcd_drv_s *lcd_drv = aml_lcd_get_driver();
+
+	aml_bl_pwm_config_update(lcd_drv->bl_config);
+	aml_bl_set_level(lcd_drv->bl_config->level_default);
+	aml_bl_power_ctrl(1, 1);
+}
