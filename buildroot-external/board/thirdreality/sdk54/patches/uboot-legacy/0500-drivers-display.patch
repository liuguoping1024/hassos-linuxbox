+	lcd_hiu_setb(HHI_HDMI_PLL_CNTL0, 0, LCD_PLL_RST_HPLL_G12A, 1);
+
+	ret = lcd_pll_wait_lock_g12a(0);
+	if (ret) {
+		if (cnt++ < PLL_RETRY_MAX)
+			goto set_hpll_pll_retry_g12a;
+		LCDERR("hpll lock failed\n");
+	}
