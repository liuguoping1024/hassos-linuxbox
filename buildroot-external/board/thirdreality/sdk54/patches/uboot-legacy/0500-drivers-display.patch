+		if (osd_log_level >= OSD_LOG_LEVEL_DEBUG2) { \
+			printf(OSD_LOG_TAG fmt, ##__VA_ARGS__); \
+		} \
+	} while (0)
+
+#define osd_logd3(fmt, ...) \
+	do { \
+		if (osd_log_level >= OSD_LOG_LEVEL_DEBUG3) { \
+			printf(OSD_LOG_TAG fmt, ##__VA_ARGS__); \
+		} \
+	} while (0)
+
+#endif
