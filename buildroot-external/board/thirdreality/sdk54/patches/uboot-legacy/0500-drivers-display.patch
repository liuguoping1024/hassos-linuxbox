+void osd_set_color_key_hw(u32 index, u32 color_index, u32 colorkey)
+{
+	u8 r = 0, g = 0, b = 0, a = (colorkey & 0xff000000) >> 24;
+	u32 data32;
+	colorkey &= 0x00ffffff;
+	switch (color_index) {
+	case COLOR_INDEX_16_655:
+		r = (colorkey >> 10 & 0x3f) << 2;
+		g = (colorkey >> 5 & 0x1f) << 3;
+		b = (colorkey & 0x1f) << 3;
+		break;
+	case COLOR_INDEX_16_844:
+		r = colorkey >> 8 & 0xff;
+		g = (colorkey >> 4 & 0xf) << 4;
+		b = (colorkey & 0xf) << 4;
+		break;
+	case COLOR_INDEX_16_565:
+		r = (colorkey >> 11 & 0x1f) << 3;
+		g = (colorkey >> 5 & 0x3f) << 2;
+		b = (colorkey & 0x1f) << 3;
+		break;
+	case COLOR_INDEX_24_888_B:
+		b = colorkey >> 16 & 0xff;
+		g = colorkey >> 8 & 0xff;
+		r = colorkey & 0xff;
+		break;
+	case COLOR_INDEX_24_RGB:
+	case COLOR_INDEX_YUV_422:
+		r = colorkey >> 16 & 0xff;
+		g = colorkey >> 8 & 0xff;
+		b = colorkey & 0xff;
+		break;
+	}
+	data32 = r << 24 | g << 16 | b << 8 | a;
+	if (osd_hw.color_key[index] != data32) {
+		osd_hw.color_key[index] = data32;
+		osd_logd2("bpp:%d--r:0x%x g:0x%x b:0x%x ,a:0x%x\n",
+			  color_index, r, g, b, a);
+		add_to_update_list(index, OSD_COLOR_KEY);
+		osd_wait_vsync_hw();
+	}
+	return;
+}
