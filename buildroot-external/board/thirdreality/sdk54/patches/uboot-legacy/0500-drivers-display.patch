+	DT_RESP_GEN_READ_1     = 0x11,
+	DT_RESP_GEN_READ_2     = 0x12,
+	DT_RESP_GEN_READ_LONG  = 0x1a,
+	DT_RESP_DCS_READ_LONG  = 0x1c,
+	DT_RESP_DCS_READ_1     = 0x21,
+	DT_RESP_DCS_READ_2     = 0x22,
