+	check_flag = 0;
+	chk_table = malloc(data_len * sizeof(unsigned char));
+	if (!chk_table)
+		goto parameter_err0;
+	memset(chk_table, 0, data_len);
+	ret = aml_lcd_extern_i2c_read(i2c_bus, i2c_addr, chk_table,
