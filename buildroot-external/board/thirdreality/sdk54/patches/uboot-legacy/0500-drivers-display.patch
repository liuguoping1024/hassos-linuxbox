+
+	lcd_hiu_setb(HHI_VID_PLL_CLK_DIV, 0, 18, 1);
+	lcd_hiu_setb(HHI_VID_PLL_CLK_DIV, 0, 16, 2);
+	lcd_hiu_setb(HHI_VID_PLL_CLK_DIV, 0, 15, 1);
