+static int my_atoi(const char *str)
+{
+	int result = 0;
+	int signal = 1;
+
+	if ((*str >= '0' && *str <= '9') || *str == '-' || *str == '+') {
+		if (*str == '-' || *str == '+') {
+			if (*str == '-')
+				signal = -1;
+			str++;
+		}
+	} else
+		return 0;
+
+	while (*str >= '0' && *str <= '9')
+		result = result * 10 + (*str++ -'0');
+
+	return signal * result;
+}
+
+static int getenv_int(char *env, int def)
+{
+	if (getenv(env) == NULL)
+		return def;
+	else
+		return my_atoi(getenv(env));
+}
