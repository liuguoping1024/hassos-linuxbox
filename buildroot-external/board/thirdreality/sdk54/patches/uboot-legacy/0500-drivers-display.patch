+				ret = aml_lcd_extern_i2c_write(i2c_bus,
+							       i2c_addr,
+							       &table[i + 2],
+							       size);
+			} else if (type == LCD_EXT_CMD_TYPE_CMD3_BIN2) {
+				i2c_addr = ext_config->i2c_addr3;
+				lcd_extern_init_reg_check2(i2c_bus,
+							   i2c_addr,
