+char* sha256_hex2str(unsigned char* in_sha_hex, char* out_sha_str)
+{
+	int i = 0;
+
+    for (i = 0; i < SHA256_SUM_LEN; ++i) {
+        sprintf(out_sha_str + i * 2, "%.2x", in_sha_hex[i]);
+    }
+    out_sha_str[SHA256_SUM_LEN * 2] = '\0';
