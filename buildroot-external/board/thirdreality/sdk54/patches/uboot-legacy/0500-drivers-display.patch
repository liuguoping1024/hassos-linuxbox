+		i2c_bus = BL_EXTERN_I2C_BUS_3;
+	else if (strncmp(str, "i2c_bus_0", 9) == 0)
+		i2c_bus = BL_EXTERN_I2C_BUS_0;
+	else if (strncmp(str, "i2c_bus_1", 9) == 0)
