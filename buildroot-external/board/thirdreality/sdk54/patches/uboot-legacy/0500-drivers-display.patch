+	/* setting blend scope */
+	osd_reg_write(VPP_OSD1_BLD_H_SCOPE,
+		disp_data->x_start << 16 | disp_data->x_end);
+	osd_reg_write(VPP_OSD1_BLD_V_SCOPE,
+		disp_data->y_start << 16 | disp_data->y_end);
+	osd_reg_write(VPP_OUT_H_V_SIZE,
+			width << 16 | height);
+}
