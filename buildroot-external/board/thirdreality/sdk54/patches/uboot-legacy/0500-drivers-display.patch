+
+#ifndef _GRAPHICS_H_
+#define _GRAPHICS_H_
+
+#include "minui.h"
+extern grsurface *gr_draw;
+
+// TODO: lose the function pointers.
+typedef struct {
+	// Initializes the backend and returns a grsurface* to draw into.
+	grsurface* (*init)(void);
+
+	// Causes the current drawing surface (returned by the most recent
