+		for (i = 0; i < LCD_PINMX_MAX; i++) {
+			if (pinmux == NULL)
+				break;
+			if (pinmux->name == NULL)
+				break;
+			if (strncmp(pinmux->name, "invalid", 7) == 0)
+				break;
+			if (strncmp(pinmux->name, propname, strlen(propname)) == 0) {
+				for (j = 0; j < LCD_PINMUX_NUM; j++ ) {
+					if (pinmux->pinmux_set[j][0] == LCD_PINMUX_END)
+						break;
