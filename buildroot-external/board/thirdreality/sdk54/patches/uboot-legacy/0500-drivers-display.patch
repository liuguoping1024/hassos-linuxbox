+char* md5_hex2str(unsigned char* in_md5_hex, char* out_md5_str)
+{
+	int i = 0;
+
+	for (i = 0; i < MD5_DIGEST_LENGTH; ++i) {
+		sprintf(out_md5_str + i * 2, "%.2x", in_md5_hex[i]);
+	}
+	out_md5_str[MD5_DIGEST_LENGTH * 2] = '\0';
+	return out_md5_str;
+}
