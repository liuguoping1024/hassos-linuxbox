+static unsigned int detect_phyad(void)
+{
+	unsigned int testval = 0;
+	int i;
+	static int s_phyad = -1;
+
+	if (s_phyad != -1) {
+		return s_phyad;
+	}
+	for (i = 0; i < 32; i++) {
+		testval = phy_reg_rd(i, PHY_SR);	//read the SR register..
+		if (testval != 0x0000 && testval != 0xffff) {
+			s_phyad = i;
+			return s_phyad;
+		}
+	}
+	return 0xffff;
+}
