+static void pwm_constant_disable(struct udevice *dev, uint channel)
+{
+	struct meson_pwm_priv *priv = dev_get_priv(dev);
+	struct meson_pwm_reg *regs = priv->regs;
+
+	switch (channel) {
+	case MESON_PWM0:
+	case MESON_PWM2:
+		clrbits_le32(&regs->miscr, 1 << 28);
+		break;
+
+	case MESON_PWM1:
+	case MESON_PWM3:
+		clrbits_le32(&regs->miscr, 1 << 29);
+		break;
+
+	default:
