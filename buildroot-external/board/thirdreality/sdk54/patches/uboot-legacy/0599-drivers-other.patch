+	setbits_le32(&eqos->dma_regs_p->mode,
+		     EQOS_DMA_MODE_SWR);
+
+	ret = -1;
+
+	ret = phy_startup(eqos->phydev);
+	if (ret < 0) {
+		printf("phy_startup() failed: %d", ret);
+		goto err_shutdown_phy;
+	}
+	if (!eqos->phydev->link) {
+		printf("No link");
