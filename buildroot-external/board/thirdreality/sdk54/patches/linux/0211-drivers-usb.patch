+	} else if ((poll_status_flag == 1) && !(portstatus & 0x01)) {
+		dev_info(&dev->dev,
+			 "PORT IS disCONNECT portstatus=0x%04x\n", portstatus);
+		queue_delayed_work(system_wq,
+				   &dev->portstatus_work,
+				   msecs_to_jiffies(1000));
