+		<1010000 4>,
+		<1000000 8>,
+		<990000 11>,
+		<980000 14>,
+		<970000 17>,
+		<960000 20>,
+		<950000 24>,
+		<940000 27>,
+		<930000 31>,
+		<920000 35>,
+		<910000 38>,
+		<900000 42>,
+		<890000 45>,
+		<880000 48>,
+		<870000 52>,
+		<860000 56>,
+		<850000 59>,
+		<840000 63>,
+		<830000 65>,
+		<820000 67>,
+		<810000 70>,
+		<800000 74>,
+		<790000 78>,
+		<780000 80>,
+		<770000 84>,
+		<760000 88>,
