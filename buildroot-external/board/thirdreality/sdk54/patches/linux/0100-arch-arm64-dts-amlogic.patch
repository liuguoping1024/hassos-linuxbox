+	#address-cells = <1>;
+    #size-cells = <0>;
+    pmic2657: pmic@6a {
+		compatible = "rohm,bd2657";
+		reg = <0x6a>;
+		interrupt-parent = <&gpio_intc>;
+		interrupts = <29 IRQ_TYPE_LEVEL_LOW>;
+		interrupt-names = "cpu-irq";
