+
+	sdio_pins: sdio_pins {
+		mux {
+			groups = "sdio_d0",
+				 "sdio_d1",
+				 "sdio_d2",
+				 "sdio_d3",
+				 "sdio_clk",
+				 "sdio_cmd";
+			function = "sdio";
+			bias-pull-up;
+			drive-strength-microamp = <4000>;
