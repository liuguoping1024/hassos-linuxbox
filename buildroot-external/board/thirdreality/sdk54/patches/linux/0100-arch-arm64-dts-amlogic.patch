diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm64/boot/dts/amlogic/t5d_t950x4_am311_1.5g.dts b/arch/arm64/boot/dts/amlogic/t5d_t950x4_am311_1.5g.dts
