diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm64/boot/dts/amlogic/mesonsc2_drm.dtsi b/arch/arm64/boot/dts/amlogic/mesonsc2_drm.dtsi
