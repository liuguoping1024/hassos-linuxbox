+				&clkaudio CLKID_AUDIO_MCLK_PAD1
+				&clkc CLKID_MPLL1>;
+		clock-names = "mclk", "mclk_pad", "clk_srcpll";
+		pinctrl-names = "tdm_pins", "tdmout_a_gpio";
+		pinctrl-0 = <
+			&mclk_1_pins
+			&tdm_b_pins
+			&tdm_d2_pins
+			&tdm_d3_pins
+			&tdm_d4_pins
+			&tdm_d5_pins
+			&tdm_d6_pins
+			&tdm_d7_pins
+			&tdm_d12_pins
+			&tdm_d13_pins
+			&tdmb_clk_pins>;
+		pinctrl-1 = <&tdmout_b_gpio>;
+		start_clk_enable = <1>;
+		tdm5v-supply = <&vcc5v_reg>;
