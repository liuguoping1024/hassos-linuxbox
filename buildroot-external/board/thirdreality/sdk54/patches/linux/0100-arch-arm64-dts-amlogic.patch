diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm64/boot/dts/amlogic/sc2_s905x4_ah219_linux.dts b/arch/arm64/boot/dts/amlogic/sc2_s905x4_ah219_linux.dts
