+		/*fe2_ant_power_gpio = <&gpio GPIOC_1 GPIO_ACTIVE_HIGH>;*/
+		fe2_ts = <1>; /* select tsin port */
+		fe2_ts_out_mode = <1>; /* 0: serial, 1: parallel. */
+
+		fe3_demod = "MXL258C";
+		fe3_i2c_adap_id = <&i2c2>;
