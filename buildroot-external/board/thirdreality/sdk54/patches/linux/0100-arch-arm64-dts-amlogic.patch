+			groups = "pwm_a_hiz";
+			function = "pwm_a_hiz";
+		};
+	};
+
+	pwm_b_hiz_pins: pwm_b_hiz_pins {
+		mux {
+			groups = "pwm_b_hiz";
+			function = "pwm_b_hiz";
+		};
