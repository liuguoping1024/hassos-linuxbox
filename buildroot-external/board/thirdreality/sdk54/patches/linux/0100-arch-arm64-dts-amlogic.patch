+		fe0_ts_header_data = <0x4b 0x20 0x0 0x0>;
+
+		fe1_ts_header_bytes = <4>;
+		fe1_ts_header_data = <0x4b 0x21 0x0 0x0>;
+
+		fe2_ts_header_bytes = <4>;
+		fe2_ts_header_data = <0x4b 0x22 0x0 0x0>;
+
+		fe3_ts_header_bytes = <4>;
+		fe3_ts_header_data = <0x4b 0x23 0x0 0x0>;
+
+		fe0_demod = "MXL258C";
+		fe0_i2c_adap_id = <&i2c2>;
+		fe0_demod_i2c_addr = <0x50>;
+		fe0_demod_code = <0x254c>;
+
+		/* 0: NO_MUX_4, 1: MUX_1, 2: MUX_2, 3: MUX_3. */
+		/* 4: MUX_4, 5: MUX_2_B, 6: NO_MUX_2.*/
