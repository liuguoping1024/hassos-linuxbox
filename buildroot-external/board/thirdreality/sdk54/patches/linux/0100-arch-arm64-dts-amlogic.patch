+			groups = "tdm_sclk0",
+				"tdm_fs0",
+				"tdm_d0",
+				"tdm_d1";
+			function = "tdm";
+		};
+	};
+
+	pdmin: pdmin {
+		mux { /* GPIOD_8, GPIOD_9 */
+			groups = "pdm_din0_d";
+			function = "pdm";
+		};
+		mux1 {
+			groups = "pdm_dclk_d";
+			function = "pdm";
+			drive-strength-microamp = <500>;
+		};
+	};
