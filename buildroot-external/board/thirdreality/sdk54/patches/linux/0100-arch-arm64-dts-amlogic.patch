+				"pdm_din0_h18",
+				"pdm_din1_h14";
+			function = "pdm";
+		};
+	};
+	tdm_b_pins: tdm_a_pin {
+		mux { /* GPIOH_16, GPIOH_15, GPIOH_17 */
+			groups = "tdm_sclk1_h",
+				"tdm_fs1_h",
+				"tdm_d0_h";
+			function = "tdm";
+		};
+	};
+
+	/*backlight*/
+	bl_pwm_vs_on_pins:bl_pwm_vs_on_pin {
