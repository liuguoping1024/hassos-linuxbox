+	dvb_s_ts0_pins: dvb_s_ts0_pins {
+		tsin_a {
+			groups = "tsin_a_sop",
+				"tsin_a_valid",
+				"tsin_a_clk",
+				"tsin_a_din0";
+			function = "tsin_a";
+		};
+	};
+}; /* end of periphs_pinctrl */
