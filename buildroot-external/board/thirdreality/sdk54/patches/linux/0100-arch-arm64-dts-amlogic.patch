+
+		/* clk path */
+		/* 0:vid_pll vid2_clk */
+		/* 1:gp0_pll vid2_clk */
+		/* 2:vid_pll vid1_clk */
+		/* 3:gp0_pll vid1_clk */
+		clk_path = <0>;
+
+		/* performance: reg_address, reg_value */
+		/* s4d */
+		performance_pal = <0x1bf0  0x9 /* default Matrx625 CTCC value */
+			0x1b12  0x80c0
+			0x1b05  0xfa
+			0x1b56  0x333
+			0x1c59  0xf060
+			0xffff  0x0>; /* ending flag */
+		performance = <0x1bf0  0x9 /* ccitt033 SVA value */
+			0x1b12  0x8040
+			0x1b05  0x2
+			0x1b56  0x333
+			0x1c59  0xf458
+			0xffff  0x0>; /* ending flag */
+		performance_ntsc = <0x1bf0  0x3 /* Matrx525 TTC value */
+			0x1b12  0x8180
+			0x1b05  0xf0
+			0x1b56  0x333
+			0x1c59  0xed66
+			0xffff  0x0>; /* ending flag */
+	};
