+
+	pwm_e_pins1: pwm_e_pins1 {
+		mux {
+			groups = "pwm_e_x";
+			function = "pwm_e";
+			drive-strength-microamp = <500>;
+		};
+	};
+
+	pwm_e_pins2: pwm_e_pins2 {
+		mux {
+			groups = "pwm_e_z";
+			function = "pwm_e";
+		};
+	};
+
+	pwm_f_pins1: pwm_f_pins1 {
+		mux {
+			groups = "pwm_f_x";
+			function = "pwm_f";
+		};
+	};
+
+	pwm_f_pins2: pwm_f_pins2 {
