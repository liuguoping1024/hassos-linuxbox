+				<&clkc CLKID_HDMIRX_METER_GATE>,
+				<&clkc CLKID_HDMIRX_AXI_GATE>,
+				<&xtal>,
+				<&clkc CLKID_FCLK_DIV3>,
+				<&clkc CLKID_FCLK_DIV5>,
+				<&clkc CLKID_FCLK_DIV7>,
+				<&clkc CLKID_HDMIRX_SKP_GATE>,
