+		};
+	};
+
+	pwm_i_pins2: pwm_i_pins2 {
+		mux {
+			groups = "pwm_i_h";
+			function = "pwm_i";
+		};
+	};
+
+	pwm_j_pins: pwm_j_pins {
+		mux {
+			groups = "pwm_j";
+			function = "pwm_j";
+		};
+	};
+
+	pwm_a_hiz_pins: pwm_a_hiz_pins {
