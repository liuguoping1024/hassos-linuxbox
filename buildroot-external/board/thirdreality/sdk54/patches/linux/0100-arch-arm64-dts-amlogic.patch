diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm64/boot/dts/amlogic/t5d_t950d4_am301_linux_1g.dts b/arch/arm64/boot/dts/amlogic/t5d_t950d4_am301_linux_1g.dts
