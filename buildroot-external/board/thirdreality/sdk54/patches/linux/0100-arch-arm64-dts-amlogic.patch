+		      <0x0 0xfe007180 0x0 0x80>,   /* mhu set reg */
+		      <0x0 0xfe007200 0x0 0x80>,   /* mhu clr reg */
+		      <0x0 0xfe007280 0x0 0x80>,   /* mhu sts reg */
+		      <0x0 0xfe007040 0x0 0xc0>;   /* mhu irqctrl reg */
