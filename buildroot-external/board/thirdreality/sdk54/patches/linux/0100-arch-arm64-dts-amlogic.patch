+		/* clk path */
+		/* 0:vid_pll vid2_clk */
+		/* 1:gp0_pll vid2_clk */
+		/* 2:vid_pll vid1_clk */
+		/* 3:gp0_pll vid1_clk */
+		clk_path = <0>;
+
+		/* performance: reg_address, reg_value */
+		/* sc2 */
+		performance_pal = <0x1bf0  0x3 /* default Matrx625 CTCC value */
+			0x1b12  0x8060
+			0x1b05  0xf9
+			0x1b56  0x333
+			0x1c59  0xf15e
+			0xffff  0x0>; /* ending flag */
