+	tdm_a_pins: tdm_a_pin {
+		mux { /* GPIOT_15, GPIOT_16, GPIOT_17, GPIOT_18 */
+			groups = "tdm_sclk0",
+				"tdm_fs0",
+				"tdm_d0",
+				"tdm_d1";
+			function = "tdm";
+		};
+	};
+	tdm_b_pins: tdm_b_pin {
+		mux { /* GPIOT_20, GPIOT_21, GPIOT_22, GPIOT_23 */
+			groups = "tdm_sclk1",
+				"tdm_fs1",
+				"tdm_d2",
+				"tdm_d3";
