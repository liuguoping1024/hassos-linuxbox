+		reserve-iomap = "true";
+		/*memory-region = <&vdin1_cma_reserved>;*/
+		flag_cma = <0>;/*1:share with codec_mm;0:cma alone*/
+		interrupts = <0 212 1>;
+		interrupt-names = "vsync_int"/*, "vpu_crash_int",*/
+				/*"write_done_int"*/;
+		rdma-irq = <4>;
+//		clocks = <&clock CLK_FPLL_DIV5>,
+//			<&clock CLK_VDIN_MEAS_CLK>;
+//		clock-names = "fclk_div5", "cts_vdin_meas_clk";
+
+		vdin_id = <1>;
+		tv_bit_mode = <0x15>;
+		/* vdin v4l2 */
+		v4l_support_en = <0>;
+		v4l_vd_num = <71>;
+		/* v4l2 capability */
+		driver   = "vdinvideo";
+		card     = "mesonp1";
+		bus_info = "vdin1 v4l2";
+		version  = <0x20220120>;
+		/* fe_ports refer to tvin.h */
+		fe_ports = <0x0000a002   /* WB0_VD1 */
+			0x0000a003   /* WB0_VD2 */
+			0x0000a004   /* WB0_OSD1 */
+			0x0000a005   /* WB0_OSD2 */
+			0x0000a006   /* WB0_VPP */
+			0x0000a007   /* WB0_VDIN_BIST */
