+		 *if support 1080p-YUV422-8BIT-WR:1920*1080*2*4 ~= 16M
+		 *worst case:(4096*2160*3 + 2M(afbce issue)) *10buf = 273.5M
+		 *for double write 4k, need extra 25M for 960x540(1/4 down)
+		 */
+		cma_size = <300>;
+		/* max buffer number */
+		frame_buff_num = <10>;
+		interrupts = <0 83 1 /* vdin0 vsync */
