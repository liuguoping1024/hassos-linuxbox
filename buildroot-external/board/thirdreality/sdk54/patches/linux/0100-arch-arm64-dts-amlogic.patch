+++ b/arch/arm64/boot/dts/amlogic/mesonsc2_drm.dtsi	2026-02-09 11:25:54.385398588 +0800
@@ -0,0 +1,260 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
