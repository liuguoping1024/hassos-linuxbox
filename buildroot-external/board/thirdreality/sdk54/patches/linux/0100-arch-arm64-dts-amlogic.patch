+		};
+		partition@2 {
+			label = "ddrfip";
+			reg = <0x0 0x00000000>;
+		};
+		partition@3 {
+			label = "tpl";
+			reg = <0x0 0x00000000>;
+		};
+		partition@4 {
+			label = "logo";
+			reg = <0x0 0x00200000>;
+		};
+		partition@5 {
+			label = "recovery";
