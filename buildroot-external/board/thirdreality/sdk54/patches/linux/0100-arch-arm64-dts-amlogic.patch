+};
+
+&vdin1 {
+	/*compatible = "amlogic, vdin-sc2";*/
+	memory-region = <&vdin1_cma_reserved>;
+	/*status = "disabled";*/
+	/*vdin write mem color depth support:
+	 *bit0:support 8bit
+	 *bit1:support 9bit
+	 *bit2:support 10bit
+	 *bit3:support 12bit
+	 */
