+		};
+		partition@3 {
+			label = "tpl";
+			reg = <0x0 0x00000000>;
+		};
+		partition@4 {
+			label = "logo";
+			reg = <0x0 0x00200000>;
+		};
+		partition@5 {
+			label = "recovery";
+			reg = <0x0 0x1000000>;
+		};
+		partition@6 {
+			label = "boot";
+			reg = <0x0 0x0F00000>;
+		};
+		partition@7 {
+			label = "system";
+			reg = <0x0 0x11800000>;
+		};
+		partition@8 {
+			label = "data";
+			reg = <0x0 0xffffffff>;
+		};
+	};
+};
+
+&saradc {
