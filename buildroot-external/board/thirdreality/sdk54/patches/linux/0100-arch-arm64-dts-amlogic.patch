+/ {
+	model = "Amlogic";
+	amlogic-dt-id = "s4d_s905y4_ap229";
+	compatible = "amlogic, s4d";
+	interrupt-parent = <&gic>;
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
+		serial0 = &uart_B;
+		serial1 = &uart_A;
+		serial2 = &uart_C;
+		serial3 = &uart_D;
+		serial4 = &uart_E;
