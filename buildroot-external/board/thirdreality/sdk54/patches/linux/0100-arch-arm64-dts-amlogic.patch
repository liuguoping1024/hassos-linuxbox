+/ {
+	model = "Amlogic";
+	amlogic-dt-id = "sc2_s905c2l_ah221";
+	compatible = "amlogic, sc2";
+	interrupt-parent = <&gic>;
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
+		serial0 = &uart_B;
+		serial1 = &uart_E;
+		serial2 = &uart_C;
+		serial3 = &uart_D;
+		serial4 = &uart_A;
