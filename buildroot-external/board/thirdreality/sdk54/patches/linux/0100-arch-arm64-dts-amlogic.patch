+/ {
+	model = "Amlogic";
+	amlogic-dt-id = "p1_ninox_4_4g";
+	compatible = "amlogic, p1";
+	interrupt-parent = <&gic>;
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
+		serial0 = &uart_A;
+		serial1 = &uart_C;
+		serial2 = &uart_B;
+		serial3 = &uart_D;
+		serial4 = &uart_E;
+		serial5 = &uart_F;
+		i2c0 = &i2c0;
+		i2c1 = &i2c1;
+		i2c2 = &i2c2;
+		i2c3 = &i2c3;
+		i2c4 = &i2c4;
+		i2c5 = &i2c5;
+		i2c6 = &i2c6;
+		i2c7 = &i2c7;
