+		pinctrl-0 = <&mclk_3_pins
+			&tdm_d_pins
+			&tdm_d6_pins
+			&tdm_d7_pins
+			&tdmd_clk_pins>;
+		start_clk_enable = <1>;
+		status = "okay";
+	};
+	pdm:pdm@0 {
