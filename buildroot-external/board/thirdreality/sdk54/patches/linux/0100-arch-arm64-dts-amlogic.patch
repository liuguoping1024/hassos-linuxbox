+		status = "okay";
+		device_mask = <1>;/*bit0:ch1;bit1:ch2*/
+		reg = <0x0 0xffd00000 0x0 0xf0a0>; /* cvbs irq base */
+		interrupts = <0 12 1>,
+				<0 13 1>;
