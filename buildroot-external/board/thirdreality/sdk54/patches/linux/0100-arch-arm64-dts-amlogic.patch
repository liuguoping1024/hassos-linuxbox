+ *			f_min = <400000>;
+ *			f_max = <200000000>;
+ *			max_req_size = <0x20000>;
+ *			card_type = <3>;
+ *		};
+ *	};
+ */
+
+	sd_emmc_b: sd@ffe05000 {
+		status = "disabled";
+		compatible = "amlogic, meson-mmc-t5";
+		reg = <0x0 0xffe05000 0x0 0x800>;
