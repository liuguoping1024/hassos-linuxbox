+/ {
+	model = "Amlogic T5D T950X4 AM311 512M";
+	amlogic-dt-id = "t5d-reva_t950x4_am311-512m";
+
+	aliases {
+		serial0 = &uart_B;
+		serial1 = &uart_A;
+		serial2 = &uart_C;
+		//serial3 = &uart_C;
+		//serial4 = &uart_AO_B;
