+	bus-width = <8>;
+	cap-mmc-highspeed;
+//	mmc-ddr-1_8v;
+	mmc-hs200-1_8v;
+	mmc-hs400-1_8v;
+	//mmc-hs400-enhanced-strobe;
+	max-frequency = <200000000>;
