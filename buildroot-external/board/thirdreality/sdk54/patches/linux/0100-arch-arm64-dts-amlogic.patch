+	status = "okay";
+};
+
+&pwm_cd {
+	status = "okay";
+};
+
+&pwm_ef {
+	pinctrl-0 = <&pwm_f_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&irblaster {
+	status = "disabled";
+};
+
+&uart_B {
+	status = "okay";
+	uart-has-rtscts;
+};
+
+&vddcpua {
+	status = "okay";
+};
+
+&vddcpub {
+	status = "okay";
+};
diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm64/boot/dts/amlogic/s5_s928x_ax208.dts b/arch/arm64/boot/dts/amlogic/s5_s928x_ax208.dts
