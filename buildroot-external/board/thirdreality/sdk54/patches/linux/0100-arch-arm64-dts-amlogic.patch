+	/* Audio Related end */
+
+	tvafe_avin_detect {
+		compatible = "amlogic, t3_tvafe_avin_detect";
+		status = "okay";
+		device_mask = <1>;/*bit0:ch1;bit1:ch2*/
+		reg = <0x0 0xfe00a000 0x0 0x400>; /* cvbs irq base */
+		interrupts = <0 173 1>,
+				<0 172 1>;
