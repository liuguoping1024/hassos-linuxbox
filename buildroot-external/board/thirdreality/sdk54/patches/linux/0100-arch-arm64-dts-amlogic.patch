+	//			"tsin_d_din0_z";
+	//		function = "tsin_d";
+	//	};
+	//};
+
+	dvb_p_ts1_pins: dvb_p_ts1_pins {
+		tsin_b {
+			groups = "tsin_b_sop",
+			"tsin_b_valid",
+			"tsin_b_clk",
+			"tsin_b_fail",
+			"tsin_b_din0",
+			"tsin_b_din1",
+			"tsin_b_din2",
+			"tsin_b_din3",
+			"tsin_b_din4",
+			"tsin_b_din5",
+			"tsin_b_din6",
+			"tsin_b_din7";
+			function = "tsin_b";
