+ *			<&clkc CLKID_FCLK_DIV2>,
+ *			<&clkc CLKID_FCLK_DIV5>,
+ *			<&xtal>;
+ *		clock-names = "core", "clkin0", "clkin1", "clkin2", "xtal";
+ *
+ *		bus-width = <4>;
+ *		cap-sd-highspeed;
+ *		cap-mmc-highspeed;
+ *		max-frequency = <100000000>;
+ *		disable-wp;
+ *		sdio {
+ *			pinname = "sdio";
+ *			ocr_avail = <0x200080>;
