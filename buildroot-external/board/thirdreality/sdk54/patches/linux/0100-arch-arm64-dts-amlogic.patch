diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm64/boot/dts/amlogic/s4_s905y4_ap222_linux.dts b/arch/arm64/boot/dts/amlogic/s4_s905y4_ap222_linux.dts
