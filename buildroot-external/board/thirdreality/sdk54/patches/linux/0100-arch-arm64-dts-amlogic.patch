diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm64/boot/dts/amlogic/s4d_s905c3_ap232_linux.dts b/arch/arm64/boot/dts/amlogic/s4d_s905c3_ap232_linux.dts
--- a/arch/arm64/boot/dts/amlogic/s4d_s905c3_ap232_linux.dts	1970-01-01 08:00:00.000000000 +0800
+++ b/arch/arm64/boot/dts/amlogic/s4d_s905c3_ap232_linux.dts	2026-02-09 11:25:54.389398808 +0800
@@ -0,0 +1,1569 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
