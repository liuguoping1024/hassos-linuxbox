+		#sound-dai-cells = <0>;
+		codec_name = "tas5805";
+		reg = <0x2e>;
+		reset_pin = <&gpio_ao GPIOD_9 GPIO_ACTIVE_HIGH>;
+		status = "okay";
+	};
+};
+
+&aml_bt {
+	status = "okay";
+	power_down_disable = <1>;
+	reset-gpios = <&gpio_ao       GPIOD_3       GPIO_ACTIVE_HIGH>;
