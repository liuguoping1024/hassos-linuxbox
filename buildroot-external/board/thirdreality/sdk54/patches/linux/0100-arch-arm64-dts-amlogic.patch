+&uart_A {
+	status = "disabled";
+	uart-has-rtscts;
+};
+
+&earc {
+	status = "okay";
+};
+
+&cma_shrinker {
+	free = <7680 24288 28528 32600 32768 36624>;
+};
diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm64/boot/dts/amlogic/t5w_t962d4_at301_linux.dts b/arch/arm64/boot/dts/amlogic/t5w_t962d4_at301_linux.dts
