+/ {
+	model = "Amlogic";
+	amlogic-dt-id = "s4d_s905y4_ap223";
+	compatible = "amlogic, s4d";
+	interrupt-parent = <&gic>;
+	#address-cells = <2>;
+	#size-cells = <2>;
+
+	aliases {
