+
+&vddcpua {
+	status = "disabled";
+};
+
+&vddcpub {
+	status = "disabled";
+};
diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm64/boot/dts/amlogic/p1_ninox_4_4g.dts b/arch/arm64/boot/dts/amlogic/p1_ninox_4_4g.dts
