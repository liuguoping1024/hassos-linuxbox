diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm64/boot/dts/amlogic/t7_a311d2_an400_8g.dts b/arch/arm64/boot/dts/amlogic/t7_a311d2_an400_8g.dts
