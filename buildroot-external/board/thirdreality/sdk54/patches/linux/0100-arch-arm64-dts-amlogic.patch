+				 *	<1 1 1 1 1 1 1 1>;
+				 * dai-tdm-slot-rx-mask =
+				 *	<1 1 1 1 1 1 1 1>;
+				 * dai-tdm-slot-num = <8>;
+				 */
+				dai-tdm-slot-width = <32>;
+				system-clock-frequency = <12288000>;
+			};
+			tdmbcodec: codec {
+				prefix-names = "5707_A", "5707_B";
+				sound-dai = <&tas5707_36 &tas5707_3a>;
+			};
+		};
+
+		aml-audio-card,dai-link@2 {
+			mclk-fs = <64>;
+			/* suffix-name, sync with android audio hal
+			 * what's the dai link used for
+			 */
+			suffix-name = "alsaPORT-pdm";
+			cpu {
+				sound-dai = <&apdm>;
+			};
+			codec {
+				sound-dai = <&dummy_codec>;
+			};
+		};
+
+		aml-audio-card,dai-link@3 {
+			mclk-fs = <128>;
+			/* suffix-name, sync with android audio hal used for */
+			suffix-name = "alsaPORT-spdif";
+			cpu {
+				sound-dai = <&spdifa>;
+				system-clock-frequency = <6144000>;
+			};
+			codec {
+				sound-dai = <&dummy_codec>;
+			};
+		};
+
+		aml-audio-card,dai-link@4 {
+			mclk-fs = <256>;
+			continuous-clock;
+			suffix-name = "alsaPORT-loopback";
+			cpu {
+				sound-dai = <&loopbacka>;
+				system-clock-frequency = <12288000>;
+			};
+			codec {
+				sound-dai = <&dummy_codec>;
+			};
+		};
+
+		aml-audio-card,dai-link@5 {
+			format = "dsp_a";
+			mclk-fs = <512>;
+			//continuous-clock;
+			//bitclock-inversion;
+			//frame-inversion;
+			/* master mode */
+			bitclock-master = <&tdmc>;
+			frame-master = <&tdmc>;
+			/* slave mode */
+			//bitclock-master = <&tdmccodec>;
+			//frame-master = <&tdmccodec>;
+			/* suffix-name, sync with android audio hal used for */
+			// suffix-name = "alsaPORT-tdmin";
+			cpu {
+				sound-dai = <&tdmc>;
+				dai-tdm-slot-tx-mask = <1>;
+				dai-tdm-slot-rx-mask = <1>;
+				dai-tdm-slot-num = <1>;
+				dai-tdm-slot-width = <32>;
+				system-clock-frequency = <512000>;
+			};
+			codec {
+				sound-dai = <&dummy_codec>;
+			};
+		};
+	};
+
+	audiolocker: locker {
+		compatible = "amlogic, audiolocker";
+		clock-names = "lock_out", "lock_in", "out_src",
+					"in_src", "out_calc", "in_ref";
+		interrupts = <GIC_SPI 1 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "irq";
+		frequency = <49000000>; /* pll */
+		dividor = <49>; /* locker's parent */
+		status = "disabled";
+	};/* Audio Related end */
+
+	adc_keypad {
+		compatible = "amlogic, adc_keypad";
+		status = "okay";
+		key_name = "update", "vol-", "vol+", "ok" ,"power";
+		key_num = <5>;
+		io-channels = <&saradc 2>;
+		io-channel-names = "key-chan-2";
+		key_chan = <2 2 2 2 2>;
+		key_code = <KEY_SETUP KEY_VOLUMEDOWN KEY_VOLUMEUP KEY_ENTER KEY_POWER>;
+		key_val = <0 143 266 389 512>; //val=voltage/1800mV*1023
+		key_tolerance = <40 40 40 40 40>;
+	};
+
+	gpio_keypad{
+		compatible = "amlogic, gpio_keypad";
+		status = "disabled";
+		scan_period = <20>;
+		key_num = <1>;
+		key_name = "mute";
+		key_code = <SW_MUTE_DEVICE>;
+		key_type = <EV_SW>;
+		key-gpios = <&gpio  GPIOD_3  GPIO_ACTIVE_HIGH>;
+		detect_mode = <0>;/*0:polling mode, 1:irq mode*/
+	};
+
+	partitions: partitions{
+		parts = <5>;
+		part-0 = <&recovery>;
+		part-1 = <&misc>;
+		part-2 = <&boot>;
+		part-3 = <&system>;
+		part-4 = <&data>;
+
+		recovery:recovery{
+			pname = "recovery";
+			size = <0x0 0x2000000>;
+			mask = <1>;
+		};
+		misc:misc{
+			pname = "misc";
+			size = <0x0 0x800000>;
+			mask = <1>;
+		};
+		boot:boot
+		{
+			pname = "boot";
+			size = <0x0 0x4000000>;
+			mask = <1>;
+		};
+		system:system
+		{
+			pname = "system";
+			size = <0x0 0x40000000>;
+			mask = <1>;
+		};
+		data:data
+		{
+			pname = "data";
+			size = <0xffffffff 0xffffffff>;
+			mask = <4>;
+		};
+	};
+};
+
+&audiobus {
+	tdma: tdm@0 {
+		compatible = "amlogic, a5-snd-tdma";
+		#sound-dai-cells = <0>;
+		dai-tdm-lane-slot-mask-in = <1 1 1 1>;
+		dai-tdm-lane-slot-mask-out = <1 1>;
+		dai-tdm-clk-sel = <2>;
+		clocks = <&clkaudio CLKID_AUDIO_MCLK_A
+				&clkaudio CLKID_AUDIO_MCLK_PAD2
+				&clkc CLKID_MPLL0>;
+		clock-names = "mclk", "mclk_pad", "clk_srcpll";
+		pinctrl-names = "tdm_pins", "tdmout_a_gpio";
+		pinctrl-0 = <
+			&mclk_2_pins
+			&tdmain_pins
+			&tdm_d8_pins
+			&tdm_d9_pins
+			&tdm_d10_pins
+			&tdm_d11_pins
+			&tdmain_clk_pins
+			>;
+		pinctrl-1 = <&tdmin_a_gpio>;
+		tdm5v-supply = <&vcc5v_reg>;
+		tdm3v3-supply = <&vddio3v3_reg>;
+		status = "okay";
+	};
+
+	tdmb: tdm@1 {
+		compatible = "amlogic, a5-snd-tdmb";
+		#sound-dai-cells = <0>;
+		dai-tdm-lane-slot-mask-out = <1 1>;
+		dai-tdm-clk-sel = <1>;
+		clocks = <&clkaudio CLKID_AUDIO_MCLK_B
+				&clkaudio CLKID_AUDIO_MCLK_PAD1
+				&clkc CLKID_MPLL1>;
+		clock-names = "mclk", "mclk_pad", "clk_srcpll";
+		pinctrl-names = "tdm_pins", "tdmout_a_gpio";
+		pinctrl-0 = <
+			&mclk_1_pins
+			&tdm_b_pins
+			&tdm_d2_pins
+			&tdm_d3_pins
+			&tdmb_clk_pins>;
+		pinctrl-1 = <&tdmout_b_gpio>;
+		start_clk_enable = <1>;
+		tdm5v-supply = <&vcc5v_reg>;
+		tdm3v3-supply = <&vddio3v3_reg>;
+		status = "okay";
+	};
+
+	tdmc:tdm@2 {
+		compatible = "amlogic, a5-snd-tdmc";
+		#sound-dai-cells = <0>;
+		dai-tdm-lane-slot-mask-in = <1 0>;
+		// dai-tdm-lane-slot-mask-out = <0 1>;
+		dai-tdm-clk-sel = <0>;
+		clocks = <&clkaudio CLKID_AUDIO2_MCLK_VAD
+				&clkc CLKID_MPLL2>;
+		clock-names = "mclk","clk_srcpll";
+		pinctrl-names = "tdm_pins", "tdmout_a_gpio";
+		pinctrl-0 = <
+			&tdmcin_pins
+			&tdm_d0_pins
+			&tdm_d1_pins
+			&tdmc_clk_pins>;
+		pinctrl-1 = <&tdmin_c_gpio>;
+		tdm5v-supply = <&vcc5v_reg>;
+		tdm3v3-supply = <&vddio3v3_reg>;
+		status = "okay";
+	};
+
+	spdifa: spdif@0 {
+		compatible = "amlogic, a5-snd-spdif-a";
+		#sound-dai-cells = <0>;
+		clocks = <&clkc CLKID_MPLL0
+				&clkc CLKID_FCLK_DIV4
+				&clkaudio CLKID_AUDIO_GATE_SPDIFIN
+				&clkaudio CLKID_AUDIO_GATE_SPDIFOUT_A
+				&clkaudio CLKID_AUDIO_SPDIFIN
+				&clkaudio CLKID_AUDIO_SPDIFOUT_A>;
+		clock-names = "sysclk", "fixed_clk", "gate_spdifin",
+				"gate_spdifout", "clk_spdifin", "clk_spdifout";
+		interrupts =
+				<GIC_SPI 35 IRQ_TYPE_EDGE_RISING>;
+
+		interrupt-names = "irq_spdifin";
+		pinctrl-names = "spdif_pins", "spdif_pins_mute";
+		pinctrl-0 = <&spdifout
+			     &spdifin>;
+		pinctrl-1 = <&spdif_a_mute>;
+
+		/*spdif clk tuning enable*/
+		clk_tuning_enable = <1>;
+
+		spdif5v-supply = <&vcc5v_reg>;
+		spdif3v3-supply = <&vddio3v3_reg>;
+		status = "okay";
+	};
+
+	apdm: pdm {
+		compatible = "amlogic, a5-snd-pdm";
+		#sound-dai-cells = <0>;
+
+		clocks = <&clkaudio CLKID_AUDIO2_GATE_PDM
+			&clkc CLKID_FCLK_DIV4
+			&clkc CLKID_MPLL1
+			&clkaudio CLKID_AUDIO2_PDM_DCLK
+			&clkaudio CLKID_AUDIO2_PDM_SYSCLK>;
+		clock-names = "gate",
+			"sysclk_srcpll",
+			"dclk_srcpll",
+			"pdm_dclk",
+			"pdm_sysclk";
+		power-domains = <&pwrdm PDID_A5_AUDIO_PDM>;
+		pinctrl-names = "pdm_pins";
+		pinctrl-0 = <&pdmin>;
+
+		/* mode 0~4, defalut:1 */
+		filter_mode = <1>;
+
+		pdm5v-supply = <&vcc5v_reg>;
+		pdm3v3-supply = <&vddio3v3_reg>;
+		status = "okay";
+	};
+
+	/* a5 only one resample, a/b can only use one at the same time */
+	/* spdif use this resample */
+	asrca: resample@0 {
+		compatible = "amlogic, t5-resample-a";
+		clocks = <&clkc CLKID_MPLL2
+				&clkaudio CLKID_AUDIO_MCLK_F
+				&clkaudio CLKID_AUDIO_RESAMPLE_A>;
+		clock-names = "resample_pll", "resample_src", "resample_clk";
+		/*same with toddr_src
+		 *	TDMIN_A, 0
+		 *	TDMIN_B, 1
+		 *	TDMIN_C, 2
+		 *	SPDIFIN, 3
+		 *	PDMIN,  4
+		 *	NONE,
+		 *	TDMIN_LB, 6
+		 *	LOOPBACK, 7
+		 */
+		resample_module = <3>;
+		status = "disabled";
+	};
+
+	/* loopback use this resample */
+	asrcb: resample@1 {
+		compatible = "amlogic, t5-resample-b";
+		clocks = <&clkc CLKID_MPLL2
+				&clkaudio CLKID_AUDIO_MCLK_F
+				&clkaudio CLKID_AUDIO_RESAMPLE_A>;
+		clock-names = "resample_pll", "resample_src", "resample_clk";
+		/*this resample is only used for loopback_A.*/
+		capture_sample_rate = <16000>;
+
+		status = "okay";
+	};
+
+	vad:vad {
+		compatible = "amlogic, snd-vad-top";
+		#sound-dai-cells = <0>;
+
+		clocks = <&clkaudio CLKID_AUDIO2_GATE_TOVAD
+			&clkc CLKID_FCLK_DIV4
+			&clkaudio CLKID_AUDIO2_VAD_CLK>;
+		clock-names = "gate", "pll", "clk";
+
+		interrupts = <GIC_SPI 39 IRQ_TYPE_EDGE_RISING
+				GIC_SPI 44 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "irq_wakeup", "irq_frame_sync";
+
+		/*
+		 * Data src sel:
+		 * 0: tdmin_a;
+		 * 1: tdmin_b;
+		 * 2: tdmin_c;
+		 * 3: spdifin;
+		 * 4: pdmin;
+		 * 5: loopback_b;
+		 * 6: tdmin_lb;
+		 * 7: loopback_a;
+		 */
+		src = <4>;
+
+		/*
+		 * deal with hot word in user space or kernel space
+		 * 0: in user space
+		 * 1: in kernel space
+		 */
+		level = <1>;
+
+		status = "okay";
+	};
+
+	loopbacka:loopback@0 {
+		compatible = "amlogic, a5-loopbacka";
+		#sound-dai-cells = <0>;
+
+		clocks = <&clkaudio CLKID_AUDIO2_GATE_PDM
+			&clkc CLKID_FCLK_DIV4
+			&clkc CLKID_MPLL1
+			&clkaudio CLKID_AUDIO2_PDM_DCLK
+			&clkaudio CLKID_AUDIO2_PDM_SYSCLK
+			&clkc CLKID_MPLL1
+			&clkaudio CLKID_AUDIO_MCLK_B>;
+		clock-names = "pdm_gate",
+			"pdm_sysclk_srcpll",
+			"pdm_dclk_srcpll",
+			"pdm_dclk",
+			"pdm_sysclk",
+			"tdminlb_mpll",
+			"tdminlb_mclk";
+
+		/* datain src
+		 * 0: tdmin_a;
+		 * 1: tdmin_b;
+		 * 2: tdmin_c;
+		 * 3: spdifin;
+		 * 4: pdmin;
+		 */
+		datain_src = <4>;
+		datain_chnum = <8>;
+		datain_chmask = <0xff>;
+		/* config which data pin for loopback */
+		datain-lane-mask-in = <1 1 1 1>;
+
+		/* calc mclk for datalb */
+		mclk-fs = <256>;
+
+		/* tdmin_lb src
+		 * 0: tdmoutA
+		 * 1: tdmoutB
+		 * 2: tdmoutC
+		 * 3: PAD_TDMINA_DIN*, refer to core pinmux
+		 * 4: PAD_TDMINB_DIN*, refer to core pinmux
+		 * 5: PAD_TDMINC_DIN*, refer to core pinmux
+		 * 6: PAD_TDMINA_D*, oe, refer to core pinmux
+		 * 7: PAD_TDMINB_D*, oe, refer to core pinmux
+		 */
+		/* if tdmin_lb >= 3, use external loopback */
+		datalb_src = <1>;
+		datalb_chnum = <8>;
+		datalb_chmask = <0xff>;
+		/* config which data pin as loopback */
+		datalb-lane-mask-in = <1 1 1 1>;
+
+		status = "okay";
+	};
+
+	aed:effect {
+		compatible = "amlogic, snd-effect-v4";
+		#sound-dai-cells = <0>;
+		clocks = <&clkaudio CLKID_AUDIO_GATE_EQDRC
+			&clkc CLKID_FCLK_DIV4
+			&clkaudio CLKID_AUDIO_EQDRC>;
+		clock-names = "gate", "srcpll", "eqdrc";
+		/*
+		 * 0:tdmout_a
+		 * 1:tdmout_b
+		 * 2:tdmout_c
+		 * 3:spdifout
+		 * 4:spdifout_b
+		 */
+		eqdrc_module = <1>;
+		/* max 0xf, each bit for one lane, usually one lane */
+		lane_mask = <0x1>;
+		/* max 0xff, each bit for one channel */
+		channel_mask = <0xff>;
+		status = "okay";
+	};
+}; /* end of audiobus */
+
+&periphs_pinctrl {
+
+	tdmain_pins: tdmain_pin {
+		mux { /* GPIOT_1, GPIOT_0, GPIOT_2, GPIOT_3, GPIOT_4, GPIOT_5 */
+			groups = "tdm_sclk2_t",
+				"tdm_fs2_t",
+				"tdm_d8_t",
+				"tdm_d9_t",
+				"tdm_d10_t",
+				"tdm_d11_t";
+			function = "tdm";
+		};
+	};
+
+	tdm_b_pins: tdm_b_pin {
+		mux { /* GPIOC_0, GPIOC_1, GPIOC_2--GPIOC_8, GPIOT7, GPIOT8*/
+			groups = "tdm_d2_c",
+				"tdm_d3_c",
+				"tdm_fs1_c",
+				"tdm_sclk1_c",
+				"tdm_d4_c",
+				"tdm_d5_c",
+				"tdm_d6_c",
+				"tdm_d7_c",
+				"tdm_d12_t",
+				"tdm_d13_t";
+			function = "tdm";
+		};
+	};
+
+	tdmin_a_gpio: tdmin_a_gpio {
+		mux {
+			groups ="GPIOT_0",
+				"GPIOT_1",
+				"GPIOT_2",
+				"GPIOT_3",
+				"GPIOT_4",
+				"GPIOT_5",
+				"GPIOT_6";
+			function = "gpio_periphs";
+			output-low;
+		};
+	};
+
+	tdmout_b_gpio: tdmout_b_gpio {
+		mux {
+			groups ="GPIOC_0",
+				"GPIOC_1",
+				"GPIOC_2",
+				"GPIOC_3",
+				"GPIOC_4",
+				"GPIOC_5",
+				"GPIOC_6",
+				"GPIOC_7",
+				"GPIOC_8",
+				"GPIOT_7",
+				"GPIOT_8";
+			function = "gpio_periphs";
+			output-low;
+		};
+	};
+	tdmin_c_gpio: tdmin_c_gpio {
+		mux {
+			groups ="GPIOX_8",
+				"GPIOX_9",
+				"GPIOX_10",
+				"GPIOX_11";
+			function = "gpio_periphs";
+			output-low;
+		};
+	};
+	tdmcin_pins: tdmcin_pin {
+		mux { /* GPIOX_8, GPIOX_9, GPIOX_10, GPIOX_11, */
+			groups = "tdm_sclk0_x",
+				"tdm_fs0_x",
+				"tdm_d0_x",
+				"tdm_d1_x";
+			function = "tdm";
+		};
+	};
+
+	pdmin: pdmin {
+		mux { /* GPIOH_2, GPIOH_1, GPIOH_0, GPIOH_4, GPIOH_3 */
+			groups = "pdm_dclk_h",
+				"pdm_din0_h",
+				"pdm_din1_h",
+				"pdm_din2_h",
+				"pdm_din3_h";
+			function = "pdm";
+		};
+	};
+
+}; /* end of periphs_pinctrl */
+
+&pinctrl_audio {
+	tdm_d0_pins: tdm_d0_pin {
+		mux {
+			groups = "tdm_d0";
+			function = "vadtop_tdmin_lane0";
+		};
+	};
+
+	tdm_d1_pins: tdm_d1_pin {
+		mux {
+			groups = "tdm_d1";
+			function = "vadtop_tdmin_lane1";
+		};
+	};
+
+	tdm_d2_pins: tdm_d2_pin {
+		mux {
+			groups = "tdm_d4";
+			function = "tdmoutb_lane0";
+		};
+	};
+
+	tdm_d3_pins: tdm_d3_pin {
+		mux {
+			groups = "tdm_d5";
+			function = "tdmoutb_lane1";
+		};
+	};
+
+	tdm_d4_pins: tdm_d4_pin {
+		mux {
+			groups = "tdm_d4";
+			function = "tdmoutb_lane2";
+		};
+	};
+
+	tdm_d5_pins: tdm_d5_pin {
+		mux {
+			groups = "tdm_d5";
+			function = "tdmoutb_lane3";
+		};
+	};
+
+	tdm_d6_pins: tdm_d6_pin {
+		mux {
+			groups = "tdm_d6";
+			function = "tdmoutb_lane4";
+		};
+	};
+
+	tdm_d7_pins: tdm_d7_pin {
+		mux {
+			groups = "tdm_d7";
+			function = "tdmoutb_lane5";
+		};
+	};
+
+	tdm_d8_pins: tdm_d8_pin {
+		mux {
+			groups = "tdm_d8";
+			function = "tdmina_lane0";
+		};
+	};
+
+	tdm_d9_pins: tdm_d9_pin {
+		mux {
+			groups = "tdm_d9";
+			function = "tdmina_lane1";
+		};
+	};
+
+	tdm_d10_pins: tdm_d10_pin {
+		mux {
+			groups = "tdm_d10";
+			function = "tdmina_lane2";
+		};
+	};
+
+	tdm_d11_pins: tdm_d11_pin {
+		mux {
+			groups = "tdm_d11";
+			function = "tdmina_lane3";
+		};
+	};
+
+	tdm_d12_pins: tdm_d12_pin {
+		mux {
+			groups = "tdm_d12";
+			function = "tdmoutb_lane6";
+		};
+	};
+
+	tdm_d13_pins: tdm_d13_pin {
+		mux {
+			groups = "tdm_d13";
+			function = "tdmoutb_lane7";
+		};
+	};
+
+	tdma_clk_pins: tdma_clk_pin {
+		mux {
+			groups = "tdm_sclk0", "tdm_lrclk0";
+			function = "tdm_clk_outa";
+		};
+	};
+
+	tdmb_clk_pins: tdmb_clk_pin {
+		mux {
+			groups = "tdm_sclk1", "tdm_lrclk1";
+			function = "tdm_clk_outb";
+		};
+	};
+
+	tdmain_clk_pins: tdmain_clk_pin {
