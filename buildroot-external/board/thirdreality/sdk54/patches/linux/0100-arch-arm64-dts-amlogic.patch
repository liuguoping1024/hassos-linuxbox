+++ b/arch/arm64/boot/dts/amlogic/sc2_s905c2l_ah221.dts	2026-02-09 11:25:54.393399026 +0800
@@ -0,0 +1,1644 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
