diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm64/boot/dts/amlogic/t3_t965d4_ar321-2g_linux.dts b/arch/arm64/boot/dts/amlogic/t3_t965d4_ar321-2g_linux.dts
