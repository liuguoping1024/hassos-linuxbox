+			tpl{
+				offset=<0x0 0x0>;
+				size=<0x0 0x0>;
+			};
+			logo{
+				offset=<0x0 0x0>;
+				size=<0x0 0x200000>;
+			};
+			recovery{
+				offset=<0x0 0x0>;
+				size=<0x0 0x1000000>;
+			};
+			boot{
+				offset=<0x0 0x0>;
+				size=<0x0 0x1000000>;
+			};
+			system{
+				offset=<0x0 0x0>;
+				size=<0x0 0x4000000>;
+			};
