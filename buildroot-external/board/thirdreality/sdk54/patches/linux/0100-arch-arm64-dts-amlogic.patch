+			cpu-supply = <&vddcpu0>;
+			cpu-idle-states = <&CPU_SLEEP_0 &SYSTEM_SLEEP_0>;
+			voltage-tolerance = <0>;
+			clock-latency = <50000>;
+			dynamic-power-coefficient = <80>;
+			#cooling-cells = <2>;
+		};
+
+		CPU3:cpu@3 {
