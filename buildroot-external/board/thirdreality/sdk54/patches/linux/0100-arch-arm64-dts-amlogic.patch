+		status = "okay";
+	};
+};
+
+&aml_bt {
+	status = "okay";
+	power_down_disable = <1>;
+	reset-gpios = <&gpio_ao       GPIOD_3       GPIO_ACTIVE_HIGH>;
+};
+
+&aml_wifi{
+	status = "okay";
+	power_on-gpios  = <&gpio_ao       GPIOD_2       GPIO_ACTIVE_HIGH>;
+};
diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm64/boot/dts/amlogic/t5d_reva_t950d4_am301_linux_1g.dts b/arch/arm64/boot/dts/amlogic/t5d_reva_t950d4_am301_linux_1g.dts
