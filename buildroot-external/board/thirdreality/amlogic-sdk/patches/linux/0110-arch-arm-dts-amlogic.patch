+			output-low;
+		};
+	};
+
+	pdmin: pdmin {
+		mux { /* GPIOH_19, GPIOH_18, GPIOH_14, GPIOH_22 */
+			groups = "pdm_dclk_h19",
+				"pdm_din0_h18",
+				"pdm_din1_h14",
+				"pdm_din2_h22";
+				function = "pdm";
+		};
+	};
+};
