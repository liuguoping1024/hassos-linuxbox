+		start_clk_enable = <1>;
+
+		/*tdm clk tuning enable*/
+		clk_tuning_enable = <1>;
+
+		/* enable control gain */
+		ctrl_gain = <1>;
+
+		/* suspend disable clk */
+		suspend-clk-off = <1>;
+
+		status = "okay";
