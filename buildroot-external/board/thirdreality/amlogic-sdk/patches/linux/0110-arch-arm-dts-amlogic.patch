+		 */
+		vendor_id = <0xffffff>;
+		product_desc = "t5d"; /* Max Chars: 16	  */
+		cec_osd_string = "AML_TV"; /* Max Chars: 14    */
+		port_num = <4>;
+		ee_cec;
+		/*cec_sel = <2>;*/
