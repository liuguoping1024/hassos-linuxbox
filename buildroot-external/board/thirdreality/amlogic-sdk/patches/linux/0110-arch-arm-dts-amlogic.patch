+	pdmin: pdmin {
+		mux { /* GPIOD_8, GPIOD_9 */
+			groups = "pdm_din0_d";
+			function = "pdm";
+		};
+		mux1 {
+			groups = "pdm_dclk_d";
+			function = "pdm";
+			drive-strength-microamp = <500>;
+		};
+	};
+
+	spdifout: spdifout {
+		mux { /* GPIOH_4 */
+			groups = "spdif_out_h";
+			function = "spdif_out";
+		};
+	};
+
+	spdifout_a_mute: spdifout_a_mute {
+		mux { /* GPIOH_4 */
+			groups = "GPIOH_4";
+			function = "gpio_periphs";
+			output-low;
+		};
+	};
