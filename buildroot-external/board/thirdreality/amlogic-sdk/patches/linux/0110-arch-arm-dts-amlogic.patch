diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm/boot/dts/amlogic/s4d_s805c3_aq2432_linux_512m.dts b/arch/arm/boot/dts/amlogic/s4d_s805c3_aq2432_linux_512m.dts
