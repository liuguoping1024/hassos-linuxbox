+
+		partition@0 {
+			label = "bl2e";
+			reg = <0x0 0x00000000>;
+		};
+		partition@1 {
+			label = "bl2x";
+			reg = <0x0 0x00000000>;
+		};
+		partition@2 {
+			label = "ddrfip";
+			reg = <0x0 0x00000000>;
+		};
+		partition@3 {
+			label = "tpl";
+			reg = <0x0 0x00000000>;
+		};
+		partition@4 {
+			label = "logo";
+			reg = <0x0 0x00200000>;
