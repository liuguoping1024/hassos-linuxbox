+			r_io_number = <2>;
+			g_io_number = <12>;
+			b_io_number = <7>;
+		};
+
+		led4 {
+			default_colors = <0 0 0>;
+			r_io_number = <3>;
+			g_io_number = <13>;
+			b_io_number = <8>;
+		};
+		led9 {
+			default_colors = <0 0 0>;
+			r_io_number = <4>;
+			g_io_number = <14>;
+			b_io_number = <9>;
+		};
+	};
