+				0 187 1>;
+		interrupt-names = "irq_cmp",
+					"irq_timeout";
+		dvbci_io {
+			/*gpio define  GPIOM_27 GPIOM_28 GPIOM_29*/
+			cd_pin1 = <&gpio       GPIOM_27       GPIO_ACTIVE_HIGH>;
+			pwr_pin = <&gpio       GPIOM_28       GPIO_ACTIVE_HIGH>;
+			le_pin  = <&gpio       GPIOM_29       GPIO_ACTIVE_HIGH>;
