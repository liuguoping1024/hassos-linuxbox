+
+/ {
+	model = "Amlogic T5D T950X4 AM311 1.5G";
+	amlogic-dt-id = "t5d_t950x4_am311-1.5g";
+
+	aliases {
+		serial0 = &uart_B;
+		serial1 = &uart_A;
+		serial2 = &uart_C;
