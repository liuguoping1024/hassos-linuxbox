diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm/boot/dts/amlogic/s4d_s905y4_ap223_linux.dts b/arch/arm/boot/dts/amlogic/s4d_s905y4_ap223_linux.dts
