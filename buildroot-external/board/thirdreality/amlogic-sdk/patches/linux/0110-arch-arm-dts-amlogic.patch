+/dts-v1/;
+
+#include "meson-sm1.dtsi"
+#include "partition_mbox_ab.dtsi"
+#include "mesonsm1_skt-panel.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
