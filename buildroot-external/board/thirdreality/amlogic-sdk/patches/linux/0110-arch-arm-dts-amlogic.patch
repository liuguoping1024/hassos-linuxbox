+		dai-tdm-clk-sel = <0>;
+		clocks = <&clkaudio CLKID_AUDIO_MCLK_A
+				&clkc CLKID_MPLL0>;
+		clock-names = "mclk", "clk_srcpll";
+		pinctrl-names = "tdm_pins";
+		pinctrl-0 = <&tdm_a
+			&tdm_d3_pins
+			&tdm_d4_pins
+			&tdm_clk_pins>;
+
+		status = "okay";
+	};
