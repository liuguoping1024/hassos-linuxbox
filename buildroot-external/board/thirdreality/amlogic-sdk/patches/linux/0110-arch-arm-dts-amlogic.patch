diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm/boot/dts/amlogic/t5d_t950x4_am311_linux_1g.dts b/arch/arm/boot/dts/amlogic/t5d_t950x4_am311_linux_1g.dts
