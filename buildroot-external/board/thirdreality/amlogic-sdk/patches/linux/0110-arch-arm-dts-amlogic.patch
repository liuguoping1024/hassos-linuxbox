+			size = <0x1BC00000>;
+			alignment = <0x400000>;
+			linux,contiguous-region;
+			alloc-ranges = <0x0 0xe0000000>;
+		};
+
+		/*di CMA pool */
+		di_cma_reserved:linux,di_cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			/* buffer_size = 3621952(yuv422 8bit)
+			 *  | 4736064(yuv422 10bit)
+			 *  | 4074560(yuv422 10bit full pack mode)
+			 * 10x3621952=34.6M(0x23) support 8bit
+			 * 10x4736064=45.2M(0x2e) support 12bit
+			 * 10x4074560=40M(0x28) support 10bit
+			 */
+			//size = <0x0 0x0B000000>;
+			//size = <0x0>;
+			size = <0x400000>;
+			alignment = <0x400000>;
+		};
+		/* codec shared reserved */
+		codec_mm_reserved:linux,codec_mm_reserved {
+			compatible = "amlogic, codec-mm-reserved";
+			size = <0x0>;
+			alignment = <0x100000>;
+			//no-map;
+		};
+
+		/* POST PROCESS MANAGER */
+		ppmgr_reserved:linux,ppmgr {
+			compatible = "amlogic, ppmgr_memory";
+			size = <0x0>;
+		};
+
+		picdec_cma_reserved:linux,picdec {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x0>;
+			alignment = <0x0>;
+			linux,contiguous-region;
+		};
+
+		frc_cma_reserved:linux,frc_cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			/* frc:size need 4M alignment
+			 * 1080P 16 buffer:88Mhz (0x5800000)
+			 * 4k 16 buffer:348Mhz (0x15c00000)
+			 * 400Mhz (0x19000000)
+			 * 384Mhz (0x18000000)
+			 * 368Mhz (0x17000000)
+			 */
+			size = <0x0a000000>;
+			alignment = <0x400000>;
+			linux,contiguous-region;
+			alloc-ranges = <0x0 0xe0000000>;
+			/*alloc-ranges = <0x0 0x3f800000>;*/
+		};
+
+		ldc_mem_reserved:linux,ldc_mem {
+			compatible = "shared-dma-pool";
