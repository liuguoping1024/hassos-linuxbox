+		pps-enable = <1>;
+	};
+
+	aml_dtv_demod {
+		compatible = "amlogic, ddemod-s4d";
+		dev_name = "aml_dtv_demod";
+		status = "okay";
+		diseqc_name = "sgm_41286";
+		pinctrl-names="if_agc_pins", "if_agc2_pins", "rf_agc_pins", "diseqc_out";
+		pinctrl-0=<&dtvdemod_if_agc_pins>;
+		pinctrl-1=<&dtvdemod_if_agc2_pins>;
+		pinctrl-2=<&dtvdemod_rf_agc_pins>;
+		pinctrl-3=<&diseqc_out>;
+		//pinctrl-4=<&diseqc_in>;
+		lnb_en-gpios = <&gpio GPIOZ_6 GPIO_ACTIVE_HIGH>;
+		lnb_sel-gpios = <&gpio GPIOH_6 GPIO_ACTIVE_HIGH>;
+		interrupts = <GIC_SPI 221 IRQ_TYPE_EDGE_RISING>;
+		interrupt-names = "demod_isr";
+
+		power-domains = <&pwrdm PDID_S4_DEMOD>;
+		/* clocks = <&clkc CLKID_DAC_CLK>; */
+		/* clock-names = "vdac_clk_gate"; */
+
+		reg = <0xfe350000 0x10000	/* dtv demod base */
+			   0xfe000000 0x2000	/* div base */
+			   0xff800000 0x1000	/* io_aobus_base */
