+		clocks = <&peripheral_clkc CLKID_HDMIRX_MODET_GATE>,
+				<&peripheral_clkc CLKID_HDMIRX_CFG_GATE>,
+				<&peripheral_clkc CLKID_HDMIRX_ACR_GATE>,
