diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm/boot/dts/amlogic/s4_s805x2_aq222_drm_1.5g.dts b/arch/arm/boot/dts/amlogic/s4_s805x2_aq222_drm_1.5g.dts
