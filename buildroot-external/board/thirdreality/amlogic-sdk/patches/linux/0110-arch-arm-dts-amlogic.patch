+		pinctrl-1 = <&spdifout_a_mute>;
+
+		samesource_sel = <4>;
+
+		/* suspend disable clk */
+		suspend-clk-off = <1>;
+
+		/*spdif clk tuning enable*/
+		clk_tuning_enable = <1>;
+		status = "okay";
+	};
