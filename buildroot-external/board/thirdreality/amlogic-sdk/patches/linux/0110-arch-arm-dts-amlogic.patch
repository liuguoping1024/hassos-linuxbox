+&cma_shrinker {
+	free = <7680 24288 28528 32600 32768 36624>;
+};
diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm/boot/dts/amlogic/t5d_t950d4_am301_linux_1.5g.dts b/arch/arm/boot/dts/amlogic/t5d_t950d4_am301_linux_1.5g.dts
