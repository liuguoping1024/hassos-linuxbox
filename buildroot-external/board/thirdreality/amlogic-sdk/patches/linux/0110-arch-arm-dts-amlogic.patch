+		ts0_control = <0x0>;
+		ts0_invert = <0>;
+
+		ts1_sid = <0x21>;
+		ts1 = "parallel";
+		ts1_control = <0x0>;
+		ts1_invert = <0>;
+
+		ts2_sid = <0x22>;
+		ts2 = "parallel";
+		ts2_control = <0x0>;
+		ts2_invert = <0>;
+
+		pinctrl-names = "s_ts0";
