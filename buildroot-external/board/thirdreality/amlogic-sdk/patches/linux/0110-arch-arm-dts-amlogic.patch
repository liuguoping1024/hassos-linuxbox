+		partition@8 {
+			label = "recovery";
+			reg = <0x0 0x2000000>;
+		};
+		partition@9 {
+			label = "boot";
+			reg = <0x0 0x2200000>;
+		};
+		partition@10 {
+			label = "system";
+			reg = <0x0 0x12000000>;
+		};
+		partition@11 {
+			label = "vendor";
+			reg = <0x0 0x1000000>;
+		};
+		partition@12 {
+			label = "vbmeta";
+			reg = <0x0 0x0100000>;
+		};
+		partition@13 {
+			label = "data";
+			reg = <0x0 0xffffffff>;
+		};
+	};
+};
