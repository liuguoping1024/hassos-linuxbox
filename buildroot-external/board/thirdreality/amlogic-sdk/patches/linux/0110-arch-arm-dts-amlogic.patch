+/dts-v1/;
+
+#include "mesont5d_reva.dtsi"
+#include "partition_normal_linux.dtsi"
+#include "mesont5d_reva_am301_linux-panel.dtsi"
+#include "mesont5_drm.dtsi"
+
+/ {
+	model = "Amlogic T5D T950D4 AM301 1.5G";
+	amlogic-dt-id = "t5d-reva_t950d4_am301-1.5g";
+
+	aliases {
+		serial0 = &uart_B;
+		serial1 = &uart_A;
+		serial2 = &uart_C;
+		//serial3 = &uart_C;
+		//serial4 = &uart_AO_B;
+		tsensor0 = &p_tsensor;
+		i2c0 = &i2c0;
+		i2c1 = &i2c1;
+		i2c2 = &i2c2;
+		spi0 = &spifc;
+		spi1 = &spicc0;
+	};
+
+	memory@00000000 {
+		device_type = "memory";
+		linux,usable-memory = <0x0 0x60000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+		/* global autoconfigured region for contiguous allocations */
+		ramoops@0x07400000 {
+			compatible = "ramoops";
+			reg = <0x07400000 0x00100000>;
+			record-size = <0x20000>;
+			console-size = <0x40000>;
+			ftrace-size = <0x80000>;
+			pmsg-size = <0x20000>;
+		};
+
+		secmon_reserved: linux,secmon {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x400000>;
+			alignment = <0x400000>;
+			alloc-ranges = <0x05000000 0x400000>;
+		};
+
+		logo_reserved:linux,meson-fb {
+			compatible = "shared-dma-pool";
+			reusable;
+			alignment = <0x400000>;
+			reg = <0x5f800000 0x800000>;
+		};
+
+		lcd_tcon_reserved:linux,lcd_tcon {
+			compatible = "amlogic, lcd_tcon";
+			reg = <0x5f000000 0x0>;
+			no-map;
+		};
+
+		codec_mm_cma:linux,codec_mm_cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			/* yuv420(32x3)96M + di(7x4,11x5)84M + workbuf(12M)
+			 * the sum with align 4M then is equal to 192M
+			 */
+			size = <0x9000000>;
+			alignment = <0x400000>;
+			linux,contiguous-region;
