diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm/boot/dts/amlogic/t3_t982_ar311-1g.dts b/arch/arm/boot/dts/amlogic/t3_t982_ar311-1g.dts
