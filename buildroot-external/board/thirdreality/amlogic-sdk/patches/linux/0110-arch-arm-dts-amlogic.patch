+				type = "passive";
+			};
+			vpucontrol: trip-point@1 {
+				temperature = <95000>;
+				hysteresis = <5000>;
+				type = "passive";
+			};
+			ddrhot: trip-point@2 {
+				temperature = <90000>;
+				hysteresis = <10000>;
+				type = "hot";
+			};
+			vpucritical {
+				temperature = <110000>;
+				hysteresis = <1000>;
+				type = "critical";
+			};
+		};
+		cooling-maps {
+			ddr0_cooling_map {
+				trip = <&ddrhot>;
+				cooling-device = <&ddr_cool0 0 2>;
+				contribution = <1024>;
+			};
+			ddr1_cooling_map {
+				trip = <&ddrhot>;
+				cooling-device = <&ddr_cool1 0 2>;
+				contribution = <1024>;
+			};
+		};
+	};
+};
