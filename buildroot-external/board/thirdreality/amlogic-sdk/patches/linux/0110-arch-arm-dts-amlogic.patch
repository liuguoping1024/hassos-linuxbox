+/dts-v1/;
+
+#include "mesont5d_reva.dtsi"
+#include "partition_normal_linux.dtsi"
+#include "mesont5d_reva_am301_linux-panel.dtsi"
+#include "mesont5_drm.dtsi"
+
+/ {
+	model = "Amlogic T5D T950X4 AM311 512M";
+	amlogic-dt-id = "t5d-reva_t950x4_am311-512m";
+
+	aliases {
+		serial0 = &uart_B;
+		serial1 = &uart_A;
+		serial2 = &uart_C;
+		//serial3 = &uart_C;
+		//serial4 = &uart_AO_B;
+		tsensor0 = &p_tsensor;
+		i2c0 = &i2c0;
+		i2c1 = &i2c1;
+		i2c2 = &i2c2;
+		spi0 = &spifc;
+		spi1 = &spicc0;
+	};
+
+	memory@00000000 {
+		device_type = "memory";
+		linux,usable-memory = <0x0 0x20000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <1>;
+		#size-cells = <1>;
+		ranges;
+		/* global autoconfigured region for contiguous allocations */
+		ramoops@0x07400000 {
+			compatible = "ramoops";
+			reg = <0x07400000 0x00100000>;
+			record-size = <0x20000>;
+			console-size = <0x40000>;
+			ftrace-size = <0x80000>;
+			pmsg-size = <0x20000>;
+		};
+
+		secmon_reserved: linux,secmon {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x400000>;
+			alignment = <0x400000>;
+			alloc-ranges = <0x05000000 0x400000>;
+		};
+
+		logo_reserved:linux,meson-fb {
+			compatible = "shared-dma-pool";
+			reusable;
+			alignment = <0x400000>;
+			reg = <0x1f800000 0x800000>;
+		};
+
+		lcd_tcon_reserved:linux,lcd_tcon {
+			compatible = "amlogic, lcd_tcon";
+			reg = <0x1f000000 0x800000>;
+			no-map;
+		};
+
+		codec_mm_cma:linux,codec_mm_cma {
+			compatible = "shared-dma-pool";
+			reusable;
+			/* yuv420(32x3)96M + di(7x4,11x5)84M + workbuf(12M)
+			 * the sum with align 4M then is equal to 192M
+			 */
+			size = <0x7400000>;
+			alignment = <0x400000>;
+			linux,contiguous-region;
+			//alloc-ranges = <0x0 0x1f800000>;
+		};
+
+		/* codec shared reserved */
+		/* codec_mm_reserved:linux,codec_mm_reserved {
+		 *	compatible = "amlogic, codec-mm-reserved";
+		 *	size = <0x0>;
+		 *	alignment = <0x100000>;
+		 *	//no-map;
+		 *	alloc-ranges = <0x0 0x1f000000>;
+		 * };
+		 */
+
+		ion_cma_reserved:linux,ion-dev {
+			compatible = "shared-dma-pool";
+			reusable;
+			/* device/amlogic/xxx/BoardConfig.mk
+			 *        |HWC_PRIMARY_FRAMEBUFFER_WIDTH := 1920
+			 *        |      |HWC_PRIMARY_FRAMEBUFFER_HEIGHT := 1080
+			 *        |      |      |NUM_FRAMEBUFFER_SURFACE_BUFFERS := 3
+			 * size = 1920 * 1080 * 3 * 4(RGBA: bytes/pixel) + 4M(10% * afbc)
+			 */
+			size = <0x2000000>;
+			alignment = <0x400000>;
+			//alloc-ranges = <0x0 0x1f000000>;
+		};
+		ion_fb_reserved:linux,ion-fb {
+			compatible = "shared-dma-pool";
+			reusable;
+			size = <0x0000000>;
+			alignment = <0x400000>;
+		};
+
+		/*  vdin0 CMA pool */
+		//vdin0_cma_reserved:linux,vdin0_cma {
+		//	compatible = "shared-dma-pool";
+		//	reusable;
+			/* 3840x2160x4x4 ~=128 M */
+		//	size = <0xc400000>;
+		//	alignment = <0x400000>;
+		//};
+
+		/*  vdin1 CMA pool */
+		//vdin1_cma_reserved:linux,vdin1_cma {
+		//	compatible = "shared-dma-pool";
+		//	reusable;
+			/* 420 mode:1280x720x2x4=8MB */
+			/* 444 mode:1280x720x3x4=12MB */
+		//	size = <0x800000>;
+		//	alignment = <0x400000>;
+		//	alloc-ranges = <0x0 0x1f000000>;
+		//};
+
+		/* demod_reserved:linux,demod {
+		 *	compatible = "amlogic, demod-mem";
+		 *	size = <0x6400000>; //8M //100m 0x6400000
+		 *	alloc-ranges = <0x0 0x30000000>;
+		 *	//multi-use;
+		 *	//no-map;
+		 * };
+		 */
+
