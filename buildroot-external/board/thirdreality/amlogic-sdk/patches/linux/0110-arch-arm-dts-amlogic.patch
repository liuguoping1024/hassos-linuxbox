+				"cts_hdmirx_meter_clk",
+				"cts_hdmi_axi_clk",
+				"xtal",
+				"fclk_div3",
+				"fclk_div5",
+				"fclk_div7",
+				"hdcp_rx22_skp",
+				"hdcp_rx22_esm";
+				//"hdmirx_aud_pll2fs",
+				//"hdmirx_aud_pll4f",
+				//"clk_aud_out";
+		hdmirx_id = <0>;
+		en_4k_2_2k = <0>;
+		en_4k_timing = <0>;
+		hpd_low_cec_off = <1>;
+		arc_port = <1>;
+		/* bit4: enable feature, bit3~0: port number */
+		disable_port = <0x0>;
+		hdcp_tee_path = <1>;
+		/* MAP_ADDR_MODULE_CBUS */
+		/* MAP_ADDR_MODULE_HIU */
+		/* MAP_ADDR_MODULE_HDMIRX_CAPB3 */
+		/* MAP_ADDR_MODULE_SEC_AHB */
+		/* MAP_ADDR_MODULE_SEC_AHB2 */
+		/* MAP_ADDR_MODULE_APB4 */
+		/* MAP_ADDR_MODULE_TOP */
