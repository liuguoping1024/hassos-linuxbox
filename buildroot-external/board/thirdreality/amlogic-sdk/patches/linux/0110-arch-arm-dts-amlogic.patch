diff -ruN '--exclude=.git' '--exclude=build' '--exclude=.gitignore' '--exclude=*.o' '--exclude=*.a' '--exclude=*.ko' '--exclude=*.pyc' '--exclude=include-prefixes' a/arch/arm/boot/dts/amlogic/s4_s905w2_ap201_1g.dts b/arch/arm/boot/dts/amlogic/s4_s905w2_ap201_1g.dts
