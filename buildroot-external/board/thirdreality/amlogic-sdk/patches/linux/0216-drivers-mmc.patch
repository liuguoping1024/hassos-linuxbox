+
+	cmd.opcode = opcode;
+	cmd.arg = arg;
+	cmd.flags = flags;
+	err = mmc_wait_for_cmd(mmc, &cmd, 0);
+	if (err) {
+		pr_debug("[%s][%d] cmd:0x%x send error\n",
+			 __func__, __LINE__, cmd.opcode);
+		return err;
+	}
+	return err;
+}
