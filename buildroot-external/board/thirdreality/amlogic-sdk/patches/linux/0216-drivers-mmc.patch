+static int aml_uart_switch(struct meson_host *host, bool on)
+{
+	struct pinctrl *pc;
+	char *name[2] = {
+		"sd_to_ao_uart_pins",
+		"ao_to_sd_uart_pins",
+	};
+
+	pc = aml_pinctrl_select(host, name[on]);
+	return on;
+}
