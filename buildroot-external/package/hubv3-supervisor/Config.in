config BR2_PACKAGE_HUBV3_SUPERVISOR
	bool "hubv3-supervisor"
	depends on BR2_PACKAGE_BLUEZ5_UTILS
	depends on BR2_PACKAGE_HAS_UDEV # pkg_check_modules(LIBUDEV REQUIRED libudev)
	select BR2_PACKAGE_LIBGLIB2
	select BR2_PACKAGE_JSON_C
	select BR2_PACKAGE_AVAHI
	select BR2_PACKAGE_AVAHI_DAEMON
	select BR2_PACKAGE_LIBGPIOD
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_LIBMICROHTTPD
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_LIBYAML
	select BR2_PACKAGE_SQLITE
	select BR2_PACKAGE_CJSON
	# libmosquitto: hard requirement since supervisor 82834e07
	# (CMakeLists.txt aborts with FATAL_ERROR when mosquitto.h is absent).
	# Selected here rather than set per-board so a new board defconfig
	# cannot miss it.
	select BR2_PACKAGE_MOSQUITTO
	# libuuid, via pkg_check_modules(LIBUUID REQUIRED uuid)
	select BR2_PACKAGE_UTIL_LINUX
	select BR2_PACKAGE_UTIL_LINUX_LIBUUID
	help
	  LinuxBox Supervisor for ThirdReality Hub V3.
	  A C-based device management daemon providing hardware control
	  (LED, button, GPIO), network management, HTTP API, D-Bus service,
	  Zigbee/Thread device management, BLE provisioning, OTA upgrade,
	  mDNS broadcast, and Home Assistant integration.

	  https://github.com/liuguoping1024/LinuxBox_Supervisor

comment "hubv3-supervisor needs bluez5_utils"
	depends on !BR2_PACKAGE_BLUEZ5_UTILS

comment "hubv3-supervisor needs udev (systemd or eudev)"
	depends on !BR2_PACKAGE_HAS_UDEV
